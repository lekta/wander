<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Wander.Site</RootNamespace>
  </PropertyGroup>

  <!--
    The site generator: docs/GUIDE.md and docs/site/index.html in, static
    pages out. No reference to App or Core, and a plain net10.0 target,
    because the same command runs on the Linux runner that deploys to
    GitHub Pages. Markdig is the version the app already uses. See
    docs/ARCHITECTURE.md, the site section.
  -->
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.2.0" />
  </ItemGroup>

</Project>
