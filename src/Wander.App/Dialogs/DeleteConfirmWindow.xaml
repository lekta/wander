<Window x:Class="Wander.App.Dialogs.DeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Wander.App.Controls"
        xmlns:res="clr-namespace:Wander.App.Resources"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight"
        MinWidth="440" MaxWidth="720"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource ChromeBackground}">

    <!--
        The question before a delete (PLAN 0.6.1, mock-up accepted on
        2026-11-05): the mark, the question, what goes - every item on a row
        of its own, a folder's insides counted while the window is up - and
        two buttons that say what they do. One item is described in words
        with its picture beside it; a row of the table shows its picture in
        a card off the window's edge, where it covers nothing the question
        needs. Cancel is the default and the answer to Esc and Enter; past
        the bin the delete button is not reachable by Tab at all - a click,
        or nothing.

        Everything the window says comes from DeleteConfirmation (Core,
        tested); this file only lays it out.
    -->
    <Window.Resources>
        <Style x:Key="Plaque" TargetType="Border">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PlaqueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="PlaqueMark" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,2,8,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Quiet" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="Counting" TargetType="controls:Spinner">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Stroke" Value="{DynamicResource SpinnerQuiet}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Padding="16,12,16,16">
        <Grid>
            <StackPanel>
                <!-- The mark and the question. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="32" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE7BA;"/>
                                <Setter Property="Foreground" Value="{DynamicResource StatusWarningGlyph}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Text" Value="&#xEA39;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource StatusErrorGlyph}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Column="1" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Headline}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <!-- Why the bin refused: the reason the window came up at all. -->
                        <Border Style="{StaticResource Plaque}"
                                Background="{DynamicResource PlaqueErrorBackground}"
                                BorderBrush="{DynamicResource PlaqueErrorBorder}"
                                Visibility="{Binding HasReasons, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xEA39;" Style="{StaticResource PlaqueMark}"
                                           Foreground="{DynamicResource StatusErrorGlyph}"/>
                                <ItemsControl ItemsSource="{Binding Reasons}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource PlaqueText}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding IsList, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Quiet}"/>
                            <controls:Spinner Style="{StaticResource Counting}" Margin="6,0,0,0"
                                              Visibility="{Binding IsCounting, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <!-- The read-only items, asked about here and not in a second question. -->
                        <Border Style="{StaticResource Plaque}"
                                Background="{DynamicResource PlaqueWarningBackground}"
                                BorderBrush="{DynamicResource PlaqueWarningBorder}"
                                Visibility="{Binding HasReadOnly, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource PlaqueMark}"
                                           Foreground="{DynamicResource StatusWarningGlyph}"/>
                                <TextBlock Text="{Binding ReadOnlyLine}" Style="{StaticResource PlaqueText}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- One item: its picture, where it is and what it holds. -->
                <Grid Margin="44,10,0,0" Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="112" Height="84" VerticalAlignment="Top"
                            Background="{DynamicResource ContentBackground}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4">
                        <controls:AsyncIcon IconPath="{Binding Path}" IconSize="Large" Stretch="Uniform" Margin="2"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,2,0,0">
                        <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Style="{StaticResource Quiet}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Quiet}"/>
                            <controls:Spinner Style="{StaticResource Counting}" Margin="6,0,0,0"
                                              Visibility="{Binding IsCounting, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- What goes, a row an item; the companions under their file. -->
                <Border Margin="0,12,0,0"
                        Background="{DynamicResource ContentBackground}"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4"
                        Visibility="{Binding HasTable, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Background="{DynamicResource HeaderBackground}"
                                BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,1"
                                Visibility="{Binding ShowsHeader, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="{Binding NameWidth}"/>
                                    <ColumnDefinition Width="{Binding InsideWidth}"/>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="{Binding ScrollGutter}"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static res:Strings.ColumnName}" Margin="8,4" Style="{StaticResource Quiet}"/>
                                <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ColumnInside}" Margin="8,4" Style="{StaticResource Quiet}"
                                           Visibility="{Binding ShowsInside, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Grid.Column="2" Text="{x:Static res:Strings.ColumnSize}" Margin="8,4" HorizontalAlignment="Right"
                                           Style="{StaticResource Quiet}"/>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="Table" ItemsSource="{Binding Rows}" AlternationCount="2" Focusable="False"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                      ScrollViewer.CanContentScroll="True"
                                      MouseLeave="OnTableLeave">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer MaxHeight="{Binding TableMaxHeight}" Focusable="False" CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Height="24" Background="Transparent"
                                            MouseEnter="OnRowEnter" MouseLeave="OnRowLeave">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"
                                                                  MinWidth="{Binding DataContext.NameWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                <ColumnDefinition Width="{Binding DataContext.InsideWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                <ColumnDefinition Width="84"/>
                                            </Grid.ColumnDefinitions>

                                            <DockPanel Margin="{Binding Indent}" VerticalAlignment="Center">
                                                <controls:AsyncIcon DockPanel.Dock="Left" IconPath="{Binding FullPath}" IconSize="Small"
                                                                    Width="16" Height="16"/>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Tag}"
                                                        BorderBrush="{DynamicResource PlaqueWarningBorder}"
                                                        Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{x:Static res:Strings.DeleteTagReadOnly}" FontSize="11"
                                                               Foreground="{DynamicResource TextWarning}"/>
                                                </Border>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Tag}"
                                                        BorderBrush="{DynamicResource CardBorder}"
                                                        Visibility="{Binding IsCompanion, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{x:Static res:Strings.DeleteTagCompanion}" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                </Border>
                                                <TextBlock x:Name="NameText" Text="{Binding Name}" Margin="6,0,0,0"
                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                            </DockPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding InsideText}" Margin="8,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Style="{StaticResource Quiet}"/>

                                            <Grid Grid.Column="2" Margin="8,0">
                                                <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <controls:Spinner Style="{StaticResource Counting}" HorizontalAlignment="Right"
                                                                  Visibility="{Binding IsCounting, Converter={StaticResource BoolToVisibility}}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                                     Value="1">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource TableRowAlternate}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCompanion}" Value="True">
                                            <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextSubtle}"/>
                                        </DataTrigger>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHover}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding RestLine}" Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource Quiet}"
                           Visibility="{Binding HasRest, Converter={StaticResource BoolToVisibility}}"/>

                <TextBlock Text="{Binding Warning}" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextError}"
                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="ActionButton" Content="{Binding ActionLabel}" Style="{StaticResource DialogButton}"
                            Margin="0,0,8,0" IsTabStop="{Binding ActionIsTabStop}" Focusable="{Binding ActionIsTabStop}"
                            Click="OnAction"/>
                    <Button x:Name="CancelButton" Content="{Binding CancelLabel}" Style="{StaticResource DialogButton}"
                            IsCancel="True" IsDefault="True"/>
                </StackPanel>
            </StackPanel>

            <!--
                The picture of the row under the mouse, off the window's right
                edge at the row's height: on the window it would cover the
                rows next to it (decision of 2026-11-05). No room on the
                right of the screen - the popup goes left by itself.
            -->
            <Popup x:Name="Preview" Placement="Right" PlacementTarget="{Binding ElementName=Root}"
                   HorizontalOffset="12" AllowsTransparency="True" StaysOpen="True"
                   IsHitTestVisible="False" Focusable="False">
                <Border Width="152" Margin="0,0,10,10" Padding="8"
                        Background="{DynamicResource ContentBackground}"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <controls:AsyncIcon x:Name="PreviewIcon" IconSize="Large" Width="136" Height="102" Stretch="Uniform"/>
                        <TextBlock x:Name="PreviewName" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="PreviewFolder" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="48" Style="{StaticResource Quiet}"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
