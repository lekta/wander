<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The light theme: the window's chrome. The same keys as
        Palette.Dark.xaml, in the same order - the header of Palette.xaml
        says how the two are used. The light values are the ones Wander has
        always had; under "Stock controls" they are Aero2's own, so WPF's
        controls redrawn in StockControls.xaml look as they did.

        Windows' system colours are not overridden here: in the light theme
        what Aero2 draws from them (the default window, a table's cells,
        the disabled grey) stays Windows' own.
    -->

    <!-- ===== Surfaces ================================================== -->

    <!-- The strip above and below the content - toolbar, preview footer - and every dialog's own surface. -->
    <SolidColorBrush x:Key="ChromeBackground" Color="#F3F3F3"/>

    <!-- The folder panels down the left. -->
    <SolidColorBrush x:Key="PaneBackground" Color="#F8F8F8"/>

    <!-- The preview pane's own surface, a shade lighter than the chrome. -->
    <SolidColorBrush x:Key="PreviewBackground" Color="#FAFAFA"/>

    <!-- A list that is a field rather than the content area (settings). -->
    <SolidColorBrush x:Key="ListBackground" Color="#FAFAFA"/>

    <!-- Text boxes, the address bar, popup cards: where typing happens. -->
    <SolidColorBrush x:Key="InputBackground" Color="White"/>

    <!-- What a listing or a table is drawn on. -->
    <SolidColorBrush x:Key="ContentBackground" Color="White"/>

    <!-- A field that shows a value the user cannot edit. -->
    <SolidColorBrush x:Key="ReadOnlyFieldBackground" Color="#F7F7F7"/>

    <!-- A toolstrip inside the content area - the gallery / rating filter bar. -->
    <SolidColorBrush x:Key="StripBackground" Color="#F7F7F7"/>

    <!-- A clickable section header - the bookmarks panel's title row. -->
    <SolidColorBrush x:Key="HeaderBackground" Color="#EEE"/>

    <!-- Every other row of the details table. -->
    <SolidColorBrush x:Key="DetailsRowAlternate" Color="#F7F7F7"/>

    <!-- ...and of the settings tables, which sit on a lighter surface. -->
    <SolidColorBrush x:Key="TableRowAlternate" Color="#FAFAFA"/>

    <!-- A sample of the thing being configured, shown inside a settings row. -->
    <SolidColorBrush x:Key="SampleRowBackground" Color="#F5F5F5"/>

    <!-- A boxed example inside a settings page. -->
    <SolidColorBrush x:Key="InsetBackground" Color="#F0F0F0"/>

    <!-- "This folder is gone" and the other full-pane messages. -->
    <SolidColorBrush x:Key="EmptyStateBackground" Color="#FDFDFD"/>

    <!-- Laid over the content while a folder is being read; translucent so it dims rather than hides. -->
    <SolidColorBrush x:Key="LoadingVeil" Color="#80FAFAFA"/>

    <!-- The status bar along the bottom of the main window: Aero2's own. -->
    <SolidColorBrush x:Key="StatusBarBackground" Color="#F1EDED"/>


    <!-- ===== Lines ===================================================== -->

    <!-- Splitters, pane edges, the rule under a header: the app's default line. -->
    <SolidColorBrush x:Key="Separator" Color="#DDD"/>

    <!-- The frame around a card - the two file panes of the conflict dialog. -->
    <SolidColorBrush x:Key="CardBorder" Color="#CCC"/>

    <!-- A text field's frame - Windows' own control border, matched deliberately - under the cursor, and with the keyboard. -->
    <SolidColorBrush x:Key="InputBorder" Color="#ABADB3"/>
    <SolidColorBrush x:Key="InputBorderHover" Color="#7EB4EA"/>
    <SolidColorBrush x:Key="InputBorderFocus" Color="#569DE5"/>

    <!-- The rule between the app's bookmarks and the user's own. -->
    <SolidColorBrush x:Key="SectionRule" Color="#D6D6D6"/>

    <!-- Grid lines inside a settings table - quieter than a separator. -->
    <SolidColorBrush x:Key="GridLine" Color="#EEE"/>

    <!--
        The outline that says where the keyboard is. Muted grey rather than
        the system accent: it is on screen the whole time, and a bright frame
        around whatever you are working in reads as an alarm.
    -->
    <SolidColorBrush x:Key="FocusOutline" Color="#998A8A8A"/>


    <!-- ===== Text ====================================================== -->
    <!--
        Four steps of grey under the text itself, not eight (2026-10-08):
        the keys stay one per role - what is painted - and the roles share
        a step. Strong (headings), secondary (labels, status, captions),
        dim (second lines, hints), faint (placeholders, the disabled).
    -->

    <!-- Text itself: the window's own. -->
    <SolidColorBrush x:Key="TextPrimary" Color="Black"/>

    <!-- A heading inside the content area. -->
    <SolidColorBrush x:Key="TextHeading" Color="#333"/>

    <!-- A label next to a value. -->
    <SolidColorBrush x:Key="TextSecondary" Color="#555"/>

    <!-- Status text and glyph buttons. -->
    <SolidColorBrush x:Key="TextMuted" Color="#555"/>

    <!-- The caption over a group of values. -->
    <SolidColorBrush x:Key="TextCaption" Color="#555"/>

    <!-- The second line under a tile - kind, path. -->
    <SolidColorBrush x:Key="TextSubtle" Color="#777"/>

    <!-- Hints and secondary values: the quietest text still meant to be read. -->
    <SolidColorBrush x:Key="TextDim" Color="#777"/>

    <!-- The prompt inside an empty search box. -->
    <SolidColorBrush x:Key="TextPlaceholder" Color="#999"/>

    <!-- A bookmark whose folder is no longer there. -->
    <SolidColorBrush x:Key="TextDisabled" Color="#999"/>

    <!-- "This folder is on a drive that is nearly full" and its kind. -->
    <SolidColorBrush x:Key="TextWarning" Color="#A05000"/>

    <!-- A rejected name in the rename prompt. -->
    <SolidColorBrush x:Key="TextError" Color="IndianRed"/>

    <!-- ...and the frame round the box it was typed into. -->
    <SolidColorBrush x:Key="InputBorderError" Color="IndianRed"/>

    <!-- Links and the accent said in text. -->
    <SolidColorBrush x:Key="AccentText" Color="#0078D7"/>

    <!-- A line drawn in the accent - a ring, a chevron under the cursor. -->
    <SolidColorBrush x:Key="AccentStroke" Color="#0078D7"/>


    <!-- ===== Rows ====================================================== -->
    <!--
        Explorer's own selection colours, used as-is: the list and the trees
        are the part of Wander that has to feel like the shell. The gallery
        takes these too while its background follows the window
        (GalleryPalette).
    -->

    <SolidColorBrush x:Key="RowHover" Color="#E5F3FB"/>
    <SolidColorBrush x:Key="RowHoverBorder" Color="#D2ECF8"/>

    <SolidColorBrush x:Key="RowSelected" Color="#CCE8FF"/>
    <SolidColorBrush x:Key="RowSelectedBorder" Color="#AFD9F2"/>

    <!-- Selected while the keyboard is in another pane - the answer to "what does Delete mean". -->
    <SolidColorBrush x:Key="RowSelectedInactive" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="RowSelectedInactiveBorder" Color="#DCDCDC"/>

    <SolidColorBrush x:Key="RowSelectedHover" Color="#BFE0FA"/>
    <SolidColorBrush x:Key="RowSelectedHoverBorder" Color="#A5D3EE"/>

    <!--
        The row the keyboard would move from - Explorer's focus rectangle.
        Drawn as a frame and nothing else, so it reads on a selected row and
        on an unselected one alike: a click on empty space clears the
        selection but leaves this, which is the only thing on screen saying
        where the next arrow key starts from.
    -->
    <SolidColorBrush x:Key="RowCaretBorder" Color="#3B3B3B"/>

    <!--
        The mark in front of the status line (StatusSeverity): Windows 11's
        own caution and critical colours. News has no mark at all.
    -->
    <SolidColorBrush x:Key="StatusWarningGlyph" Color="#9D5D00"/>
    <SolidColorBrush x:Key="StatusErrorGlyph" Color="#C42B1C"/>

    <!-- The "..." button that appears on a bookmark row under the cursor. -->
    <SolidColorBrush x:Key="RowActionHover" Color="#C4E0F4"/>


    <!-- ===== Controls ================================================== -->

    <!-- A flat toolbar button under the cursor, and pressed. -->
    <SolidColorBrush x:Key="ControlHover" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#C8C8C8"/>

    <!-- A toggle that is on - the recent-folders chevron. -->
    <SolidColorBrush x:Key="ControlChecked" Color="#D0D0D0"/>

    <!-- The square round each gallery-background option: idle, chosen, under the cursor. -->
    <SolidColorBrush x:Key="OptionRing" Color="#BBB"/>
    <SolidColorBrush x:Key="OptionRingChecked" Color="#444"/>
    <SolidColorBrush x:Key="OptionRingHover" Color="#888"/>

    <!-- A trough: the drive's capacity bar, a progress bar. -->
    <SolidColorBrush x:Key="TrackBackground" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="TrackBorder" Color="#CCC"/>

    <!-- A progress bar's frame: Aero2's. -->
    <SolidColorBrush x:Key="ProgressBorder" Color="#BCBCBC"/>

    <!-- The folder tree's chevron: idle, expanded, under the cursor. -->
    <SolidColorBrush x:Key="TreeChevron" Color="#606060"/>
    <SolidColorBrush x:Key="TreeChevronExpanded" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TreeChevronHover" Color="#0078D7"/>

    <!-- The "drop a folder here" strip under the bookmarks: idle, and with a drag over it. -->
    <SolidColorBrush x:Key="DropZoneFill" Color="#ECECEC"/>
    <SolidColorBrush x:Key="DropZoneGlyph" Color="#888888"/>
    <SolidColorBrush x:Key="DropZoneActiveFill" Color="#CCE8FF"/>
    <SolidColorBrush x:Key="DropZoneActiveGlyph" Color="#0055A8"/>

    <!-- The sample file icon drawn in the settings preview. -->
    <SolidColorBrush x:Key="SampleIconFill" Color="#C7D6E8"/>
    <SolidColorBrush x:Key="SampleIconEdge" Color="#8FA8C4"/>

    <!-- A search still running: deliberately not the accent, so it does not
         compete with the results arriving underneath it. -->
    <SolidColorBrush x:Key="SpinnerQuiet" Color="#999"/>


    <!-- ===== Menus ===================================================== -->
    <!-- Windows 11 menu chrome. Used by MenuStyles.xaml, and by the context
         menus ContextMenuFactory builds in code. -->

    <SolidColorBrush x:Key="MenuPopupBackground" Color="#FBFBFB"/>
    <SolidColorBrush x:Key="MenuPopupBorder" Color="#E2E2E2"/>
    <SolidColorBrush x:Key="MenuForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="MenuForegroundDisabled" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="MenuForegroundGesture" Color="#757575"/>
    <SolidColorBrush x:Key="MenuHighlight" Color="#ECECEC"/>
    <SolidColorBrush x:Key="MenuSeparator" Color="#E5E5E5"/>


    <!-- ===== Stock controls ============================================ -->
    <!-- WPF's own controls as StockControls.xaml draws them. The light
         values are Aero2's, one for one. -->

    <!-- A push button and a toggle: idle, under the cursor, pressed, on, disabled; the default one's frame. -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#707070"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#BEE6FD"/>
    <SolidColorBrush x:Key="ButtonHoverBorder" Color="#3C7FB1"/>
    <SolidColorBrush x:Key="ButtonPressed" Color="#C4E5F6"/>
    <SolidColorBrush x:Key="ButtonPressedBorder" Color="#2C628B"/>
    <SolidColorBrush x:Key="ButtonChecked" Color="#BCDDEE"/>
    <SolidColorBrush x:Key="ButtonCheckedBorder" Color="#245A83"/>
    <SolidColorBrush x:Key="ButtonDisabled" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="ButtonDisabledBorder" Color="#ADB2B5"/>
    <SolidColorBrush x:Key="ButtonDisabledText" Color="#838383"/>
    <SolidColorBrush x:Key="ButtonDefaultBorder" Color="#0078D7"/>

    <!-- The box of a check box and the circle of a radio button, and the mark in them. -->
    <SolidColorBrush x:Key="CheckBackground" Color="White"/>
    <SolidColorBrush x:Key="CheckBorder" Color="#707070"/>
    <SolidColorBrush x:Key="CheckGlyph" Color="#212121"/>
    <SolidColorBrush x:Key="CheckHover" Color="#F3F9FF"/>
    <SolidColorBrush x:Key="CheckHoverBorder" Color="#5593FF"/>
    <SolidColorBrush x:Key="CheckPressed" Color="#D9ECFF"/>
    <SolidColorBrush x:Key="CheckPressedBorder" Color="#3C77DD"/>
    <SolidColorBrush x:Key="CheckDisabled" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="CheckDisabledBorder" Color="#BCBCBC"/>
    <SolidColorBrush x:Key="CheckDisabledGlyph" Color="#707070"/>

    <!-- A raised face: a drop-down's button, a tab, a slider's thumb. -->
    <LinearGradientBrush x:Key="RaisedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0F0F0" Offset="0"/>
        <GradientStop Color="#E5E5E5" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RaisedBorder" Color="#ACACAC"/>
    <LinearGradientBrush x:Key="RaisedHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ECF4FC" Offset="0"/>
        <GradientStop Color="#DCECFC" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RaisedHoverBorder" Color="#7EB4EA"/>
    <LinearGradientBrush x:Key="RaisedPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#DAECFC" Offset="0"/>
        <GradientStop Color="#C4E0FC" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RaisedPressedBorder" Color="#569DE5"/>
    <SolidColorBrush x:Key="RaisedDisabled" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="RaisedDisabledBorder" Color="#D9D9D9"/>
    <!-- The selected tab, and the panel under it. -->
    <SolidColorBrush x:Key="RaisedSelected" Color="White"/>
    <!-- The arrow on a drop-down: idle, under the cursor or pressed, disabled. -->
    <SolidColorBrush x:Key="RaisedGlyph" Color="#606060"/>
    <SolidColorBrush x:Key="RaisedGlyphActive" Color="Black"/>
    <SolidColorBrush x:Key="RaisedGlyphDisabled" Color="#BFBFBF"/>

    <!-- The open list of a drop-down. -->
    <SolidColorBrush x:Key="DropDownBackground" Color="White"/>
    <SolidColorBrush x:Key="DropDownBorder" Color="#646464"/>

    <!-- A row of a drop-down or a plain list: under the cursor, selected, selected elsewhere, both. -->
    <SolidColorBrush x:Key="ItemHover" Color="#1F26A0DA"/>
    <SolidColorBrush x:Key="ItemHoverBorder" Color="#A826A0DA"/>
    <SolidColorBrush x:Key="ItemHoverFocused" Color="#5426A0DA"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#3D26A0DA"/>
    <SolidColorBrush x:Key="ItemSelectedBorder" Color="#FF26A0DA"/>
    <SolidColorBrush x:Key="ItemSelectedInactive" Color="#3DDADADA"/>
    <SolidColorBrush x:Key="ItemSelectedInactiveBorder" Color="#FFDADADA"/>
    <SolidColorBrush x:Key="ItemSelectedHover" Color="#2E0080FF"/>
    <SolidColorBrush x:Key="ItemSelectedHoverBorder" Color="#99006CD9"/>

    <!-- A scroll bar: the trough, the thumb (idle, under the cursor, dragged), the arrows and their buttons. -->
    <SolidColorBrush x:Key="ScrollTrack" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#CDCDCD"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="ScrollThumbDragging" Color="#606060"/>
    <SolidColorBrush x:Key="ScrollArrow" Color="#606060"/>
    <SolidColorBrush x:Key="ScrollArrowHover" Color="Black"/>
    <SolidColorBrush x:Key="ScrollArrowPressed" Color="White"/>
    <SolidColorBrush x:Key="ScrollArrowDisabled" Color="#BFBFBF"/>
    <SolidColorBrush x:Key="ScrollButtonHover" Color="#DADADA"/>
    <SolidColorBrush x:Key="ScrollButtonPressed" Color="#606060"/>

    <!-- A tooltip. -->
    <SolidColorBrush x:Key="ToolTipBackground" Color="#F1F2F7"/>
    <SolidColorBrush x:Key="ToolTipBorder" Color="#767676"/>
    <SolidColorBrush x:Key="ToolTipText" Color="#575757"/>

    <!-- A slider: the groove, and the thumb's face idle, under the cursor, dragged. -->
    <SolidColorBrush x:Key="SliderTrack" Color="#E7EAEA"/>
    <SolidColorBrush x:Key="SliderTrackBorder" Color="#D6D6D6"/>
    <SolidColorBrush x:Key="SliderThumb" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="SliderThumbHover" Color="#DCECFC"/>
    <SolidColorBrush x:Key="SliderThumbPressed" Color="#DAECFC"/>

    <!-- A table's column header: the face, under the cursor, pressed; its lines; the sort arrow. -->
    <SolidColorBrush x:Key="HeaderFace" Color="White"/>
    <SolidColorBrush x:Key="HeaderHover" Color="#D9EBF9"/>
    <SolidColorBrush x:Key="HeaderPressed" Color="#BCDCF4"/>
    <SolidColorBrush x:Key="HeaderLine" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="HeaderSortArrow" Color="#ACACAC"/>
</ResourceDictionary>
