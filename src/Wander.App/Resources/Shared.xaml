<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The one list of the application's resource dictionaries. App.xaml
        merges this and nothing else, and so does the harness, which cannot
        run App.xaml's InitializeComponent and used to repeat the list by
        hand - a dictionary added here reaches both.

        The palette first: the colours a theme leaves alone, then the
        theme's own - the light one here, swapped for Palette.Dark.xaml at
        run time by Util/InterfaceTheme, which finds it in this list by its
        name. Then what draws with them. StockControls.xaml (WPF's own
        controls) is merged by Controls.xaml, whose styles are based on it
        and have to find it at parse time.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml"/>
        <ResourceDictionary Source="Palette.Light.xaml"/>
        <ResourceDictionary Source="MenuStyles.xaml"/>
        <ResourceDictionary Source="Converters.xaml"/>
        <ResourceDictionary Source="Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
