<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Wander.App.Converters">
    <!--
        The general converters - about a bool or an enum, nothing of any one
        view - instanced once.

        Every window and view used to declare its own copy of these - eight
        BoolToVisibility, three EnumToVisibility. A converter about a
        view's own matter (TileSecondLine, which carries state; the file
        list's column formatters; the preview's pixel cap and star) stays
        in that view's resources.

        Merged into App.xaml through Shared.xaml; keys are what the views
        already asked for.
    -->

    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
    <conv:EnumEqualsConverter x:Key="EnumEquals"/>
</ResourceDictionary>
