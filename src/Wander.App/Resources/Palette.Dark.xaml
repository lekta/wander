<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The dark theme: the same keys as Palette.Light.xaml, in the same
        order (the header of Palette.xaml says how the two are used). Tuned
        after Windows 11's own dark surfaces: near-black content, the chrome
        a step lighter, lines and fields a step lighter again; a selection
        keeps a blue lean so it still reads as "chosen" and not just
        "lighter".

        Unlike the light theme, this one also overrides a few of Windows'
        system colours at the bottom: whatever WPF still draws from them -
        a window's default face and text, a table's cells, the disabled
        grey, AvalonEdit's paper - would otherwise stay light.
    -->

    <!-- ===== Surfaces ================================================== -->

    <SolidColorBrush x:Key="ChromeBackground" Color="#202020"/>
    <SolidColorBrush x:Key="PaneBackground" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="PreviewBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ListBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="InputBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="ContentBackground" Color="#191919"/>
    <SolidColorBrush x:Key="ReadOnlyFieldBackground" Color="#242424"/>
    <SolidColorBrush x:Key="StripBackground" Color="#242424"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="DetailsRowAlternate" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="TableRowAlternate" Color="#212121"/>
    <SolidColorBrush x:Key="SampleRowBackground" Color="#262626"/>
    <SolidColorBrush x:Key="InsetBackground" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="EmptyStateBackground" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="LoadingVeil" Color="#80191919"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#202020"/>


    <!-- ===== Lines ===================================================== -->

    <SolidColorBrush x:Key="Separator" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="CardBorder" Color="#474747"/>
    <SolidColorBrush x:Key="InputBorder" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="InputBorderHover" Color="#7A9CC0"/>
    <SolidColorBrush x:Key="InputBorderFocus" Color="#4CA0E0"/>
    <SolidColorBrush x:Key="SectionRule" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="GridLine" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="FocusOutline" Color="#99A0A0A0"/>


    <!-- ===== Text ====================================================== -->

    <SolidColorBrush x:Key="TextPrimary" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TextHeading" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="TextMuted" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="TextCaption" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="TextSubtle" Color="#999999"/>
    <SolidColorBrush x:Key="TextDim" Color="#999999"/>
    <SolidColorBrush x:Key="TextPlaceholder" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="TextWarning" Color="#E8A33D"/>
    <SolidColorBrush x:Key="TextError" Color="#F28B82"/>
    <SolidColorBrush x:Key="InputBorderError" Color="#E06666"/>
    <SolidColorBrush x:Key="AccentText" Color="#60B0F0"/>
    <SolidColorBrush x:Key="AccentStroke" Color="#4CA0E0"/>


    <!-- ===== Rows ====================================================== -->

    <SolidColorBrush x:Key="RowHover" Color="#2A2D30"/>
    <SolidColorBrush x:Key="RowHoverBorder" Color="#383C40"/>
    <SolidColorBrush x:Key="RowSelected" Color="#1E3F5C"/>
    <SolidColorBrush x:Key="RowSelectedBorder" Color="#2F5D85"/>
    <SolidColorBrush x:Key="RowSelectedInactive" Color="#333333"/>
    <SolidColorBrush x:Key="RowSelectedInactiveBorder" Color="#404040"/>
    <SolidColorBrush x:Key="RowSelectedHover" Color="#24496A"/>
    <SolidColorBrush x:Key="RowSelectedHoverBorder" Color="#386B96"/>
    <SolidColorBrush x:Key="RowCaretBorder" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="StatusWarningGlyph" Color="#FCE100"/>
    <SolidColorBrush x:Key="StatusErrorGlyph" Color="#FF99A4"/>
    <SolidColorBrush x:Key="RowActionHover" Color="#2F4B63"/>


    <!-- ===== Controls ================================================== -->

    <SolidColorBrush x:Key="ControlHover" Color="#333333"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#454545"/>
    <SolidColorBrush x:Key="ControlChecked" Color="#404040"/>
    <SolidColorBrush x:Key="OptionRing" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="OptionRingChecked" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="OptionRingHover" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="TrackBackground" Color="#333333"/>
    <SolidColorBrush x:Key="TrackBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ProgressBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="TreeChevron" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="TreeChevronExpanded" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TreeChevronHover" Color="#60B0F0"/>
    <SolidColorBrush x:Key="DropZoneFill" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="DropZoneGlyph" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="DropZoneActiveFill" Color="#1E3F5C"/>
    <SolidColorBrush x:Key="DropZoneActiveGlyph" Color="#8CC8FF"/>
    <SolidColorBrush x:Key="SampleIconFill" Color="#4A5A6E"/>
    <SolidColorBrush x:Key="SampleIconEdge" Color="#7890AC"/>
    <SolidColorBrush x:Key="SpinnerQuiet" Color="#8A8A8A"/>


    <!-- ===== Menus ===================================================== -->

    <SolidColorBrush x:Key="MenuPopupBackground" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="MenuPopupBorder" Color="#454545"/>
    <SolidColorBrush x:Key="MenuForeground" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="MenuForegroundDisabled" Color="#787878"/>
    <SolidColorBrush x:Key="MenuForegroundGesture" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="MenuHighlight" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="MenuSeparator" Color="#404040"/>


    <!-- ===== Stock controls ============================================ -->

    <SolidColorBrush x:Key="ButtonBackground" Color="#333333"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#555555"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#34404C"/>
    <SolidColorBrush x:Key="ButtonHoverBorder" Color="#4C7FAD"/>
    <SolidColorBrush x:Key="ButtonPressed" Color="#2A3642"/>
    <SolidColorBrush x:Key="ButtonPressedBorder" Color="#5B93C7"/>
    <SolidColorBrush x:Key="ButtonChecked" Color="#2E3D4C"/>
    <SolidColorBrush x:Key="ButtonCheckedBorder" Color="#5B93C7"/>
    <SolidColorBrush x:Key="ButtonDisabled" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ButtonDisabledBorder" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="ButtonDisabledText" Color="#707070"/>
    <SolidColorBrush x:Key="ButtonDefaultBorder" Color="#4CA0E0"/>

    <SolidColorBrush x:Key="CheckBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CheckBorder" Color="#8C8C8C"/>
    <SolidColorBrush x:Key="CheckGlyph" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="CheckHover" Color="#313A44"/>
    <SolidColorBrush x:Key="CheckHoverBorder" Color="#5AA0E8"/>
    <SolidColorBrush x:Key="CheckPressed" Color="#2A3642"/>
    <SolidColorBrush x:Key="CheckPressedBorder" Color="#6CB0F0"/>
    <SolidColorBrush x:Key="CheckDisabled" Color="#262626"/>
    <SolidColorBrush x:Key="CheckDisabledBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="CheckDisabledGlyph" Color="#6E6E6E"/>

    <SolidColorBrush x:Key="RaisedBackground" Color="#333333"/>
    <SolidColorBrush x:Key="RaisedBorder" Color="#555555"/>
    <SolidColorBrush x:Key="RaisedHover" Color="#34404C"/>
    <SolidColorBrush x:Key="RaisedHoverBorder" Color="#4C7FAD"/>
    <SolidColorBrush x:Key="RaisedPressed" Color="#2A3642"/>
    <SolidColorBrush x:Key="RaisedPressedBorder" Color="#5B93C7"/>
    <SolidColorBrush x:Key="RaisedDisabled" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="RaisedDisabledBorder" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="RaisedSelected" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="RaisedGlyph" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="RaisedGlyphActive" Color="White"/>
    <SolidColorBrush x:Key="RaisedGlyphDisabled" Color="#5A5A5A"/>

    <SolidColorBrush x:Key="DropDownBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="DropDownBorder" Color="#555555"/>

    <SolidColorBrush x:Key="ItemHover" Color="#264CA0E0"/>
    <SolidColorBrush x:Key="ItemHoverBorder" Color="#804CA0E0"/>
    <SolidColorBrush x:Key="ItemHoverFocused" Color="#594CA0E0"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#4D4CA0E0"/>
    <SolidColorBrush x:Key="ItemSelectedBorder" Color="#FF4CA0E0"/>
    <SolidColorBrush x:Key="ItemSelectedInactive" Color="#3D808080"/>
    <SolidColorBrush x:Key="ItemSelectedInactiveBorder" Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="ItemSelectedHover" Color="#664CA0E0"/>
    <SolidColorBrush x:Key="ItemSelectedHoverBorder" Color="#CC4CA0E0"/>

    <SolidColorBrush x:Key="ScrollTrack" Color="#232323"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#4F4F4F"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="ScrollThumbDragging" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="ScrollArrow" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="ScrollArrowHover" Color="White"/>
    <SolidColorBrush x:Key="ScrollArrowPressed" Color="#191919"/>
    <SolidColorBrush x:Key="ScrollArrowDisabled" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ScrollButtonHover" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ScrollButtonPressed" Color="#9A9A9A"/>

    <SolidColorBrush x:Key="ToolTipBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="ToolTipBorder" Color="#555555"/>
    <SolidColorBrush x:Key="ToolTipText" Color="#E0E0E0"/>

    <SolidColorBrush x:Key="SliderTrack" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="SliderTrackBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="SliderThumb" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="SliderThumbHover" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="SliderThumbPressed" Color="#D0D0D0"/>

    <SolidColorBrush x:Key="HeaderFace" Color="#202020"/>
    <SolidColorBrush x:Key="HeaderHover" Color="#2D3540"/>
    <SolidColorBrush x:Key="HeaderPressed" Color="#26303A"/>
    <SolidColorBrush x:Key="HeaderLine" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="HeaderSortArrow" Color="#8A8A8A"/>


    <!-- ===== Windows' system colours =================================== -->

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#191919"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#202020"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#333333"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#505050"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowFrameBrushKey}" Color="#555555"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HotTrackBrushKey}" Color="#60B0F0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F0F0F0"/>
</ResourceDictionary>
