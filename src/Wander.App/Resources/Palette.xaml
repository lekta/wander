<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Every colour the application draws with, in one place.

        Merged into App.xaml, so `{StaticResource ...}` reaches it from any
        window, view or control template, and `Resources/Palette.cs` reaches
        it from the code-behind that has to build a brush by hand.

        WHY ONE FILE. The dark theme on the Roadmap is a second set of these
        values and nothing else. That only works if there is nothing else:
        a colour left inline in a view is a corner of the window that stays
        light while the rest goes dark, and it is invisible until it happens.
        So: no `Foreground="#888"` in a view, ever again - add a key here and
        point at it.

        NAMES SAY WHAT IS PAINTED, not what colour it is. `TextDim` survives
        a theme; `Grey888` does not.

        THE GREY LADDER IS INHERITED. Seven levels of quiet text arrived one
        view at a time, and they are kept apart here rather than collapsed:
        merging them would change what is on screen today, which this step
        is not allowed to do. Whether the ladder needs seven rungs is a
        question for the theme work - noted in TECHDEBT.md.

        NOT HERE, on purpose:
        - GalleryPalette (ViewModels/) computes the gallery's colours from
          the chosen background rather than picking them, so its values are
          arithmetic, not constants. It carries its own copy of Explorer's
          selection colours, which are also below under "Rows".
        - Highlighting/*.xshd - AvalonEdit's own format for code tokens.
        - WebView2's DefaultBackgroundColor in PreviewPane - a
          System.Drawing colour on a native control, and the paper a
          document is drawn on rather than window chrome.
        - SystemIconProvider's book-cover composition (Platform.Windows)
          - that is drawing a bitmap, and the platform layer cannot see
          App resources anyway.
        - The 3D preview's scene lighting is at the bottom, kept separate:
          it is the model's lighting, not the window's chrome.
    -->

    <!-- ===== Surfaces ================================================== -->

    <!-- The strip above and below the content: toolbar, preview footer, small dialogs. -->
    <SolidColorBrush x:Key="ChromeBackground" Color="#F3F3F3"/>

    <!-- The folder panels down the left. -->
    <SolidColorBrush x:Key="PaneBackground" Color="#F8F8F8"/>

    <!-- The preview pane's own surface, a shade lighter than the chrome. -->
    <SolidColorBrush x:Key="PreviewBackground" Color="#FAFAFA"/>

    <!-- A list that is a field rather than the content area (settings). -->
    <SolidColorBrush x:Key="ListBackground" Color="#FAFAFA"/>

    <!-- Text boxes, the address bar, popup cards: where typing happens. -->
    <SolidColorBrush x:Key="InputBackground" Color="White"/>

    <!-- What a listing or a table is drawn on. -->
    <SolidColorBrush x:Key="ContentBackground" Color="White"/>

    <!-- A field that shows a value the user cannot edit. -->
    <SolidColorBrush x:Key="ReadOnlyFieldBackground" Color="#F7F7F7"/>

    <!-- A toolstrip inside the content area - the gallery / rating filter bar. -->
    <SolidColorBrush x:Key="StripBackground" Color="#F7F7F7"/>

    <!-- A clickable section header - the bookmarks panel's title row. -->
    <SolidColorBrush x:Key="HeaderBackground" Color="#EEE"/>

    <!-- Every other row of the details table. -->
    <SolidColorBrush x:Key="DetailsRowAlternate" Color="#F7F7F7"/>

    <!-- ...and of the settings tables, which sit on a lighter surface. -->
    <SolidColorBrush x:Key="TableRowAlternate" Color="#FAFAFA"/>

    <!-- A sample of the thing being configured, shown inside a settings row. -->
    <SolidColorBrush x:Key="SampleRowBackground" Color="#F5F5F5"/>

    <!-- A boxed example inside a settings page. -->
    <SolidColorBrush x:Key="InsetBackground" Color="#F0F0F0"/>

    <!-- "This folder is gone" and the other full-pane messages. -->
    <SolidColorBrush x:Key="EmptyStateBackground" Color="#FDFDFD"/>

    <!-- Laid over the content while a folder is being read; translucent so it dims rather than hides. -->
    <SolidColorBrush x:Key="LoadingVeil" Color="#80FAFAFA"/>


    <!-- ===== Lines ===================================================== -->

    <!-- Splitters, pane edges, the rule under a header: the app's default line. -->
    <SolidColorBrush x:Key="Separator" Color="#DDD"/>

    <!-- The frame around a card - the two file panes of the conflict dialog. -->
    <SolidColorBrush x:Key="CardBorder" Color="#CCC"/>

    <!-- A text field's frame. Windows' own control border, matched deliberately. -->
    <SolidColorBrush x:Key="InputBorder" Color="#ABADB3"/>

    <!-- The rule between the app's bookmarks and the user's own. -->
    <SolidColorBrush x:Key="SectionRule" Color="#D6D6D6"/>

    <!-- Grid lines inside a settings table - quieter than a separator. -->
    <SolidColorBrush x:Key="GridLine" Color="#EEE"/>

    <!--
        The outline that says where the keyboard is. Muted grey rather than
        the system accent: it is on screen the whole time, and a bright frame
        around whatever you are working in reads as an alarm.
    -->
    <SolidColorBrush x:Key="FocusOutline" Color="#998A8A8A"/>


    <!-- ===== Text ====================================================== -->

    <!-- A heading inside the content area. -->
    <SolidColorBrush x:Key="TextHeading" Color="#333"/>

    <!-- A label next to a value. -->
    <SolidColorBrush x:Key="TextSecondary" Color="#444"/>

    <!-- Status text and glyph buttons. -->
    <SolidColorBrush x:Key="TextMuted" Color="#555"/>

    <!-- The caption over a group of values. -->
    <SolidColorBrush x:Key="TextCaption" Color="#666"/>

    <!-- The second line under a tile - kind, path. -->
    <SolidColorBrush x:Key="TextSubtle" Color="#777"/>

    <!-- Hints and secondary values: the quietest text still meant to be read. -->
    <SolidColorBrush x:Key="TextDim" Color="#888"/>

    <!-- The prompt inside an empty search box. -->
    <SolidColorBrush x:Key="TextPlaceholder" Color="#999"/>

    <!-- A bookmark whose folder is no longer there. -->
    <SolidColorBrush x:Key="TextDisabled" Color="#9A9A9A"/>

    <!-- "This folder is on a drive that is nearly full" and its kind. -->
    <SolidColorBrush x:Key="TextWarning" Color="#A05000"/>

    <!-- A rejected name in the rename prompt. -->
    <SolidColorBrush x:Key="TextError" Color="IndianRed"/>

    <!-- ...and the frame round the box it was typed into. -->
    <SolidColorBrush x:Key="InputBorderError" Color="IndianRed"/>


    <!-- ===== Rows ====================================================== -->
    <!--
        Explorer's own selection colours, used as-is: the list and the trees
        are the part of Wander that has to feel like the shell. The gallery
        computes its own from the chosen background - see GalleryPalette,
        which repeats these six for its light case.
    -->

    <SolidColorBrush x:Key="RowHover" Color="#E5F3FB"/>
    <SolidColorBrush x:Key="RowHoverBorder" Color="#D2ECF8"/>

    <SolidColorBrush x:Key="RowSelected" Color="#CCE8FF"/>
    <SolidColorBrush x:Key="RowSelectedBorder" Color="#AFD9F2"/>

    <!-- Selected while the keyboard is in another pane - the answer to "what does Delete mean". -->
    <SolidColorBrush x:Key="RowSelectedInactive" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="RowSelectedInactiveBorder" Color="#DCDCDC"/>

    <SolidColorBrush x:Key="RowSelectedHover" Color="#BFE0FA"/>
    <SolidColorBrush x:Key="RowSelectedHoverBorder" Color="#A5D3EE"/>

    <!-- The "..." button that appears on a bookmark row under the cursor. -->
    <SolidColorBrush x:Key="RowActionHover" Color="#C4E0F4"/>


    <!-- ===== Controls ================================================== -->

    <!-- A flat toolbar button under the cursor, and pressed. -->
    <SolidColorBrush x:Key="ControlHover" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#C8C8C8"/>

    <!-- A toggle that is on - the recent-folders chevron. -->
    <SolidColorBrush x:Key="ControlChecked" Color="#D0D0D0"/>

    <!-- The ring round the chosen colour label. -->
    <SolidColorBrush x:Key="SwatchRing" Color="#666"/>

    <!-- The square round each gallery-background option: idle, chosen, under the cursor. -->
    <SolidColorBrush x:Key="OptionRing" Color="#BBB"/>
    <SolidColorBrush x:Key="OptionRingChecked" Color="#444"/>
    <SolidColorBrush x:Key="OptionRingHover" Color="#888"/>

    <!-- A progress bar's trough. -->
    <SolidColorBrush x:Key="TrackBackground" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="TrackBorder" Color="#CCC"/>

    <!-- The folder tree's chevron: idle, expanded, under the cursor. -->
    <SolidColorBrush x:Key="TreeChevron" Color="#606060"/>
    <SolidColorBrush x:Key="TreeChevronExpanded" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TreeChevronHover" Color="#0078D7"/>

    <!-- The "drop a folder here" strip under the bookmarks: idle, and with a drag over it. -->
    <SolidColorBrush x:Key="DropZoneFill" Color="#ECECEC"/>
    <SolidColorBrush x:Key="DropZoneGlyph" Color="#888888"/>
    <SolidColorBrush x:Key="DropZoneActiveFill" Color="#CCE8FF"/>
    <SolidColorBrush x:Key="DropZoneActiveGlyph" Color="#0055A8"/>

    <!-- The sample file icon drawn in the settings preview. -->
    <SolidColorBrush x:Key="SampleIconFill" Color="#C7D6E8"/>
    <SolidColorBrush x:Key="SampleIconEdge" Color="#8FA8C4"/>


    <!-- ===== Accent ==================================================== -->
    <!-- Windows' own accent blue. Wander does not follow the user's accent
         colour yet; when it does, this is the one value that changes. -->

    <SolidColorBrush x:Key="AccentText" Color="#0078D7"/>
    <SolidColorBrush x:Key="AccentFill" Color="#0078D7"/>
    <SolidColorBrush x:Key="AccentStroke" Color="#0078D7"/>

    <!-- Text laid directly on the accent. -->
    <SolidColorBrush x:Key="OnAccentText" Color="White"/>

    <!-- The lasso dragged across the list, and the frame round a drop target. -->
    <SolidColorBrush x:Key="MarqueeFill" Color="#280078D7"/>
    <SolidColorBrush x:Key="MarqueeStroke" Color="#B40078D7"/>
    <SolidColorBrush x:Key="DropTargetFill" Color="#3C0078D7"/>
    <SolidColorBrush x:Key="DropTargetStroke" Color="#DC0078D7"/>

    <!-- A search still running: deliberately not the accent, so it does not
         compete with the results arriving underneath it. -->
    <SolidColorBrush x:Key="SpinnerQuiet" Color="#999"/>

    <!-- How full the drive is. Explorer does the same, and it is the one
         piece of colour on the preview panel that carries information. -->
    <SolidColorBrush x:Key="VolumeBarNormal" Color="#0078D7"/>
    <SolidColorBrush x:Key="VolumeBarFilling" Color="#CA8A00"/>
    <SolidColorBrush x:Key="VolumeBarFull" Color="#D13438"/>


    <!-- ===== Marks ===================================================== -->
    <!-- Colours that carry information rather than decorate: a rating, a
         colour label, what a drop would do. A theme may retune them, but it
         may not merge two of them. -->

    <SolidColorBrush x:Key="RatingStar" Color="#D08A00"/>
    <SolidColorBrush x:Key="RatingStarEmpty" Color="#AAAAAA"/>

    <!-- The rating badge in a corner of a thumbnail: dark plate, light figure. -->
    <SolidColorBrush x:Key="BadgeBackground" Color="#33000000"/>
    <SolidColorBrush x:Key="BadgeRating" Color="#FFD37A"/>

    <!-- The five colour labels, in the order they are numbered. -->
    <SolidColorBrush x:Key="ColorLabel1" Color="#D9534F"/>
    <SolidColorBrush x:Key="ColorLabel2" Color="#E0B32C"/>
    <SolidColorBrush x:Key="ColorLabel3" Color="#5CA94D"/>
    <SolidColorBrush x:Key="ColorLabel4" Color="#3E7CC4"/>
    <SolidColorBrush x:Key="ColorLabel5" Color="#8A5CB8"/>

    <!-- What the drag leaving Wander would do, on the plaque under the cursor. -->
    <SolidColorBrush x:Key="DragMove" Color="SteelBlue"/>
    <SolidColorBrush x:Key="DragCopy" Color="SeaGreen"/>
    <SolidColorBrush x:Key="DragLink" Color="DarkOrange"/>
    <SolidColorBrush x:Key="DragForbidden" Color="IndianRed"/>

    <!-- The plaque itself: near-white, so it reads over any window it crosses. -->
    <SolidColorBrush x:Key="DragPlaqueBackground" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="DragPlaqueBorder" Color="#80000000"/>


    <!-- ===== Menus ===================================================== -->
    <!-- Windows 11 menu chrome. Used by MenuStyles.xaml, which merges this
         file, and by the context menus ContextMenuFactory builds in code. -->

    <SolidColorBrush x:Key="MenuPopupBackground" Color="#FBFBFB"/>
    <SolidColorBrush x:Key="MenuPopupBorder" Color="#E2E2E2"/>
    <SolidColorBrush x:Key="MenuForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="MenuForegroundDisabled" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="MenuForegroundGesture" Color="#757575"/>
    <SolidColorBrush x:Key="MenuHighlight" Color="#ECECEC"/>
    <SolidColorBrush x:Key="MenuSeparator" Color="#E5E5E5"/>

    <!-- The shadow a popup casts. A Color, not a brush: DropShadowEffect wants one. -->
    <Color x:Key="MenuShadowColor">#000000</Color>


    <!-- ===== Not chrome ================================================ -->
    <!--
        The 3D preview's scene lighting. Here so this file really is every
        colour in the application, and separate so a theme leaves it alone:
        these light the model, and a model lit for a dark window is a model
        lit wrong. One directional light plus a dim ambient one - a single
        light leaves everything facing away from it pure black, which on an
        untextured solid reads as a hole in the model.
    -->

    <Color x:Key="ModelAmbientLight">#404040</Color>
    <Color x:Key="ModelKeyLight">#C8C8C8</Color>
    <Color x:Key="ModelFillLight">#505050</Color>
</ResourceDictionary>
