<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Every colour the application draws with, in three files:

        - Palette.xaml (this one): the colours a theme leaves alone - marks
          that carry information, things drawn over a photograph, the 3D
          scene's light. Always merged.
        - Palette.Light.xaml and Palette.Dark.xaml: the window's chrome, the
          same keys in both. The light one is always merged; the dark one is
          laid over it while the theme is dark (Util/InterfaceTheme), and
          everything that paints with it repaints.

        Merged into Shared.xaml, so a resource reference reaches any key
        from any window, view or control template, and Resources/Palette.cs
        reaches them from the code-behind that has to paint by hand.

        WHY HERE AND NOWHERE ELSE. A colour left inline in a view is a corner
        of the window that stays light while the rest goes dark. So: no
        Foreground="#888" in a view - add a key and point at it. WPF's own
        controls paint with colours of their theme baked in; they are
        redrawn with these keys in StockControls.xaml.

        A THEMED KEY IS A DynamicResource. The switch replaces the brushes; a
        StaticResource holds the one it found when the view was built, and
        that view stays in the old theme. The keys in this file never change
        and may stay StaticResource. check-resources.ps1 checks that the two
        theme files define the same keys.

        NAMES SAY WHAT IS PAINTED, not what colour it is. TextDim survives
        a theme; Grey888 does not.

        NOT HERE, on purpose:
        - GalleryPalette (ViewModels/) computes the gallery's colours from
          the chosen background, and takes the theme's own row colours for
          the background that follows the window.
        - Highlighting/*.xshd and AvalonEdit's built-in definitions: colours
          made for white paper, redrawn for a dark one by arithmetic
          (Highlighting/ThemedTextEditor) rather than kept twice.
        - Preview/PreviewText's stylesheet for Markdown and books: a web
          page's own, with both schemes in it.
        - WebView2's DefaultBackgroundColor (Views/PreviewPane): a native
          control's System.Drawing colour.
        - SystemIconProvider's book-cover composition (Platform.Windows):
          that is drawing a bitmap.
    -->


    <!-- ===== Marks ===================================================== -->
    <!-- Colours that carry information rather than decorate: a rating, a
         colour label, what a drop would do. Read on the light chrome and on
         the dark bar of the full screen alike, so one set serves both
         themes. A theme may never merge two of them. -->

    <SolidColorBrush x:Key="RatingStar" Color="#D08A00"/>
    <SolidColorBrush x:Key="RatingStarEmpty" Color="#AAAAAA"/>

    <!-- The rating badge in a corner of a thumbnail: dark plate, light figure. -->
    <SolidColorBrush x:Key="BadgeBackground" Color="#33000000"/>
    <SolidColorBrush x:Key="BadgeRating" Color="#FFD37A"/>

    <!-- The five colour labels, in the order they are numbered. -->
    <SolidColorBrush x:Key="ColorLabel1" Color="#D9534F"/>
    <SolidColorBrush x:Key="ColorLabel2" Color="#E0B32C"/>
    <SolidColorBrush x:Key="ColorLabel3" Color="#5CA94D"/>
    <SolidColorBrush x:Key="ColorLabel4" Color="#3E7CC4"/>
    <SolidColorBrush x:Key="ColorLabel5" Color="#8A5CB8"/>

    <!-- The review helpers over a photograph (RAWHELPERS): peaking edges,
         crushed shadows, autofocus frames, the chart of levels, how sharp
         the frame is. Clipped highlights paint in the colour of the
         channel that clipped and are not here: that colour is the
         information. -->
    <SolidColorBrush x:Key="ReviewPeaking" Color="#FF2BD6"/>
    <SolidColorBrush x:Key="ReviewUnder" Color="#3D5AFE"/>
    <SolidColorBrush x:Key="ReviewAfFocused" Color="#FF2BD6"/>
    <SolidColorBrush x:Key="ReviewAfOther" Color="#B0B0B0"/>
    <!-- The focused frames on a gallery thumbnail: the same pink let
         through, so a wall of cells does not shout. -->
    <SolidColorBrush x:Key="ReviewAfThumb" Color="#A6FF2BD6"/>
    <SolidColorBrush x:Key="ReviewChartPlate" Color="#CC202020"/>
    <SolidColorBrush x:Key="ReviewChartRed" Color="#99FF4040"/>
    <SolidColorBrush x:Key="ReviewChartGreen" Color="#9940E040"/>
    <SolidColorBrush x:Key="ReviewChartBlue" Color="#994080FF"/>
    <SolidColorBrush x:Key="ReviewChartOver" Color="#FF5A5A"/>
    <SolidColorBrush x:Key="ReviewChartUnder" Color="#6F8BFF"/>
    <SolidColorBrush x:Key="ReviewSharp" Color="#C838E8"/>
    <!-- A helper's switch: a grey plate and frame, half see-through, so
         one switch reads over a dark picture and on the light footer
         alike; under the cursor, nearer the middle grey from either side;
         on, a denser grey plate and a frame of two rings, dark outside and
         light inside - no colour of its own (2026-10-08), the accent's blue
         drew the eye off the picture. One ring reads on the dark bar, the
         other on the light footer; light alone was lost on the footer. -->
    <SolidColorBrush x:Key="ReviewToggleFill" Color="#40808080"/>
    <SolidColorBrush x:Key="ReviewToggleBorder" Color="#80808080"/>
    <SolidColorBrush x:Key="ReviewToggleHover" Color="#66909090"/>
    <SolidColorBrush x:Key="ReviewToggleOn" Color="#80808080"/>
    <SolidColorBrush x:Key="ReviewToggleOnOuter" Color="#99000000"/>
    <SolidColorBrush x:Key="ReviewToggleOnBorder" Color="#D9D9D9"/>

    <!-- Under the stars and switches a picture carries in its corner:
         a dark tint of a fifth, the picture shows through. -->
    <SolidColorBrush x:Key="PictureBarPlate" Color="#33000000"/>

    <!-- A warning or an error said over a picture full screen, where the
         status bar is covered: dark and near opaque, to read over any frame. -->
    <SolidColorBrush x:Key="FullscreenNoticePlate" Color="#E6202020"/>
    <SolidColorBrush x:Key="FullscreenNoticeText" Color="#F2F2F2"/>

    <!--
        The mark on a row's icon while an operation of the user's works on
        it (AsyncIcon.ShowsWork): Explorer's accent blue, on a plate that keeps it
        readable over any thumbnail.
    -->
    <SolidColorBrush x:Key="WorkBadgeGlyph" Color="#0078D7"/>
    <SolidColorBrush x:Key="WorkBadgeBackground" Color="#E6FFFFFF"/>

    <!-- What the drag leaving Wander would do, on the plaque under the cursor. -->
    <SolidColorBrush x:Key="DragMove" Color="SteelBlue"/>
    <SolidColorBrush x:Key="DragCopy" Color="SeaGreen"/>
    <SolidColorBrush x:Key="DragLink" Color="DarkOrange"/>
    <SolidColorBrush x:Key="DragForbidden" Color="IndianRed"/>

    <!-- The plaque itself: near-white, so it reads over any window it crosses, Wander's own in either theme. -->
    <SolidColorBrush x:Key="DragPlaqueBackground" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="DragPlaqueBorder" Color="#80000000"/>
    <!-- Its text, and the line under the verb - where it would land: dark on the near-white whatever the theme. -->
    <SolidColorBrush x:Key="DragPlaqueText" Color="Black"/>
    <SolidColorBrush x:Key="DragPlaqueCaption" Color="#555"/>

    <!-- How full the drive is. Explorer does the same, and it is the one
         piece of colour on the preview panel that carries information. -->
    <SolidColorBrush x:Key="VolumeBarNormal" Color="#0078D7"/>
    <SolidColorBrush x:Key="VolumeBarFilling" Color="#CA8A00"/>
    <SolidColorBrush x:Key="VolumeBarFull" Color="#D13438"/>

    <!-- The paper a document is drawn on (an .rtf in the preview): white in
         either theme - a document's own colours are chosen for white. -->
    <SolidColorBrush x:Key="PaperBackground" Color="White"/>
    <SolidColorBrush x:Key="PaperText" Color="Black"/>

    <!-- A progress bar's fill: Aero2's green, which says "going" on light and dark alike. -->
    <SolidColorBrush x:Key="ProgressFill" Color="#06B025"/>


    <!-- ===== Accent ==================================================== -->
    <!-- Windows' own accent blue. Wander does not follow the user's accent
         colour yet; when it does, these and AccentText / AccentStroke in the
         theme files are the values that change. -->

    <SolidColorBrush x:Key="AccentFill" Color="#0078D7"/>

    <!-- Text laid directly on the accent. -->
    <SolidColorBrush x:Key="OnAccentText" Color="White"/>

    <!-- The lasso dragged across the list, and the frame round a drop
         target: see-through, so the same blue reads on either theme. -->
    <SolidColorBrush x:Key="MarqueeFill" Color="#280078D7"/>
    <SolidColorBrush x:Key="MarqueeStroke" Color="#B40078D7"/>
    <SolidColorBrush x:Key="DropTargetFill" Color="#3C0078D7"/>
    <SolidColorBrush x:Key="DropTargetStroke" Color="#DC0078D7"/>


    <!-- The shadow a popup casts. A Color, not a brush: DropShadowEffect wants one. -->
    <Color x:Key="MenuShadowColor">#000000</Color>


    <!-- ===== Not chrome ================================================ -->
    <!--
        The 3D preview's scene lighting. Here so these files really are every
        colour in the application, and in this one so a theme leaves it
        alone: these light the model, and a model lit for a dark window is a
        model lit wrong. One directional light plus a dim ambient one - a
        single light leaves everything facing away from it pure black, which
        on an untextured solid reads as a hole in the model.
    -->

    <Color x:Key="ModelAmbientLight">#404040</Color>
    <Color x:Key="ModelKeyLight">#C8C8C8</Color>
    <Color x:Key="ModelFillLight">#505050</Color>
</ResourceDictionary>
