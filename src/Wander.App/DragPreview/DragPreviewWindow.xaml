<Window x:Class="Wander.App.DragPreview.DragPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Focusable="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Border Background="#F2FFFFFF"
            BorderBrush="#80000000"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" Opacity="0.35" ShadowDepth="2"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Grid Width="40" Height="40" Margin="0,0,10,0">
                <Image x:Name="FileIcon" Width="32" Height="32"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border x:Name="CountBadge"
                        Background="#0078D7"
                        CornerRadius="9"
                        Padding="5,1"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        MinWidth="20"
                        Visibility="Collapsed">
                    <TextBlock x:Name="CountLabel"
                               Foreground="White" FontSize="10" FontWeight="Bold"
                               TextAlignment="Center"/>
                </Border>
            </Grid>

            <StackPanel VerticalAlignment="Center" MinWidth="160" MaxWidth="320">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ActionIcon"
                               FontSize="16" FontWeight="Bold"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ActionLabel"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="TargetLabel"
                           FontSize="11" Foreground="#666"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
