<Window x:Class="Wander.App.Conflict.BatchConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Wander.App.Resources"
        Title="{x:Static res:Strings.BatchConflictTitle}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeaderText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{x:Static res:Strings.BatchConflictPrompt}"
                   Margin="0,8,0,0" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ReplaceAllBtn" Content="{x:Static res:Strings.BatchReplaceAll}" Width="120" Margin="0,0,6,0" Click="OnReplaceAll"/>
            <Button x:Name="SkipAllBtn" Content="{x:Static res:Strings.BatchSkipAll}" Width="120" Margin="0,0,6,0" Click="OnSkipAll"/>
            <Button x:Name="ResolveEachBtn" Content="{x:Static res:Strings.BatchResolveEach}" Width="130" Margin="0,0,6,0" Click="OnResolveEach"/>
            <Button x:Name="CancelBtn" Content="{x:Static res:Strings.ActionCancel}" Width="100" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
