<Window x:Class="Wander.App.Conflict.BatchConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File conflicts"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeaderText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="Choose what to do with conflicting items:"
                   Margin="0,8,0,0" Foreground="#555" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ReplaceAllBtn" Content="Replace all" Width="100" Margin="0,0,6,0" Click="OnReplaceAll"/>
            <Button x:Name="SkipAllBtn" Content="Skip all" Width="100" Margin="0,0,6,0" Click="OnSkipAll"/>
            <Button x:Name="ResolveEachBtn" Content="Resolve each" Width="110" Margin="0,0,6,0" Click="OnResolveEach"/>
            <Button x:Name="CancelBtn" Content="Cancel" Width="80" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
