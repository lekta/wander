<UserControl x:Class="Wander.App.Views.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Wander.App.Converters"
             xmlns:controls="clr-namespace:Wander.App.Controls"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:res="clr-namespace:Wander.App.Resources"
             BorderBrush="{StaticResource Separator}" BorderThickness="1,0,0,0"
             Background="{StaticResource PreviewBackground}">
    <!--
        The preview pane: one content area that switches by
        PreviewController.Kind (image, animated GIF, video, text, code, web,
        folder statistics) plus the summary footer under it.

        It moved out of MainWindow with its code-behind because it is the
        second self-contained region of the window — image zoom, the video
        transport and the WebView2 handshake are three separate little state
        machines, and none of them has anything to say to the file list or
        the trees. The window keeps only the layout question ("is the pane
        visible, how wide"), because that is a property of the window's grid.
    -->
    <UserControl.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
        <conv:BitmapPixelSizeConverter x:Key="BitmapPixelSize"/>
        <conv:RankStarConverter x:Key="RankStar"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!--
            Text drawn on the content surround, which is the gallery's
            background rather than a colour of our own. Two weights, both
            out of GalleryPalette: the caption colour and the quieter one.

            These exist because the surround stopped being an
            image-only affair. The folder census and the "nothing selected"
            line sit on it now, and near-black text on the dark surround is
            not text — the palette already computes a legible pair for
            whichever background is chosen, so the pane uses it instead of
            re-deciding.
        -->
        <!--
            `DataContext.` is not decoration. A RelativeSource binding
            resolves its path against the *element* it found, so without it
            the path is looked up on the UserControl itself, which has no
            such property — the binding then quietly yields nothing and the
            text keeps its inherited black. Which is invisible on the very
            background these styles exist for.
        -->
        <Style x:Key="PaneText" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{Binding DataContext.ContentPalette.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Style>

        <Style x:Key="PaneDim" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{Binding DataContext.ContentPalette.Dim, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Style>

        <!--
            One star of the .pp3 rating widget. Five copies of this in the
            footer, each with its own CommandParameter; clicking the star
            that already marks the rating clears it.
        -->
        <Style x:Key="RatingStar" TargetType="Button">
            <Setter Property="Command" Value="{Binding Preview.SetRankCommand}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource RatingStar}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Preview.RatingSource, StringFormat='Rating, written to {0}'}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!--
                    A photo with no sidecar yet. The stars are live - the
                    first click creates the file, after asking - but they are
                    dimmed, because five hollow stars that mean "not rated"
                    and five that mean "there is nowhere to write a rating
                    yet" are not the same statement, and the difference is
                    exactly the one the click is about to resolve.
                -->
                <DataTrigger Binding="{Binding Preview.IsRatingUnsaved}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                    <Setter Property="ToolTip" Value="{x:Static res:Strings.PreviewRatingUnsaved}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            One colour-label swatch. The chosen one gets a ring rather than a
            different fill — the fill *is* the information, so it must not
            change to indicate selection.
        -->
        <Style x:Key="ColorLabelSwatch" TargetType="Button">
            <Setter Property="Command" Value="{Binding DataContext.Preview.SetColorLabelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="2">
                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource SwatchRing}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="{StaticResource ControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Content area -->
                <Grid Grid.Row="0">
                    <!--
                        The content surround, same palette as the gallery's.
                        A photograph judged against a grey wall and then
                        opened on a white pane is two different photographs
                        to the eye, so the two surfaces have to agree.

                        It is drawn for everything the pane renders itself:
                        pictures, the folder census, and the empty state.
                        Those last two were the odd ones out — walking off a
                        photograph onto a folder used to blink the pane from
                        the chosen surround to a hard-coded near-white and
                        back, which is the one thing a surround chosen to
                        stay out of the way must not do.

                        Text, code and documents keep their own background:
                        they are pages, they come with one, and a page on a
                        dark surround is a light rectangle with a border,
                        not a dark page.
                    -->
                    <Border Background="{Binding ContentPalette.Background}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preview.Kind}" Value="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Preview.Kind}" Value="Gif">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Preview.Kind}" Value="Audio">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Preview.Kind}" Value="Folder">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Preview.Kind}" Value="None">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Preview.Kind}" Value="Unsupported">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <!--
                        Image preview. The fitted image stays in ImgFit; a
                        transparent canvas overlays it for the FastStone-style
                        "hold RMB to zoom 1:1" interaction. Everything is wired
                        in code-behind (ImageZoom_* handlers).
                    -->
                    <Grid x:Name="ImagePreviewHost"
                          Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Image}"
                          ClipToBounds="True"
                          Background="Transparent"
                          MouseEnter="ImageZoom_MouseEnter"
                          MouseLeave="ImageZoom_MouseLeave"
                          MouseMove="ImageZoom_MouseMove"
                          MouseLeftButtonDown="ImageZoom_LmbDown"
                          MouseLeftButtonUp="ImageZoom_LmbUp"
                          LostMouseCapture="ImageZoom_LostCapture">
                        <Image x:Name="ImgFit"
                               Source="{Binding Preview.Image}"
                               Stretch="Uniform" StretchDirection="DownOnly"
                               MaxWidth="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource BitmapPixelSize}, ConverterParameter=W}"
                               MaxHeight="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource BitmapPixelSize}, ConverterParameter=H}"
                               Margin="8,12,8,8"
                               VerticalAlignment="Top" HorizontalAlignment="Center"
                               SizeChanged="ImgFit_SizeChanged"/>
                        <!-- Zoom view: visible only while the user holds RMB. -->
                        <Canvas x:Name="ImgZoomCanvas"
                                Background="{Binding ContentPalette.Background}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <Image x:Name="ImgZoom"
                                   Source="{Binding Source, ElementName=ImgFit}"/>
                        </Canvas>
                    </Grid>

                    <!-- Animated GIF (also anchored middle-top with same margin). -->
                    <controls:GifImage x:Name="GifPreview"
                                       GifUri="{Binding Preview.GifUri}"
                                       Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Gif}"
                                       Stretch="Uniform" StretchDirection="DownOnly"
                                       MaxWidth="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource BitmapPixelSize}, ConverterParameter=W}"
                                       MaxHeight="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource BitmapPixelSize}, ConverterParameter=H}"
                                       Margin="8,12,8,8"
                                       VerticalAlignment="Top" HorizontalAlignment="Center"/>

                    <!--
                        Video and audio: one MediaElement, one transport.

                        Music is a video with nothing to draw — Media
                        Foundation reads MP3 and FLAC on Windows 10 and
                        later without anything installed — so the play
                        button, the clock and the seek bar are the ones
                        already debugged for video rather than a second
                        copy of the same little state machine. What differs
                        is only what fills the space above them: the
                        picture for a clip, the track's own card for a
                        song.
                    -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preview.Kind}" Value="Video">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Preview.Kind}" Value="Audio">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!--
                            Video only. Audio is played by a MediaPlayer in
                            the code-behind instead, because a MediaElement
                            that is not drawn does not play: with nothing to
                            render it measures to nothing, and a
                            MediaElement with no rendered area opens the
                            file, reports its duration, accepts Play() — and
                            leaves Position at zero for ever. Measured: the
                            same file in an element sized 200x120 plays, at
                            1x1 it is silent.

                            Source is assigned in code rather than bound,
                            so that an audio file does not get opened twice
                            (once here and once by the player that will
                            actually play it).
                        -->
                        <MediaElement x:Name="VideoPreview"
                                      Grid.Row="0"
                                      Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Video}"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      ScrubbingEnabled="True"
                                      Stretch="Uniform" StretchDirection="DownOnly"
                                      Margin="8,12,8,4"
                                      VerticalAlignment="Top" HorizontalAlignment="Center"
                                      MediaOpened="VideoPreview_MediaOpened"
                                      MediaEnded="VideoPreview_MediaEnded"
                                      MediaFailed="VideoPreview_MediaFailed"/>

                        <!--
                            The track's card. The cover gets the room it can
                            have and no more: a sleeve is square, a pane is
                            not, and a 1500-px scan blown up to fill the
                            height would push the name off the bottom.
                        -->
                        <StackPanel Grid.Row="0"
                                    Margin="16,20,16,8"
                                    VerticalAlignment="Top" HorizontalAlignment="Center"
                                    Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Audio}">
                            <Border MaxWidth="260" MaxHeight="260"
                                    HorizontalAlignment="Center"
                                    BorderBrush="{Binding ContentPalette.Dim}" BorderThickness="1"
                                    Visibility="{Binding Preview.HasAudioCover, Converter={StaticResource BoolToVisibility}}">
                                <Image Source="{Binding Preview.AudioCover}"
                                       Stretch="Uniform" StretchDirection="DownOnly"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <TextBlock Text="{Binding Preview.AudioTitle}"
                                       Style="{StaticResource PaneText}"
                                       Margin="0,12,0,0"
                                       FontSize="15" FontWeight="SemiBold"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="320"/>
                            <TextBlock Text="{Binding Preview.AudioArtist}"
                                       Style="{StaticResource PaneText}"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="320"
                                       Visibility="{Binding Preview.HasAudioArtist, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding Preview.AudioAlbum}"
                                       Style="{StaticResource PaneDim}"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="320"
                                       Visibility="{Binding Preview.HasAudioAlbum, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding Preview.AudioDetail}"
                                       Style="{StaticResource PaneDim}"
                                       Margin="0,8,0,0"
                                       FontSize="11"
                                       TextAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="8,4,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="VideoPlayPauseButton"
                                    Content="▶" Width="32" Padding="0,2"
                                    Grid.Column="0"
                                    Click="VideoPlayPause_Click"
                                    ToolTip="{x:Static res:Strings.PreviewPlayPause}"/>
                            <!--
                                Palette-coloured because for a track the
                                transport stands on the surround, and on the
                                dark one a default-black clock is a clock
                                nobody can read. For a clip the surround is
                                not drawn and the palette is the plain one,
                                so this is the same near-black it was.
                            -->
                            <TextBlock x:Name="VideoTimeText"
                                       Style="{StaticResource PaneText}"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Margin="8,0"
                                       FontFamily="Consolas" FontSize="11"
                                       Text="0:00 / 0:00"/>
                            <Slider x:Name="VideoSlider"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Minimum="0" Maximum="1"
                                    SmallChange="0.5" LargeChange="5"
                                    IsMoveToPointEnabled="True"
                                    PreviewMouseLeftButtonDown="VideoSlider_PreviewMouseDown"
                                    PreviewMouseLeftButtonUp="VideoSlider_PreviewMouseUp"
                                    ValueChanged="VideoSlider_ValueChanged"/>
                        </Grid>
                    </Grid>

                    <!--
                        3D model. A plain WPF Viewport3D — the format
                        readers live in Core and hand over geometry, and
                        drawing a shaded solid is something WPF has done
                        since it shipped, so no library is involved on
                        either side.

                        The camera is placed in code-behind: where it
                        belongs depends on how big the model is, and that
                        is not known until the file has been read. Orbit is
                        left-drag, zoom is the wheel — the two gestures a
                        viewer has to have, and no more, because this is a
                        preview and not a viewport.
                    -->
                    <Grid Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Model}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{Binding ContentPalette.Background}"
                                ClipToBounds="True"
                                MouseLeftButtonDown="Model_MouseDown"
                                MouseLeftButtonUp="Model_MouseUp"
                                MouseMove="Model_MouseMove"
                                MouseWheel="Model_MouseWheel">
                            <Viewport3D x:Name="ModelViewport" ClipToBounds="True"
                                        SizeChanged="Model_SizeChanged">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera x:Name="ModelCamera" FieldOfView="45"/>
                                </Viewport3D.Camera>
                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <Model3DGroup>
                                            <!--
                                                One directional light plus a
                                                dim ambient one: a single
                                                light leaves everything
                                                facing away from it pure
                                                black, which on an
                                                untextured solid reads as a
                                                hole in the model.
                                            -->
                                            <AmbientLight Color="{StaticResource ModelAmbientLight}"/>
                                            <DirectionalLight x:Name="ModelKeyLight" Color="{StaticResource ModelKeyLight}" Direction="-0.5,-1,-1"/>
                                            <DirectionalLight Color="{StaticResource ModelFillLight}" Direction="1,0.5,0.8"/>
                                            <!--
                                                The model's drawables, filled
                                                from code-behind: how many
                                                there are and what colour
                                                each one is depends on the
                                                file's materials, which XAML
                                                cannot know. The rotation
                                                sits on the group so every
                                                part turns together.
                                            -->
                                            <Model3DGroup x:Name="ModelParts">
                                                <Model3DGroup.Transform>
                                                    <Transform3DGroup>
                                                        <RotateTransform3D>
                                                            <RotateTransform3D.Rotation>
                                                                <AxisAngleRotation3D x:Name="ModelSpin" Axis="0,1,0" Angle="0"/>
                                                            </RotateTransform3D.Rotation>
                                                        </RotateTransform3D>
                                                        <RotateTransform3D>
                                                            <RotateTransform3D.Rotation>
                                                                <AxisAngleRotation3D x:Name="ModelTilt" Axis="1,0,0" Angle="0"/>
                                                            </RotateTransform3D.Rotation>
                                                        </RotateTransform3D>
                                                    </Transform3DGroup>
                                                </Model3DGroup.Transform>
                                            </Model3DGroup>
                                        </Model3DGroup>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                            </Viewport3D>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Preview.ModelDetail}"
                                   Margin="8,4,8,6"
                                   FontSize="11" Foreground="{StaticResource TextDim}"
                                   HorizontalAlignment="Center"/>
                    </Grid>

                    <!-- Plain text -->
                    <TextBox Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Text}"
                             Text="{Binding Preview.Text, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11"
                             Background="Transparent" BorderThickness="0"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="6"/>

                    <!-- Code with syntax highlighting -->
                    <ae:TextEditor x:Name="CodeEditor"
                                   Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Code}"
                                   IsReadOnly="True"
                                   ShowLineNumbers="True"
                                   FontFamily="Consolas" FontSize="11"
                                   Background="Transparent"
                                   Padding="4"/>

                    <!--
                        Rich text (.rtf). WPF reads the format itself, so
                        this is a real document rather than a text dump —
                        fonts, tables and images intact. Read-only, and
                        loaded in code-behind because TextRange.Load is the
                        only way in and it is not a bindable property.
                    -->
                    <RichTextBox x:Name="DocumentPreview"
                                 Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Document}"
                                 IsReadOnly="True" IsDocumentEnabled="True"
                                 Background="{StaticResource InputBackground}" BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Padding="6"/>

                    <!--
                        PDF / HTML / MHTML / Markdown / FB2 via WebView2.
                        DefaultBackgroundColor is the only colour in the app
                        outside Resources/Palette.xaml: it is a
                        System.Drawing colour on a native control and takes
                        no brush resource. It is also the paper a document
                        is drawn on rather than window chrome.
                    -->
                    <wv2:WebView2 x:Name="WebPreview"
                                  Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Web}"
                                  DefaultBackgroundColor="White"/>

                    <!--
                        Folder census (B2). Shown when the selection is a
                        folder, or when nothing is selected: "what is in
                        here and what is eating the space" is the question
                        a folder raises, and a wall of thumbnails does not
                        answer it.
                    -->
                    <ScrollViewer Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Folder}"
                                  VerticalScrollBarVisibility="Auto" Padding="12,10,12,10">
                        <StackPanel>
                            <!--
                                Drive header. Only appears at the root of a
                                volume: "how full is it" is a question about
                                a disk, and printing capacity above the
                                census of an ordinary folder would be
                                answering about the disk while showing
                                numbers about the folder.

                                The bar is a ProgressBar rather than two
                                nested Borders because a percentage maps
                                onto it directly — no converter, no star
                                arithmetic — and it already knows how to
                                stay honest at 0 and 100.
                            -->
                            <StackPanel Margin="0,0,0,14"
                                        Visibility="{Binding Preview.HasVolume, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Preview.VolumeLabel}"
                                           Style="{StaticResource PaneText}"
                                           FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Preview.VolumeDetail}"
                                           Style="{StaticResource PaneDim}"
                                           FontSize="11" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Height="12" Margin="0,8,0,0"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding Preview.VolumeUsedPercent, Mode=OneWay}"
                                             Foreground="{Binding Preview.VolumeBarColor}"
                                             Background="{StaticResource TrackBackground}" BorderBrush="{StaticResource TrackBorder}" BorderThickness="1"/>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Preview.VolumeUsage}"
                                               Style="{StaticResource PaneText}"
                                               FontSize="11"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding Preview.VolumeFree}"
                                               Style="{StaticResource PaneText}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="{Binding Preview.FolderTitle}"
                                       Style="{StaticResource PaneText}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Preview.FolderHeadline}"
                                       Style="{StaticResource PaneDim}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Preview.FolderNote}"
                                       Foreground="{StaticResource TextWarning}" FontSize="11"
                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Preview.HasFolderNote, Converter={StaticResource BoolToVisibility}}"/>

                            <!--
                                Walking a folder takes as long as it takes,
                                and the spinner for it goes where its
                                results will land — not over the whole
                                pane. The name of the folder and the
                                drive's capacity are already on screen
                                above, and a veil over them would hide what
                                the user has in order to announce what they
                                do not have yet. The caption under it says
                                which operation is still running.
                            -->
                            <StackPanel Margin="0,18,0,0"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding Preview.IsCensusLoading, Converter={StaticResource BoolToVisibility}}">
                                <Ellipse Width="20" Height="20" StrokeThickness="2"
                                         Stroke="{StaticResource AccentStroke}" Fill="Transparent"
                                         StrokeDashArray="3,2"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="CensusSpinnerRotate" Angle="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="CensusSpinnerRotate"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     From="0" To="360" Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="{x:Static res:Strings.PreviewCounting}"
                                           Style="{StaticResource PaneDim}"
                                           FontSize="11" Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!--
                                The heading and the "empty" line stand down
                                while the walk is running: both describe a
                                result that is not in yet, and "Папка пуста"
                                under a spinner is a wrong answer, not a
                                pending one.
                            -->
                            <TextBlock Text="{x:Static res:Strings.PreviewFolderTypes}"
                                       Style="{StaticResource PaneText}"
                                       FontWeight="SemiBold" Margin="0,16,0,6"
                                       Visibility="{Binding Preview.IsCensusLoading, Converter={StaticResource InverseBoolToVisibility}}"/>

                            <!-- Empty folder: say so instead of leaving a blank panel. -->
                            <TextBlock Text="{x:Static res:Strings.PreviewFolderEmpty}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PaneDim}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Preview.FolderTypes.Count}" Value="0"/>
                                                    <Condition Binding="{Binding Preview.IsCensusLoading}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding Preview.FolderTypes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Bars are scaled against the biggest bucket,
                                             not the total: with a long tail every bar
                                             would otherwise be a hairline. -->
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Extension}"
                                                       Style="{StaticResource PaneText}"
                                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Height="10" CornerRadius="2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Width="{Binding BarWidth}"
                                                    Background="{StaticResource AccentFill}" Opacity="0.5"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource PaneText}"/>
                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource PaneDim}" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Placeholder (None / Unsupported) -->
                    <TextBlock Text="{Binding Preview.PlaceholderText}"
                               Style="{StaticResource PaneDim}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding Preview.IsPlaceholderVisible, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Loading spinner — overlays content while content loads -->
                    <Grid Visibility="{Binding Preview.IsLoading, Converter={StaticResource BoolToVisibility}}"
                          Background="{StaticResource LoadingVeil}"
                          IsHitTestVisible="False">
                        <Ellipse Width="32" Height="32" StrokeThickness="3"
                                 Stroke="{StaticResource AccentStroke}" Fill="Transparent"
                                 StrokeDashArray="3,2"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                </Grid>

                <!-- Summary footer -->
                <Border Grid.Row="1"
                        BorderBrush="{StaticResource Separator}" BorderThickness="0,1,0,0"
                        Padding="8,6" Background="{StaticResource ChromeBackground}">
                    <StackPanel>
                        <!--
                            The file's details, and — for RAW — the switch
                            between its two pictures, right of the name.

                            RAW files carry the small JPEG the camera
                            embedded (instant, and what the pane shows by
                            default) and the sensor decode (the real frame,
                            about a second). The toggle stays on once
                            pressed, so a whole folder can be looked at that
                            way. It lives here with the rest of the file's
                            details rather than over the picture — nothing
                            should sit on top of what you came to look at —
                            and top-aligned, so it lands on the name line
                            however many lines of detail follow.
                        -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Preview.Summary}"
                                       FontSize="11" Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap"/>
                            <ToggleButton x:Name="RawToggle" Grid.Column="1"
                                          Content="{x:Static res:Strings.PreviewRawToggle}"
                                          VerticalAlignment="Top"
                                          Margin="8,0,0,0" Padding="8,1"
                                          MinWidth="44"
                                          FontSize="11"
                                          Focusable="False"
                                          ToolTip="{x:Static res:Strings.PreviewRawToggleHint}"
                                          IsChecked="{Binding Preview.ShowRawDecode, Mode=TwoWay}"
                                          Visibility="{Binding Preview.IsRawImage, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>

                        <!--
                            Shortcut row. What is drawn above belongs to the
                            file the .lnk points at, so the footer has to say
                            whose content that is — and, since the answer is
                            "somebody else's", offer the way over to it.
                        -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding Preview.HasLinkTarget, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static res:Strings.PreviewLinkTarget}"
                                       FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Preview.LinkTargetName}"
                                       FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                       Margin="4,0,0,0" MaxWidth="220"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Preview.LinkTarget}"/>
                            <Button Content="{x:Static res:Strings.PreviewGoToTarget}"
                                    Command="{Binding Preview.GoToLinkTargetCommand}"
                                    ToolTip="{x:Static res:Strings.PreviewGoToTargetHint}"
                                    Margin="8,0,0,0" Padding="6,0" FontSize="11"
                                    VerticalAlignment="Center"/>
                        </StackPanel>

                        <!--
                            Companion block: what the sidecars next to
                            this file have to say. Only the two formats
                            Wander understands so far get a rendering of
                            their own; the file list above them is shown
                            for any companion at all.
                        -->
                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding Preview.HasCompanions, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap">
                                <Run Text="{x:Static res:Strings.PreviewIntegrated}"/><Run Text=" "/><Run Text="{Binding Preview.CompanionFiles, Mode=OneWay}"/>
                            </TextBlock>

                            <!-- Unity .meta — the GUID, and a button to take it away -->
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                        Visibility="{Binding Preview.HasUnityGuid, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="GUID" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Preview.UnityGuid, Mode=OneWay}"
                                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                         FontFamily="Consolas" FontSize="11"
                                         BorderThickness="0" Background="Transparent"
                                         Margin="6,0,0,0" MinWidth="0" Padding="0"
                                         VerticalAlignment="Center"/>
                                <Button Content="{x:Static res:Strings.ActionCopy}" Command="{Binding Preview.CopyGuidCommand}"
                                        ToolTip="{x:Static res:Strings.PreviewCopyGuid}"
                                        Margin="4,0,0,0" Padding="4,0" FontSize="11"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Preview.UnityDetail}"
                                       FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!--
                            Rating and colour label, editable in place.

                            Deliberately *outside* the companion block. It
                            used to be inside it, which meant the stars only
                            appeared for a photograph that already had a
                            sidecar — and the everyday case is the opposite
                            one: a RAW straight off the card, with nothing
                            beside it, is exactly the file the first star
                            gets clicked on. PreviewController already
                            offers the row for such a file
                            (OfferRating → IsRatingUnsaved, which dims the
                            stars to say "there is nowhere to write this
                            yet"); the block above was hiding the offer.
                        -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding Preview.HasRating, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static res:Strings.PreviewRating}" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource RatingStar}" CommandParameter="1"
                                    Content="{Binding Preview.Rank, Converter={StaticResource RankStar}, ConverterParameter=1}"/>
                            <Button Style="{StaticResource RatingStar}" CommandParameter="2"
                                    Content="{Binding Preview.Rank, Converter={StaticResource RankStar}, ConverterParameter=2}"/>
                            <Button Style="{StaticResource RatingStar}" CommandParameter="3"
                                    Content="{Binding Preview.Rank, Converter={StaticResource RankStar}, ConverterParameter=3}"/>
                            <Button Style="{StaticResource RatingStar}" CommandParameter="4"
                                    Content="{Binding Preview.Rank, Converter={StaticResource RankStar}, ConverterParameter=4}"/>
                            <Button Style="{StaticResource RatingStar}" CommandParameter="5"
                                    Content="{Binding Preview.Rank, Converter={StaticResource RankStar}, ConverterParameter=5}"/>

                            <ItemsControl ItemsSource="{Binding Preview.ColorLabelChoices}"
                                          Margin="10,0,0,0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ColorLabelSwatch}"
                                                CommandParameter="{Binding Index}"
                                                ToolTip="{Binding Name}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding Preview.CustomColorLabel}"
                                       FontSize="11" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!--
                            What just happened to the sidecar ("created
                            IMG_0001.xmp"). Out of the companion block for
                            the same reason as the stars above it: the
                            message that matters most is the one about a
                            file that had no companions a moment ago.
                        -->
                        <TextBlock Text="{Binding Preview.CompanionStatus}"
                                   FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
</UserControl>
