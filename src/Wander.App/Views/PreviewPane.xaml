<UserControl x:Class="Wander.App.Views.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Wander.App.Converters"
             xmlns:controls="clr-namespace:Wander.App.Controls"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:res="clr-namespace:Wander.App.Resources"
             BorderBrush="{StaticResource Separator}" BorderThickness="1,0,0,0"
             Background="{StaticResource PreviewBackground}">
    <!--
        The preview pane: one content area that switches by
        PreviewController.Kind (image, animated GIF, video, text, code, web,
        folder statistics) plus the summary footer under it.

        It moved out of MainWindow with its code-behind because it is the
        second self-contained region of the window — image zoom, the video
        transport and the WebView2 handshake are three separate little state
        machines, and none of them has anything to say to the file list or
        the trees. The window keeps only the layout question ("is the pane
        visible, how wide"), because that is a property of the window's grid.

        The DataContext is the PreviewController itself, not the window's
        view model: every binding below is a property of the controller,
        and a second copy of this control with a second controller is the
        other half of a split pane.
    -->
    <UserControl.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
        <conv:BitmapPixelSizeConverter x:Key="BitmapPixelSize"/>
        <conv:RankStarConverter x:Key="RankStar"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!--
            The helpers' buttons (RAWHELPERS). Two letters said nothing to
            anyone but their author (2026-09-22), so each one draws what it
            does: everything in a circle of the same size, the marks in the
            colour they appear in over the picture.
        -->
        <DrawingImage x:Key="IconHelperFocus">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 L16,0 L16,16 L0,16 Z"/>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource IconRing}" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="8,8" RadiusX="7" RadiusY="7"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- The edge, and what peaking puts along it. -->
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource ReviewPeaking}" Thickness="1.6"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M4,11.5 L12,4.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource ReviewPeaking}">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <EllipseGeometry Center="4.5,7.5" RadiusX="1" RadiusY="1"/>
                                <EllipseGeometry Center="8.5,11.5" RadiusX="1" RadiusY="1"/>
                                <EllipseGeometry Center="11.5,8.5" RadiusX="1" RadiusY="1"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="IconHelperAf">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 L16,0 L16,16 L0,16 Z"/>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource IconRing}" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="8,8" RadiusX="7" RadiusY="7"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- The camera's focus frame. -->
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource ReviewAfFocused}" Thickness="1.6"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="4.5,4.5,7,7"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Sharpness: an edge that rises steeply - what the score measures. -->
        <DrawingImage x:Key="IconHelperSharp">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 L16,0 L16,16 L0,16 Z"/>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource IconRing}" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="8,8" RadiusX="7" RadiusY="7"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource ReviewSharp}" Thickness="1.6" LineJoin="Round"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M3.5,11.5 L8,4.5 L12.5,11.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Clipping: the range from black to white, with the two ends that are gone. -->
        <DrawingImage x:Key="IconHelperClip">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 L16,0 L16,16 L0,16 Z"/>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3D5AFE" Offset="0"/>
                                <GradientStop Color="#3D5AFE" Offset="0.16"/>
                                <GradientStop Color="#000000" Offset="0.2"/>
                                <GradientStop Color="#FFFFFF" Offset="0.8"/>
                                <GradientStop Color="#FF3B30" Offset="0.84"/>
                                <GradientStop Color="#FF3B30" Offset="1"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource IconRing}" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="8,8" RadiusX="7" RadiusY="7"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource IconRing}" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M8,1.2 L8,14.8"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- The chart itself, in miniature. -->
        <DrawingImage x:Key="IconHelperHistogram">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 L16,0 L16,16 L0,16 Z"/>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource IconRing}" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="8,8" RadiusX="7" RadiusY="7"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource ReviewSharp}"
                                     Geometry="M4,11 L5.2,11 L5.2,8.5 L4,8.5 Z
                                               M5.7,11 L6.9,11 L6.9,6 L5.7,6 Z
                                               M7.4,11 L8.6,11 L8.6,4.5 L7.4,4.5 Z
                                               M9.1,11 L10.3,11 L10.3,7 L9.1,7 Z
                                               M10.8,11 L12,11 L12,9.5 L10.8,9.5 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Shadows lifted: the same range with its dark end raised. -->
        <DrawingImage x:Key="IconHelperShadows">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 L16,0 L16,16 L0,16 Z"/>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#7A7A7A" Offset="0"/>
                                <GradientStop Color="#A6A6A6" Offset="0.45"/>
                                <GradientStop Color="#FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource IconRing}" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="8,8" RadiusX="7" RadiusY="7"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Highlights pulled down: the same range with its bright end lowered. -->
        <DrawingImage x:Key="IconHelperHighlights">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 L16,0 L16,16 L0,16 Z"/>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#000000" Offset="0"/>
                                <GradientStop Color="#5E5E5E" Offset="0.55"/>
                                <GradientStop Color="#9A9A9A" Offset="1"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource IconRing}" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="8,8" RadiusX="7" RadiusY="7"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!--
            A review helper's switch in the footer (RAWHELPERS): a picture of
            what it does, the words in the tooltip. Flat at rest, tinted while on - a
            helper left on changes what every picture looks like, and the
            footer is where to see why.
        -->
        <Style x:Key="HelperToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Height="18" CornerRadius="2"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                Padding="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ReviewToggleOn}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource OptionRingChecked}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Text drawn on the content surround, which is the gallery's
            background rather than a colour of our own. Two weights, both
            out of GalleryPalette: the caption colour and the quieter one.

            These exist because the surround stopped being an
            image-only affair. The folder census and the "nothing selected"
            line sit on it now, and near-black text on the dark surround is
            not text — the palette already computes a legible pair for
            whichever background is chosen, so the pane uses it instead of
            re-deciding.
        -->
        <!--
            `DataContext.` is not decoration. A RelativeSource binding
            resolves its path against the *element* it found, so without it
            the path is looked up on the UserControl itself, which has no
            such property — the binding then quietly yields nothing and the
            text keeps its inherited black. Which is invisible on the very
            background these styles exist for.
        -->
        <Style x:Key="PaneText" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{Binding DataContext.ContentPalette.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Style>

        <Style x:Key="PaneDim" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{Binding DataContext.ContentPalette.Dim, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Style>

        <!--
            One star of the .pp3 rating widget. Five copies of this in the
            footer, each with its own CommandParameter; clicking the star
            that already marks the rating clears it.
        -->
        <Style x:Key="RatingStar" TargetType="Button">
            <Setter Property="Command" Value="{Binding SetRankCommand}"/>
            <!-- A click leaves the keyboard where it was: a star with it
                 took the next Space for a second click. -->
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource RatingStar}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding RatingSource, StringFormat={x:Static res:Strings.PreviewRatingWrittenTo}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!--
                    A photo with no sidecar yet. The stars are live - the
                    first click creates the file, after asking - but they are
                    dimmed, because five hollow stars that mean "not rated"
                    and five that mean "there is nowhere to write a rating
                    yet" are not the same statement, and the difference is
                    exactly the one the click is about to resolve.
                -->
                <DataTrigger Binding="{Binding IsRatingUnsaved}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                    <Setter Property="ToolTip" Value="{x:Static res:Strings.PreviewRatingUnsaved}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            One colour-label swatch. The chosen one gets a ring rather than a
            different fill — the fill *is* the information, so it must not
            change to indicate selection.
        -->
        <Style x:Key="ColorLabelSwatch" TargetType="Button">
            <Setter Property="Command" Value="{Binding DataContext.SetColorLabelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="2">
                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource SwatchRing}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="{StaticResource ControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The find field's arrows and cross (B6): flat, as the glyphs in the toolbar's search box. -->
        <Style x:Key="FindGlyphButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            What the footer and the picture's bar (PLAN Q5) both carry, drawn
            once: the stars and the swatches, the helpers' switches, the
            chart of levels. Each is shown through a ContentPresenter whose
            content is the controller itself.
        -->
        <DataTemplate x:Key="RatingControls">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource RatingStar}" CommandParameter="1"
                        Content="{Binding Rank, Converter={StaticResource RankStar}, ConverterParameter=1}"/>
                <Button Style="{StaticResource RatingStar}" CommandParameter="2"
                        Content="{Binding Rank, Converter={StaticResource RankStar}, ConverterParameter=2}"/>
                <Button Style="{StaticResource RatingStar}" CommandParameter="3"
                        Content="{Binding Rank, Converter={StaticResource RankStar}, ConverterParameter=3}"/>
                <Button Style="{StaticResource RatingStar}" CommandParameter="4"
                        Content="{Binding Rank, Converter={StaticResource RankStar}, ConverterParameter=4}"/>
                <Button Style="{StaticResource RatingStar}" CommandParameter="5"
                        Content="{Binding Rank, Converter={StaticResource RankStar}, ConverterParameter=5}"/>

                <ItemsControl ItemsSource="{Binding ColorLabelChoices}"
                              Margin="10,0,0,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ColorLabelSwatch}"
                                    CommandParameter="{Binding Index}"
                                    ToolTip="{Binding Name}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!--
            The review helpers' switches (RAWHELPERS), only over a picture,
            and the RAW switch beside them: a RAW carries the small JPEG the
            camera embedded (instant, and what the pane shows by default)
            and the sensor decode (the real frame, about a second). The
            switch stays on once pressed, so a whole folder can be looked at
            that way.
        -->
        <DataTemplate x:Key="HelperSwitches">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                            Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Image}">
                    <ToggleButton Style="{StaticResource HelperToggle}"
                                  IsChecked="{Binding Helpers.Peaking}"
                                  ToolTip="{x:Static res:Strings.HelperFocusTip}">
                        <Image Source="{StaticResource IconHelperFocus}" Width="14" Height="14"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource HelperToggle}"
                                  IsChecked="{Binding Helpers.AfPoints}"
                                  ToolTip="{x:Static res:Strings.HelperAfTip}">
                        <Image Source="{StaticResource IconHelperAf}" Width="14" Height="14"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource HelperToggle}"
                                  IsChecked="{Binding Helpers.Sharpness}"
                                  ToolTip="{x:Static res:Strings.HelperSharpTip}">
                        <Image Source="{StaticResource IconHelperSharp}" Width="14" Height="14"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource HelperToggle}"
                                  IsChecked="{Binding Helpers.Clipping}"
                                  ToolTip="{x:Static res:Strings.HelperClipTip}">
                        <Image Source="{StaticResource IconHelperClip}" Width="14" Height="14"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource HelperToggle}"
                                  IsChecked="{Binding Helpers.Histogram}"
                                  ToolTip="{x:Static res:Strings.HelperHistTip}">
                        <Image Source="{StaticResource IconHelperHistogram}" Width="14" Height="14"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource HelperToggle}"
                                  IsChecked="{Binding Helpers.Shadows}"
                                  ToolTip="{x:Static res:Strings.HelperShadowsTip}">
                        <Image Source="{StaticResource IconHelperShadows}" Width="14" Height="14"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource HelperToggle}"
                                  IsChecked="{Binding Helpers.Highlights}"
                                  ToolTip="{x:Static res:Strings.HelperHighlightsTip}">
                        <Image Source="{StaticResource IconHelperHighlights}" Width="14" Height="14"/>
                    </ToggleButton>
                </StackPanel>
                <ToggleButton Content="{x:Static res:Strings.PreviewRawToggle}"
                              VerticalAlignment="Top"
                              Margin="8,0,0,0" Padding="8,1"
                              MinWidth="44"
                              FontSize="11"
                              Focusable="False"
                              ToolTip="{x:Static res:Strings.PreviewRawToggleHint}"
                              IsChecked="{Binding ShowRawDecode, Mode=TwoWay}"
                              Visibility="{Binding IsRawImage, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <!--
            Levels by channel. No words: a bright bar stands at the side that
            clipped - left for shadows crushed, right for highlights burnt -
            as tall as the share that went, full height at a twentieth of the
            frame. The shares themselves are in the tooltip.
        -->
        <DataTemplate x:Key="HistogramChart">
            <Border Padding="2,2" CornerRadius="2"
                    Background="{StaticResource ReviewChartPlate}"
                    ToolTip="{Binding HistogramTip}">
                <Grid Width="96" Height="56" ClipToBounds="True">
                    <Canvas>
                        <Polygon Points="{Binding HistogramRed}" Fill="{StaticResource ReviewChartRed}"/>
                        <Polygon Points="{Binding HistogramGreen}" Fill="{StaticResource ReviewChartGreen}"/>
                        <Polygon Points="{Binding HistogramBlue}" Fill="{StaticResource ReviewChartBlue}"/>
                    </Canvas>
                    <Rectangle Width="3" Height="{Binding HistogramUnderBar}"
                               Fill="{StaticResource ReviewChartUnder}"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                    <Rectangle Width="3" Height="{Binding HistogramOverBar}"
                               Fill="{StaticResource ReviewChartOver}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            The stars, the chart and the score are in the footer only while
            the picture has no bar of its own to carry them (ShowPictureBar):
            split, one footer under two pictures cannot say whose they are.
        -->
        <Style x:Key="FooterRating" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasRating}" Value="True"/>
                        <Condition Binding="{Binding ShowPictureBar}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterHistogram" TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasHistogram}" Value="True"/>
                        <Condition Binding="{Binding ShowPictureBar}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterSharpness" TargetType="Run">
            <Setter Property="Text" Value="{Binding SharpnessText, Mode=OneWay}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowPictureBar}" Value="True">
                    <Setter Property="Text" Value=""/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="SecondRow" Height="0"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="SecondColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Content area -->
                <Grid x:Name="ContentArea" Grid.Row="0" SizeChanged="ContentArea_SizeChanged"
                      ScrollViewer.ScrollChanged="ContentArea_ScrollChanged"
                      MouseMove="ContentArea_MouseMove" MouseLeave="ContentArea_MouseLeave">
                    <!--
                        The content surround, same palette as the gallery's.
                        A photograph judged against a grey wall and then
                        opened on a white pane is two different photographs
                        to the eye, so the two surfaces have to agree.

                        It is drawn for everything the pane renders itself:
                        pictures, the folder census, and the empty state.
                        Those last two were the odd ones out — walking off a
                        photograph onto a folder used to blink the pane from
                        the chosen surround to a hard-coded near-white and
                        back, which is the one thing a surround chosen to
                        stay out of the way must not do.

                        Text, code and documents keep their own background:
                        they are pages, they come with one, and a page on a
                        dark surround is a light rectangle with a border,
                        not a dark page.
                    -->
                    <Border Background="{Binding ContentPalette.Background}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Gif">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Audio">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Folder">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Archive">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Executable">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="None">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Unsupported">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <!--
                        Image preview. The fitted image stays in ImgFit; a
                        transparent canvas overlays it for the FastStone-style
                        "hold the left button to zoom 1:1" interaction. Everything is wired
                        in code-behind (ImageZoom_* handlers).
                    -->
                    <Grid x:Name="ImagePreviewHost"
                          Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Image}"
                          ClipToBounds="True"
                          Background="Transparent"
                          MouseEnter="ImageZoom_MouseEnter"
                          MouseLeave="ImageZoom_MouseLeave"
                          MouseMove="ImageZoom_MouseMove"
                          MouseLeftButtonDown="ImageZoom_LmbDown"
                          MouseLeftButtonUp="ImageZoom_LmbUp"
                          LostMouseCapture="ImageZoom_LostCapture">
                        <!--
                            Uniform both ways under a cap of the bitmap's
                            pixel size: the cap is what keeps a small
                            picture from being blown up. Not DownOnly -
                            that measures against the size the file's own
                            DPI gives, and a picture tagged 300 dpi came out
                            at a third of what fits (1200x800 in a 900-DIP
                            pane drawn 384x256, stand 2026-09-21).

                            The source is DisplayImage - the picture, or what
                            a review helper shows in its place (a tone curve,
                            the sharpness map) - and the cap is the picture's:
                            the helper's copy may be smaller than the frame.
                        -->
                        <Image x:Name="ImgFit"
                               Source="{Binding DisplayImage}"
                               Stretch="Uniform"
                               Margin="{Binding PictureMargin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               VerticalAlignment="Top" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SizeChanged="ImgFit_SizeChanged">
                            <Image.MaxWidth>
                                <MultiBinding Converter="{StaticResource BitmapPixelSize}" ConverterParameter="W">
                                    <Binding Path="ImageCapWidth"/>
                                    <Binding Path="DpiScale" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                </MultiBinding>
                            </Image.MaxWidth>
                            <Image.MaxHeight>
                                <MultiBinding Converter="{StaticResource BitmapPixelSize}" ConverterParameter="H">
                                    <Binding Path="ImageCapHeight"/>
                                    <Binding Path="DpiScale" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                </MultiBinding>
                            </Image.MaxHeight>
                        </Image>
                        <!--
                            Review helpers over the picture: sized to what
                            ImgFit came out at and placed the way it is, so
                            the marks lie on the pixels they are about at any
                            width of the pane. Peaking is measured on the
                            full frame and shrunk keeping every mark, so a
                            one-pixel edge stays visible at pane size.
                        -->
                        <Image x:Name="ImgOverlay"
                               Source="{Binding Overlay}"
                               IsHitTestVisible="False"
                               Stretch="Fill"
                               Width="{Binding ActualWidth, ElementName=ImgFit}"
                               Height="{Binding ActualHeight, ElementName=ImgFit}"
                               Margin="{Binding PictureMargin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               VerticalAlignment="Top" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <!--
                            The sensor decode of a RAW on its way (RAW switch
                            on): the quick preview is on screen, so the wait
                            is a small spinner in the corner rather than a
                            veil over the picture.
                        -->
                        <Ellipse Width="22" Height="22" StrokeThickness="3"
                                 Stroke="{StaticResource AccentStroke}" Fill="{StaticResource ReviewChartPlate}"
                                 StrokeDashArray="4,2"
                                 Margin="0,16,16,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 IsHitTestVisible="False"
                                 RenderTransformOrigin="0.5,0.5"
                                 Visibility="{Binding IsRawDecoding, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="RawSpinnerRotate" Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="RawSpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <!-- Zoom view: visible only while the user holds the left button. -->
                        <Canvas x:Name="ImgZoomCanvas"
                                Background="{Binding ContentPalette.Background}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <!-- Drawn at exactly one image pixel per device pixel
                                 (BeginImageZoom); nearest neighbour keeps a leftover
                                 fraction of a pixel from resampling the picture. -->
                            <Image x:Name="ImgZoom"
                                   Source="{Binding ZoomDisplay}"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <!-- The helpers at the zoom's resolution; sized and placed with ImgZoom (UpdateZoomPosition). -->
                            <Image x:Name="ImgZoomOverlay"
                                   Source="{Binding ZoomOverlay}"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Canvas>
                    </Grid>

                    <!-- Animated GIF (also anchored middle-top with same margin). -->
                    <controls:GifImage x:Name="GifPreview"
                                       GifUri="{Binding GifUri}"
                                       Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Gif}"
                                       Stretch="Uniform"
                                       Margin="{Binding PictureMargin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       VerticalAlignment="Top" HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                        <controls:GifImage.MaxWidth>
                            <MultiBinding Converter="{StaticResource BitmapPixelSize}" ConverterParameter="W">
                                <Binding Path="Source" RelativeSource="{RelativeSource Self}"/>
                                <Binding Path="DpiScale" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </MultiBinding>
                        </controls:GifImage.MaxWidth>
                        <controls:GifImage.MaxHeight>
                            <MultiBinding Converter="{StaticResource BitmapPixelSize}" ConverterParameter="H">
                                <Binding Path="Source" RelativeSource="{RelativeSource Self}"/>
                                <Binding Path="DpiScale" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </MultiBinding>
                        </controls:GifImage.MaxHeight>
                    </controls:GifImage>

                    <!--
                        Video and audio: one MediaElement, one transport.

                        Music is a video with nothing to draw — Media
                        Foundation reads MP3 and FLAC on Windows 10 and
                        later without anything installed — so the play
                        button, the clock and the seek bar are the ones
                        already debugged for video rather than a second
                        copy of the same little state machine. What differs
                        is only what fills the space above them: the
                        picture for a clip, the track's own card for a
                        song.
                    -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Video">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Audio">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!--
                            Video only. Audio is played by a MediaPlayer in
                            the code-behind instead, because a MediaElement
                            that is not drawn does not play: with nothing to
                            render it measures to nothing, and a
                            MediaElement with no rendered area opens the
                            file, reports its duration, accepts Play() — and
                            leaves Position at zero for ever. Measured: the
                            same file in an element sized 200x120 plays, at
                            1x1 it is silent.

                            Source is assigned in code rather than bound,
                            so that an audio file does not get opened twice
                            (once here and once by the player that will
                            actually play it).
                        -->
                        <MediaElement x:Name="VideoPreview"
                                      Grid.Row="0"
                                      Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Video}"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      ScrubbingEnabled="True"
                                      Stretch="Uniform" StretchDirection="DownOnly"
                                      Margin="8,12,8,4"
                                      VerticalAlignment="Top" HorizontalAlignment="Center"
                                      MediaOpened="VideoPreview_MediaOpened"
                                      MediaEnded="VideoPreview_MediaEnded"
                                      MediaFailed="VideoPreview_MediaFailed"/>
                        <!--
                            The last frame, held while a clip is reopened
                            (PreviewPane.HoldLastFrame). A file that declares
                            no length can only be started over by closing
                            and opening it again, and between the two the
                            element has nothing to draw: it collapsed to
                            nothing, then showed black until the first frame
                            arrived - once per loop on a short clip. This
                            sits over it with a snapshot of the frame it was
                            showing until the position moves again. Same
                            margin and alignment as the element under it, so
                            the snapshot lands where the picture was.
                        -->
                        <Image x:Name="VideoHold"
                               Grid.Row="0"
                               Margin="8,12,8,4"
                               VerticalAlignment="Top" HorizontalAlignment="Center"
                               Stretch="Fill"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"/>

                        <!--
                            The track's card. The cover gets the room it can
                            have and no more: a sleeve is square, a pane is
                            not, and a 1500-px scan blown up to fill the
                            height would push the name off the bottom.
                        -->
                        <StackPanel Grid.Row="0"
                                    Margin="16,20,16,8"
                                    VerticalAlignment="Top" HorizontalAlignment="Center"
                                    Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Audio}">
                            <Border MaxWidth="260" MaxHeight="260"
                                    HorizontalAlignment="Center"
                                    BorderBrush="{Binding ContentPalette.Dim}" BorderThickness="1"
                                    Visibility="{Binding HasAudioCover, Converter={StaticResource BoolToVisibility}}">
                                <!-- Capped at its pixel size rather than DownOnly - see ImgFit. -->
                                <Image Source="{Binding AudioCover}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.MaxWidth>
                                        <MultiBinding Converter="{StaticResource BitmapPixelSize}" ConverterParameter="W">
                                            <Binding Path="Source" RelativeSource="{RelativeSource Self}"/>
                                            <Binding Path="DpiScale" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Image.MaxWidth>
                                    <Image.MaxHeight>
                                        <MultiBinding Converter="{StaticResource BitmapPixelSize}" ConverterParameter="H">
                                            <Binding Path="Source" RelativeSource="{RelativeSource Self}"/>
                                            <Binding Path="DpiScale" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Image.MaxHeight>
                                </Image>
                            </Border>

                            <TextBlock Text="{Binding AudioTitle}"
                                       Style="{StaticResource PaneText}"
                                       Margin="0,12,0,0"
                                       FontSize="15" FontWeight="SemiBold"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="320"/>
                            <TextBlock Text="{Binding AudioArtist}"
                                       Style="{StaticResource PaneText}"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="320"
                                       Visibility="{Binding HasAudioArtist, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding AudioAlbum}"
                                       Style="{StaticResource PaneDim}"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="320"
                                       Visibility="{Binding HasAudioAlbum, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding AudioDetail}"
                                       Style="{StaticResource PaneDim}"
                                       Margin="0,8,0,0"
                                       FontSize="11"
                                       TextAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="8,4,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="VideoPlayPauseButton"
                                    Content="▶" Width="32" Padding="0,2"
                                    Grid.Column="0"
                                    Click="VideoPlayPause_Click"
                                    ToolTip="{x:Static res:Strings.PreviewPlayPause}"/>
                            <!--
                                Repeat. Pressed by itself for anything
                                shorter than three seconds: a two-second
                                clip played once is a flicker, and the only
                                way to see what is in it is to watch it go
                                round. Longer clips start with it off -
                                looping a film is not what "preview" means.
                            -->
                            <ToggleButton x:Name="VideoLoopButton"
                                          Content="⟳" Width="32" Padding="0,2"
                                          Grid.Column="1" Margin="4,0,0,0"
                                          ToolTip="{x:Static res:Strings.PreviewRepeat}"/>
                            <!--
                                Palette-coloured because for a track the
                                transport stands on the surround, and on the
                                dark one a default-black clock is a clock
                                nobody can read. For a clip the surround is
                                not drawn and the palette is the plain one,
                                so this is the same near-black it was.
                            -->
                            <TextBlock x:Name="VideoTimeText"
                                       Style="{StaticResource PaneText}"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Margin="8,0"
                                       FontFamily="Consolas" FontSize="11"
                                       Text="0:00 / 0:00"/>
                            <Slider x:Name="VideoSlider"
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Minimum="0" Maximum="1"
                                    SmallChange="0.5" LargeChange="5"
                                    IsMoveToPointEnabled="True"
                                    PreviewMouseLeftButtonDown="VideoSlider_PreviewMouseDown"
                                    PreviewMouseLeftButtonUp="VideoSlider_PreviewMouseUp"
                                    ValueChanged="VideoSlider_ValueChanged"/>
                        </Grid>
                    </Grid>

                    <!--
                        3D model. A plain WPF Viewport3D — the format
                        readers live in Core and hand over geometry, and
                        drawing a shaded solid is something WPF has done
                        since it shipped, so no library is involved on
                        either side.

                        The camera is placed in code-behind: where it
                        belongs depends on how big the model is, and that
                        is not known until the file has been read. Orbit is
                        left-drag, zoom is the wheel — the two gestures a
                        viewer has to have, and no more, because this is a
                        preview and not a viewport.
                    -->
                    <Grid Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Model}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{Binding ContentPalette.Background}"
                                ClipToBounds="True"
                                MouseLeftButtonDown="Model_MouseDown"
                                MouseLeftButtonUp="Model_MouseUp"
                                MouseMove="Model_MouseMove"
                                MouseWheel="Model_MouseWheel">
                            <Viewport3D x:Name="ModelViewport" ClipToBounds="True"
                                        SizeChanged="Model_SizeChanged">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera x:Name="ModelCamera" FieldOfView="45"/>
                                </Viewport3D.Camera>
                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <Model3DGroup>
                                            <!--
                                                One directional light plus a
                                                dim ambient one: a single
                                                light leaves everything
                                                facing away from it pure
                                                black, which on an
                                                untextured solid reads as a
                                                hole in the model.
                                            -->
                                            <AmbientLight Color="{StaticResource ModelAmbientLight}"/>
                                            <DirectionalLight x:Name="ModelKeyLight" Color="{StaticResource ModelKeyLight}" Direction="-0.5,-1,-1"/>
                                            <DirectionalLight Color="{StaticResource ModelFillLight}" Direction="1,0.5,0.8"/>
                                            <!--
                                                The model's drawables, filled
                                                from code-behind: how many
                                                there are and what colour
                                                each one is depends on the
                                                file's materials, which XAML
                                                cannot know. The rotation
                                                sits on the group so every
                                                part turns together.
                                            -->
                                            <Model3DGroup x:Name="ModelParts">
                                                <Model3DGroup.Transform>
                                                    <Transform3DGroup>
                                                        <RotateTransform3D>
                                                            <RotateTransform3D.Rotation>
                                                                <AxisAngleRotation3D x:Name="ModelSpin" Axis="0,1,0" Angle="0"/>
                                                            </RotateTransform3D.Rotation>
                                                        </RotateTransform3D>
                                                        <RotateTransform3D>
                                                            <RotateTransform3D.Rotation>
                                                                <AxisAngleRotation3D x:Name="ModelTilt" Axis="1,0,0" Angle="0"/>
                                                            </RotateTransform3D.Rotation>
                                                        </RotateTransform3D>
                                                    </Transform3DGroup>
                                                </Model3DGroup.Transform>
                                            </Model3DGroup>
                                        </Model3DGroup>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                            </Viewport3D>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding ModelDetail}"
                                   Margin="8,4,8,6"
                                   FontSize="11" Foreground="{StaticResource TextDim}"
                                   HorizontalAlignment="Center"/>
                    </Grid>

                    <!--
                        Plain text. The selection shows without the keyboard:
                        a match the find field went to (B6) is highlighted
                        while the keyboard stays in the list.
                    -->
                    <TextBox x:Name="PlainText"
                             Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Text}"
                             Text="{Binding Text, Mode=OneWay}"
                             IsInactiveSelectionHighlightEnabled="True"
                             IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11"
                             Background="Transparent" BorderThickness="0"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="6"/>

                    <!-- Code with syntax highlighting -->
                    <ae:TextEditor x:Name="CodeEditor"
                                   Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Code}"
                                   IsReadOnly="True"
                                   ShowLineNumbers="True"
                                   FontFamily="Consolas" FontSize="11"
                                   Background="Transparent"
                                   Padding="4"/>

                    <!--
                        Rich text (.rtf). WPF reads the format itself, so
                        this is a real document rather than a text dump —
                        fonts, tables and images intact. Read-only, and
                        loaded in code-behind because TextRange.Load is the
                        only way in and it is not a bindable property.
                    -->
                    <RichTextBox x:Name="DocumentPreview"
                                 Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Document}"
                                 IsReadOnly="True" IsDocumentEnabled="True"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 Background="{StaticResource InputBackground}" BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Padding="6"/>

                    <!--
                        PDF / HTML / MHTML / Markdown / FB2 via WebView2.
                        DefaultBackgroundColor is the only colour in the app
                        outside Resources/Palette.xaml: it is a
                        System.Drawing colour on a native control and takes
                        no brush resource. It is also the paper a document
                        is drawn on rather than window chrome.
                    -->
                    <wv2:WebView2 x:Name="WebPreview"
                                  Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Web}"
                                  DefaultBackgroundColor="White"/>

                    <!--
                        Folder census (B2). Shown when the selection is a
                        folder, or when nothing is selected: "what is in
                        here and what is eating the space" is the question
                        a folder raises, and a wall of thumbnails does not
                        answer it.
                    -->
                    <ScrollViewer Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Folder}"
                                  VerticalScrollBarVisibility="Auto" Padding="12,10,12,10">
                        <StackPanel>
                            <!--
                                Drive header. Only appears at the root of a
                                volume: "how full is it" is a question about
                                a disk, and printing capacity above the
                                census of an ordinary folder would be
                                answering about the disk while showing
                                numbers about the folder.

                                The bar is a ProgressBar rather than two
                                nested Borders because a percentage maps
                                onto it directly — no converter, no star
                                arithmetic — and it already knows how to
                                stay honest at 0 and 100.
                            -->
                            <StackPanel Margin="0,0,0,14"
                                        Visibility="{Binding HasVolume, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding VolumeLabel}"
                                           Style="{StaticResource PaneText}"
                                           FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding VolumeDetail}"
                                           Style="{StaticResource PaneDim}"
                                           FontSize="11" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Height="12" Margin="0,8,0,0"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding VolumeUsedPercent, Mode=OneWay}"
                                             Foreground="{Binding VolumeBarColor}"
                                             Background="{StaticResource TrackBackground}" BorderBrush="{StaticResource TrackBorder}" BorderThickness="1"/>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="{Binding VolumeUsage}"
                                               Style="{StaticResource PaneText}"
                                               FontSize="11"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding VolumeFree}"
                                               Style="{StaticResource PaneText}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="{Binding FolderTitle}"
                                       Style="{StaticResource PaneText}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FolderHeadline}"
                                       Style="{StaticResource PaneDim}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding FolderNote}"
                                       Foreground="{StaticResource TextWarning}" FontSize="11"
                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasFolderNote, Converter={StaticResource BoolToVisibility}}"/>

                            <!--
                                Walking a folder takes as long as it takes,
                                and the spinner for it goes where its
                                results will land — not over the whole
                                pane. The name of the folder and the
                                drive's capacity are already on screen
                                above, and a veil over them would hide what
                                the user has in order to announce what they
                                do not have yet. The caption under it says
                                which operation is still running.
                            -->
                            <StackPanel Margin="0,18,0,0"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding IsCensusLoading, Converter={StaticResource BoolToVisibility}}">
                                <Ellipse Width="20" Height="20" StrokeThickness="2"
                                         Stroke="{StaticResource AccentStroke}" Fill="Transparent"
                                         StrokeDashArray="3,2"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="CensusSpinnerRotate" Angle="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="CensusSpinnerRotate"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     From="0" To="360" Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="{x:Static res:Strings.PreviewCounting}"
                                           Style="{StaticResource PaneDim}"
                                           FontSize="11" Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!--
                                The heading and the "empty" line stand down
                                while the walk is running: both describe a
                                result that is not in yet, and "Папка пуста"
                                under a spinner is a wrong answer, not a
                                pending one.
                            -->
                            <TextBlock Text="{x:Static res:Strings.PreviewFolderTypes}"
                                       Style="{StaticResource PaneText}"
                                       FontWeight="SemiBold" Margin="0,16,0,6"
                                       Visibility="{Binding IsCensusLoading, Converter={StaticResource InverseBoolToVisibility}}"/>

                            <!-- Empty folder: say so instead of leaving a blank panel. -->
                            <TextBlock Text="{x:Static res:Strings.PreviewFolderEmpty}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PaneDim}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding FolderTypes.Count}" Value="0"/>
                                                    <Condition Binding="{Binding IsCensusLoading}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding FolderTypes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Bars are scaled against the biggest bucket,
                                             not the total: with a long tail every bar
                                             would otherwise be a hairline. -->
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Extension}"
                                                       Style="{StaticResource PaneText}"
                                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Height="10" CornerRadius="2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Width="{Binding BarWidth}"
                                                    Background="{StaticResource AccentFill}" Opacity="0.5"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource PaneText}"/>
                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource PaneDim}" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!--
                        Archive listing (P5). An archive file selected in an
                        ordinary folder: what is in its first level. The
                        census above cannot answer that - it walks the
                        filesystem, and there is no filesystem in a zip - so
                        this is a plain list of names, in the census's
                        clothes so the two read as one panel.
                    -->
                    <ScrollViewer Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Archive}"
                                  VerticalScrollBarVisibility="Auto" Padding="12,10,12,10">
                        <StackPanel>
                            <TextBlock Text="{Binding FolderTitle}"
                                       Style="{StaticResource PaneText}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ArchiveHeadline}"
                                       Style="{StaticResource PaneDim}"
                                       Margin="0,4,0,10" TextWrapping="Wrap"/>

                            <ItemsControl ItemsSource="{Binding ArchiveEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding Icon}"
                                                   Width="16" Height="16" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       Style="{StaticResource PaneText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                       Style="{StaticResource PaneDim}"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding ArchiveMore}"
                                       Style="{StaticResource PaneDim}"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasArchiveMore, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!--
                        A program or a library (B7): its icon, what it calls
                        itself, and the facts it carries - in the census's
                        clothes, as the archive listing is.
                    -->
                    <ScrollViewer Visibility="{Binding Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Executable}"
                                  VerticalScrollBarVisibility="Auto" Padding="12,10,12,10">
                        <StackPanel>
                            <Image Source="{Binding ExecutableIcon}"
                                   Width="64" Height="64" HorizontalAlignment="Left"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding ExecutableTitle}"
                                       Style="{StaticResource PaneText}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Margin="0,8,0,10" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding ExecutableFacts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="84"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       Style="{StaticResource PaneDim}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       Style="{StaticResource PaneText}"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!--
                        The picture's own bar (PLAN Q5, 2026-09-24): full
                        screen, and each half of a split, where one footer
                        cannot speak for two pictures. In the lower left
                        corner, on a thin dark plate; the stars, the score
                        and the switches stand at 30% of their strength
                        until the mouse comes down to them or the rating
                        changes (PreviewPane, "The picture's bar"). The
                        chart of levels beside them is at full strength: it
                        was switched on to be read, and a fifth of it is
                        not a chart.
                    -->
                    <StackPanel x:Name="PictureBar" Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,8,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ShowPictureBar}" Value="True"/>
                                            <Condition Binding="{Binding Kind}" Value="Image"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ShowPictureBar}" Value="True"/>
                                            <Condition Binding="{Binding Kind}" Value="Gif"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border x:Name="PictureControls" VerticalAlignment="Bottom"
                                Background="{StaticResource PictureBarPlate}" CornerRadius="3" Padding="6,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRating}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PictureBarSwitches}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasSharpnessScore}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RatingControls}"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding HasRating, Converter={StaticResource BoolToVisibility}}"/>
                                <!-- The sharpness score beside the stars: a fact about this picture, as quiet as they are. -->
                                <TextBlock Text="{Binding SharpnessText}" ToolTip="{Binding SharpnessTip}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource ReviewSharp}"
                                           Visibility="{Binding HasSharpnessScore, Converter={StaticResource BoolToVisibility}}"/>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HelperSwitches}"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding PictureBarSwitches, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Bottom"
                                          Content="{Binding}" ContentTemplate="{StaticResource HistogramChart}"
                                          Visibility="{Binding HasHistogram, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <!-- Placeholder (None / Unsupported) -->
                    <TextBlock Text="{Binding PlaceholderText}"
                               Style="{StaticResource PaneDim}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Margin="16,0"
                               Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Loading spinner — overlays content while content loads -->
                    <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                          Background="{StaticResource LoadingVeil}"
                          IsHitTestVisible="False">
                        <Ellipse Width="32" Height="32" StrokeThickness="3"
                                 Stroke="{StaticResource AccentStroke}" Fill="Transparent"
                                 StrokeDashArray="3,2"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>

                    <!--
                        Find in the text on show (B6): Ctrl+F with the
                        keyboard in the pane, or opened by a result of a
                        search inside files. Top right, over the text, as a
                        browser's; the web view keeps its own.
                    -->
                    <Border x:Name="FindBar" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,20,0"
                            Background="{StaticResource InputBackground}"
                            BorderBrush="{StaticResource Separator}" BorderThickness="1" CornerRadius="3"
                            Padding="4,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="FindBox" Width="160" BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="{x:Static res:Strings.PreviewFindBox}"
                                     TextChanged="FindBox_TextChanged"
                                     PreviewKeyDown="FindBox_PreviewKeyDown"/>
                            <TextBlock x:Name="FindCount" Foreground="{StaticResource TextDim}" FontSize="11"
                                       VerticalAlignment="Center" Margin="6,0,4,0"/>
                            <Button Style="{StaticResource FindGlyphButton}" Content="&#xE70E;"
                                    ToolTip="{x:Static res:Strings.PreviewFindPrevious}" Click="FindPrevious_Click"/>
                            <Button Style="{StaticResource FindGlyphButton}" Content="&#xE70D;"
                                    ToolTip="{x:Static res:Strings.PreviewFindNext}" Click="FindNext_Click"/>
                            <Button Style="{StaticResource FindGlyphButton}" Content="&#xE711;"
                                    ToolTip="{x:Static res:Strings.PreviewFindClose}" Click="FindClose_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--
                    The other half of a split: under the content or beside
                    it, and above the footer, which the pair shares (see
                    ShowSecond).
                -->
                <ContentControl x:Name="SecondSlot" Visibility="Collapsed"/>

                <!-- Summary footer; absent on the second half of a split (ShowFooter) -->
                <Border Grid.Row="2" Grid.ColumnSpan="2"
                        BorderBrush="{StaticResource Separator}" BorderThickness="0,1,0,0"
                        Padding="8,6" Background="{StaticResource ChromeBackground}"
                        Visibility="{Binding ShowFooter, Converter={StaticResource BoolToVisibility}}">
                    <!--
                        The file's details on the left, the review helpers'
                        switches and their chart on the right (RAWHELPERS).
                        Two columns rather than a row inside the first line:
                        the chart is taller than that line, and inside it it
                        pushed the stars down the footer for nothing - beside
                        them there is room to spare (2026-09-22).
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                        <!--
                            The name, the dim mention of its sidecars -
                            "(+.xmp)" - and the lines of facts under it, the
                            sharpness score after the last of them. One
                            TextBlock, so they wrap as one text.
                        -->
                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap">
                            <Run Text="{Binding SummaryHead, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding SummaryNote, Mode=OneWay}" Foreground="{StaticResource TextDim}"/><Run Text="{Binding SummaryRest, Mode=OneWay}"/><Run Text="   "/><Run Style="{StaticResource FooterSharpness}" Foreground="{StaticResource ReviewSharp}" FontWeight="SemiBold" ToolTip="{Binding SharpnessTip}"/>
                        </TextBlock>

                        <!--
                            An operation of the user's has this file: running
                            on it now, or holding it for its turn (PLAN AF,
                            block 0, step 6). The same news as the mark on
                            the row's icon, in words.
                        -->
                        <TextBlock Text="{Binding WorkLine}"
                                   FontSize="11" Foreground="{StaticResource WorkBadgeGlyph}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasWorkLine, Converter={StaticResource BoolToVisibility}}"/>

                        <!--
                            Shortcut row. What is drawn above belongs to the
                            file the .lnk points at, so the footer has to say
                            whose content that is — and, since the answer is
                            "somebody else's", offer the way over to it.
                        -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding HasLinkTarget, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static res:Strings.PreviewLinkTarget}"
                                       FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LinkTargetName}"
                                       FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                       Margin="4,0,0,0" MaxWidth="220"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding LinkTarget}"/>
                            <Button Content="{x:Static res:Strings.PreviewGoToTarget}"
                                    Command="{Binding GoToLinkTargetCommand}"
                                    ToolTip="{x:Static res:Strings.PreviewGoToTargetHint}"
                                    Margin="8,0,0,0" Padding="6,0" FontSize="11"
                                    VerticalAlignment="Center"/>
                        </StackPanel>

                        <!--
                            Unity .meta: the one sidecar with rows of its own.
                            Every other one is the dim "(+.xmp)" beside the
                            name and nothing here - a line naming them made
                            the footer of a file with a sidecar taller than
                            its neighbour's.
                        -->
                        <StackPanel Margin="0,6,0,0"
                                    Visibility="{Binding HasUnityMeta, Converter={StaticResource BoolToVisibility}}">
                            <!-- Unity .meta — the GUID, and a button to take it away -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasUnityGuid, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="GUID" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding UnityGuid, Mode=OneWay}"
                                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                         FontFamily="Consolas" FontSize="11"
                                         BorderThickness="0" Background="Transparent"
                                         Margin="6,0,0,0" MinWidth="0" Padding="0"
                                         VerticalAlignment="Center"/>
                                <Button Content="{x:Static res:Strings.ActionCopy}" Command="{Binding CopyGuidCommand}"
                                        ToolTip="{x:Static res:Strings.PreviewCopyGuid}"
                                        Margin="4,0,0,0" Padding="4,0" FontSize="11"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding UnityDetail}"
                                       FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!--
                            Rating and colour label, editable in place.

                            Deliberately *outside* the companion block. It
                            used to be inside it, which meant the stars only
                            appeared for a photograph that already had a
                            sidecar — and the everyday case is the opposite
                            one: a RAW straight off the card, with nothing
                            beside it, is exactly the file the first star
                            gets clicked on. PreviewController already
                            offers the row for such a file
                            (OfferRating → IsRatingUnsaved, which dims the
                            stars to say "there is nowhere to write this
                            yet"); the block above was hiding the offer.
                        -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Style="{StaticResource FooterRating}">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RatingControls}"/>

                            <TextBlock Text="{Binding CustomColorLabel}"
                                       FontSize="11" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>

                            <!--
                                Several files selected: the stars and the
                                swatches show the one on screen, but a click
                                writes to all of them - and the click must
                                not be the first the user hears of it.
                            -->
                            <TextBlock Text="{Binding RatingOthers}"
                                       ToolTip="{Binding RatingOthersHint}"
                                       FontSize="11" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Visibility="{Binding HasRatingOthers, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <!--
                            What just happened to the sidecar ("created
                            IMG_0001.xmp"). Out of the companion block for
                            the same reason as the stars above it: the
                            message that matters most is the one about a
                            file that had no companions a moment ago.
                        -->
                        <TextBlock Text="{Binding CompanionStatus}"
                                   FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- The helpers' switches and the chart (HelperSwitches, HistogramChart). -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HelperSwitches}"/>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HistogramChart}"
                                                  Margin="8,4,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                  Style="{StaticResource FooterHistogram}"/>
                            </StackPanel>
                    </Grid>
                </Border>
            </Grid>
</UserControl>
