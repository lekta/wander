<Window x:Class="Wander.App.Views.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Wander.App.Resources"
        Title="{Binding ElementName=Root, Path=DialogTitle}"
        x:Name="Root"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="OnClosing">
    <Border Padding="20">
        <StackPanel>
            <!--
                Headline: the verb passed in by the caller ("Copying",
                "Moving", "Deleting"). We deliberately don't show the source
                paths here — there can be thousands; the per-file path
                streams into CurrentPathText below as the op progresses.
            -->
            <TextBlock Text="{Binding ElementName=Root, Path=Headline}"
                       FontSize="14" FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="{Binding ElementName=Root, Path=CurrentPath}"
                       Foreground="{StaticResource TextCaption}" FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,8"/>

            <ProgressBar Height="14"
                         Minimum="0" Maximum="100"
                         Value="{Binding ElementName=Root, Path=Percent, Mode=OneWay}"/>

            <TextBlock Text="{Binding ElementName=Root, Path=CounterText}"
                       Foreground="{StaticResource TextDim}" FontSize="11"
                       HorizontalAlignment="Right"
                       Margin="0,4,0,12"/>

            <Button x:Name="CancelButton"
                    Content="{x:Static res:Strings.ActionCancel}"
                    Width="100" Padding="6,3"
                    HorizontalAlignment="Right"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Border>
</Window>
