<UserControl x:Class="Wander.App.Views.FolderTreesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Wander.App.Converters"
             xmlns:controls="clr-namespace:Wander.App.Controls"
             xmlns:res="clr-namespace:Wander.App.Resources">
    <!--
        The two folder panels: bookmarks on top, the drives below, a
        draggable divider between them.

        Each panel is a plain list of the lines the model says are shown
        (decision P3, REDESIGN 4.7): the indent is the line's depth, the
        tree is only in what the list is made from. What is lit, open, the
        open folder's place and what a menu is about are flags on the line,
        bound one way; clicks and keys go to the model as events
        (code-behind). MainWindow keeps what surrounds the pane and answers
        what this control cannot finish on its own: the context menu, the
        keyboard going back to the list, and running a drop through the view
        model.
    -->
    <UserControl.Resources>
        <conv:TreeIndentConverter x:Key="TreeIndent"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!--
            One line of either panel. The highlight spans the whole line,
            the way Explorer draws it, and only the content is indented.
            Colours are Explorer's: #E5F3FB on hover, #CCE8FF lit in the
            panel with the keyboard, #E8E8E8 lit in the other one. The
            chevron is not a button: a click on it is an event for the
            model (FolderTreesView), and a button would keep its own state.
            Hidden folders fade to 0.55, as in the file list.
        -->
        <Style x:Key="PanelLine" TargetType="controls:FolderPanelItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <!-- A line taking the keyboard scrolls the panel up and down to
                 it, not sideways to the end of a long name, unless the
                 setting asks for that: Line_RequestBringIntoView. -->
            <EventSetter Event="FrameworkElement.RequestBringIntoView" Handler="Line_RequestBringIntoView"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:FolderPanelItem">
                        <StackPanel>
                            <!--
                                The thin rule between the special folders
                                and the user's own bookmarks, above the line
                                so it spans the panel's full width. Inert in
                                the drives: no row there sets the flag.
                            -->
                            <Border x:Name="SectionRule"
                                    Height="1"
                                    Margin="4,2,4,2"
                                    Background="{StaticResource SectionRule}"
                                    Visibility="Collapsed"/>
                            <Border x:Name="Row"
                                    Background="Transparent"
                                    MinHeight="22"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid Margin="{Binding Depth, Converter={StaticResource TreeIndent}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Chevron"
                                                Grid.Column="0"
                                                Width="16" Height="16"
                                                Background="Transparent"
                                                Visibility="Hidden">
                                            <Path x:Name="Arrow"
                                                  Data="M 0,0 L 5,4.5 L 0,9 Z"
                                                  Fill="{StaticResource TreeChevron}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!--
                                            Alignment comes from the item style,
                                            not baked in: the drives keep their
                                            lines only as wide as their names
                                            (so long paths scroll sideways),
                                            while the bookmarks stretch them so
                                            the "..." menu can sit at the right
                                            edge.
                                        -->
                                        <ContentPresenter Grid.Column="1"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center"/>
                                    </Grid>
                                    <!--
                                        What a context menu is open for
                                        (decision B4): the caret's frame,
                                        drawn over the line without taking
                                        room, the highlight staying where it
                                        was.
                                    -->
                                    <Border x:Name="MenuFrame"
                                            BorderThickness="1"
                                            BorderBrush="Transparent"
                                            IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasChevron}" Value="True">
                                <Setter TargetName="Chevron" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 9,0 L 4.5,5 Z"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource TreeChevronExpanded}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" SourceName="Chevron" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource TreeChevronHover}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" SourceName="Row" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHover}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCaret}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource RowSelectedInactive}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource RowSelected}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StartsUserSection}" Value="True">
                                <Setter TargetName="SectionRule" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMenuSubject}" Value="True">
                                <Setter TargetName="MenuFrame" Property="BorderBrush" Value="{StaticResource RowCaretBorder}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            The name of a line. The open folder's place is drawn bold - "where
            I am", when the cursor has moved off it (decision B24). A bookmark
            whose folder is gone stays in the list, greyed and italic:
            removing the row would look like Wander lost the bookmark; the
            user is the one who decides whether it goes.
        -->
        <Style x:Key="PanelLineName" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocation}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The panel itself: no chrome of its own but the frame the focus outline paints. -->
        <Style x:Key="PanelList" TargetType="controls:FolderPanelList">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        </Style>

        <!--
            Right-click on the empty part of a navigation panel. Not the file
            menu — nothing was clicked — but the handful of settings that get
            flipped often enough that walking to Параметры for them is the
            annoying part: what the listing shows, whether the arrow keys
            open folders, whether deleting asks first.

            One instance shared by both panels. A ContextMenu is not in the
            visual tree, so its DataContext does not inherit; PlacementTarget
            is how it reaches the window's own.
        -->
        <ContextMenu x:Key="PanelSettingsMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{x:Static res:Strings.PanelShowHidden}"
                      IsCheckable="True"
                      IsChecked="{Binding Settings.ShowHidden}"/>
            <MenuItem Header="{x:Static res:Strings.PanelShowSystem}"
                      IsCheckable="True"
                      IsChecked="{Binding Settings.ShowSystem}"/>
            <Separator/>
            <MenuItem Header="{x:Static res:Strings.PanelTreeKeyboardNavigates}"
                      IsCheckable="True"
                      IsChecked="{Binding Settings.TreeKeyboardNavigates}"
                      ToolTip="{x:Static res:Strings.PanelTreeKeyboardNavigatesHint}"/>
            <MenuItem Header="{x:Static res:Strings.PanelConfirmRecycle}"
                      IsCheckable="True"
                      IsChecked="{Binding Settings.ConfirmRecycle}"
                      ToolTip="{x:Static res:Strings.PanelConfirmRecycleHint}"/>
            <MenuItem Header="{x:Static res:Strings.PanelAutoRefresh}"
                      IsCheckable="True"
                      IsChecked="{Binding Settings.AutoRefresh}"/>
            <Separator/>
            <MenuItem Header="{x:Static res:Strings.MenuOptions}" Command="{Binding OptionsCommand}"/>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Background="{StaticResource PaneBackground}">
        <Grid.RowDefinitions>
            <!--
                Header, list and the "+" strip share one row, so the
                divider has a single height to move. Splitting them
                across rows is what made dragging the divider grow the
                "+" strip instead of the bookmarks: a splitter with
                PreviousAndNext resizes the rows it sits between, and
                the row above it was the strip's, not the list's.
            -->
            <RowDefinition x:Name="BookmarksRow" Height="200" MinHeight="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="80"/>
        </Grid.RowDefinitions>

        <!--
            The "keyboard is here" outline belongs to the whole
            bookmarks region, not to the list inside it: the header
            and the "+" strip are part of the same panel, and a
            frame that starts below the header and stops above the
            strip reads as a box around nothing in particular. The
            thickness is always 1 and only the brush changes
            (OnZoneFocusChanged), so nothing shifts when it lights
            up.
        -->
        <Border Grid.Row="0"
                x:Name="BookmarksFrame"
                BorderThickness="1"
                BorderBrush="Transparent">
        <DockPanel x:Name="BookmarksPanel"
                   AllowDrop="True"
                   DragOver="BookmarksPanel_DragOver"
                   Drop="BookmarksPanel_Drop">
            <!-- Collapsible header: whole row is clickable to toggle. -->
            <Button DockPanel.Dock="Top"
                    Command="{Binding ToggleBookmarksCommand}"
                    HorizontalContentAlignment="Stretch"
                    Padding="6,4"
                    Background="{StaticResource HeaderBackground}"
                    BorderBrush="{StaticResource Separator}"
                    BorderThickness="0,0,0,1"
                    Cursor="Hand"
                    ToolTip="{x:Static res:Strings.BookmarksToggleHint}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Margin="0,0,6,0"
                               FontSize="10"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#x25BC;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBookmarksExpanded}" Value="False">
                                        <Setter Property="Text" Value="&#x25B6;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{x:Static res:Strings.BookmarksHeader}" FontWeight="SemiBold"/>
                </DockPanel>
            </Button>

            <!--
                Drop zone for new bookmarks. Sits at the bottom of
                the bookmarks region, right above the divider, and is
                deliberately narrower than the panel so it reads as a
                target rather than as another line of the panel.

                Not a button: nothing happens on a click, so it must
                not offer a hand cursor or light up under an idle
                mouse. It answers only to a drag carrying a folder
                that is not bookmarked yet — see
                SetBookmarkDropZoneActive.
            -->
            <Border x:Name="BookmarkDropZone"
                    DockPanel.Dock="Bottom"
                    Height="20"
                    Margin="12,2,12,2"
                    Background="{StaticResource DropZoneFill}"
                    CornerRadius="2"
                    ToolTip="{x:Static res:Strings.BookmarksAddHint}"
                    AllowDrop="True"
                    DragEnter="BookmarkDropZone_DragEnter"
                    DragOver="BookmarkDropZone_DragOver"
                    DragLeave="BookmarkDropZone_DragLeave"
                    Drop="BookmarkDropZone_Drop"
                    Visibility="{Binding IsBookmarksExpanded, Converter={StaticResource BoolToVisibility}}">
                <TextBlock x:Name="BookmarkDropZoneGlyph"
                           Text="+"
                           FontSize="13"
                           Foreground="{StaticResource DropZoneGlyph}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!--
                AllowDrop=True so cursor feedback shows correctly,
                but DragOver/Drop are intentionally NOT attached here:
                the parent BookmarksPanel handles all drop events so
                that drops anywhere in this region (header, empty
                area, between lines) add the dragged folder(s) as
                bookmarks rather than copying into the current folder.
            -->
            <controls:FolderPanelList x:Name="BookmarksList"
                                      Style="{StaticResource PanelList}"
                                      ContextMenu="{StaticResource PanelSettingsMenu}"
                                      ItemsSource="{Binding Trees.BookmarkLines}"
                                      PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                                      PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                                      PreviewMouseMove="List_PreviewMouseMove"
                                      PreviewMouseWheel="List_PreviewMouseWheel"
                                      PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                                      PreviewMouseRightButtonUp="List_PreviewMouseRightButtonUp"
                                      PreviewKeyDown="List_PreviewKeyDown"
                                      PreviewKeyUp="List_PreviewKeyUp"
                                      PreviewTextInput="List_PreviewTextInput"
                                      AllowDrop="True"
                                      Visibility="{Binding IsBookmarksExpanded, Converter={StaticResource BoolToVisibility}}">
                <controls:FolderPanelList.ItemContainerStyle>
                    <!--
                        Stretched lines, unlike the drives: the "..." menu
                        button lives at the right edge, so the line has to
                        reach it. Bookmark names are short, so nothing is
                        lost by giving up the sideways scroll here.
                    -->
                    <Style TargetType="controls:FolderPanelItem" BasedOn="{StaticResource PanelLine}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </controls:FolderPanelList.ItemContainerStyle>
                <controls:FolderPanelList.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Background="Transparent">
                            <!--
                                The line's own menu, reachable without
                                the right mouse button. Only the user's
                                own bookmarks get it - the special
                                folders are toggled in settings and have
                                nothing to remove. It opens the same menu
                                the right click does. Always visible
                                rather than on hover: a muted glyph on the
                                handful of lines that have one.
                            -->
                            <Button DockPanel.Dock="Right"
                                    Width="18" Height="18"
                                    Margin="4,0,2,0"
                                    Padding="0"
                                    Content="&#x22EF;"
                                    FontSize="13"
                                    Foreground="{StaticResource TextMuted}"
                                    Focusable="False"
                                    Cursor="Hand"
                                    ToolTip="{x:Static res:Strings.BookmarksRowMenuHint}"
                                    Click="BookmarkRowMenu_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowActionHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRemovableBookmark}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!--
                                AsyncIcon, not a converter on the
                                binding: the converter asks the shell
                                on the spot, and a branch of forty
                                folders is forty synchronous shell
                                calls on the dispatcher.
                            -->
                            <controls:AsyncIcon DockPanel.Dock="Left"
                                                IconPath="{Binding FullPath}" IconSize="Small"
                                                Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock x:Name="NameLabel" Text="{Binding Name}"
                                       Style="{StaticResource PanelLineName}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FullPath}"/>
                        </DockPanel>
                    </DataTemplate>
                </controls:FolderPanelList.ItemTemplate>
            </controls:FolderPanelList>
        </DockPanel>
        </Border>

        <GridSplitter x:Name="BookmarksSplitter"
                      Grid.Row="1"
                      Focusable="False"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource Separator}"
                      Visibility="{Binding IsBookmarksExpanded, Converter={StaticResource BoolToVisibility}}"
                      DragCompleted="BookmarksSplitter_DragCompleted"/>

        <!--
            The drives panel gets a title strip like the bookmarks, minus
            the toggle: it is the main panel, and there is nothing to fold
            it into.
        -->
        <DockPanel Grid.Row="2">
            <Border DockPanel.Dock="Top"
                    Padding="6,4"
                    Background="{StaticResource HeaderBackground}"
                    BorderBrush="{StaticResource Separator}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="{x:Static res:Strings.ComputerHeader}" FontWeight="SemiBold"/>
            </Border>
            <!--
                No top margin: the outline is this panel's own edge, and
                a four-pixel gap under the splitter put it where the eye
                does not look for it. The lines keep their air from the
                line template's MinHeight.
            -->
            <controls:FolderPanelList x:Name="DrivesList"
                                      Style="{StaticResource PanelList}"
                                      ContextMenu="{StaticResource PanelSettingsMenu}"
                                      ItemsSource="{Binding Trees.DriveLines}"
                                      ItemContainerStyle="{StaticResource PanelLine}"
                                      PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                                      PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                                      PreviewMouseMove="List_PreviewMouseMove"
                                      PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                                      PreviewMouseRightButtonUp="List_PreviewMouseRightButtonUp"
                                      PreviewMouseWheel="List_PreviewMouseWheel"
                                      PreviewKeyDown="List_PreviewKeyDown"
                                      PreviewKeyUp="List_PreviewKeyUp"
                                      PreviewTextInput="List_PreviewTextInput"
                                      AllowDrop="True"
                                      DragOver="OnDragOver"
                                      Drop="OnDrop">
                <controls:FolderPanelList.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <controls:AsyncIcon IconPath="{Binding FullPath}" IconSize="Small"
                                                Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock x:Name="NameLabel" Text="{Binding Name}" Style="{StaticResource PanelLineName}"/>
                        </StackPanel>
                    </DataTemplate>
                </controls:FolderPanelList.ItemTemplate>
            </controls:FolderPanelList>
        </DockPanel>
    </Grid>
</UserControl>
