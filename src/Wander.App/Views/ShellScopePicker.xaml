<Window x:Class="Wander.App.Views.ShellScopePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Wander.App.Resources"
        Title="{x:Static res:Strings.PickerTitle}"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource ChromeBackground}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <!--
        Adds rows to the context-menu table. Two ways in, because there are
        two ways someone thinks about it: "hide everything 7-Zip puts in my
        menus" and "show me what is registered on .psd".

        The type list leads with what was actually right-clicked lately —
        eight hundred extensions in alphabetical order is a list nobody
        reads, and the five you were just working with is a shortcut.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource TextCaption}" Margin="0,0,0,12"
                   Text="{x:Static res:Strings.PickerHint}"/>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="{x:Static res:Strings.PickerByApp}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="AppList" SelectionMode="Extended"
                             DisplayMemberPath="Title"
                             BorderBrush="{StaticResource Separator}" Background="{StaticResource InputBackground}"/>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static res:Strings.PickerByType}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TypeFilter" Grid.Row="0" Padding="6,4" Margin="0,0,0,8"
                             BorderBrush="{StaticResource Separator}"
                             TextChanged="TypeFilter_TextChanged"/>
                    <ListBox x:Name="TypeList" Grid.Row="1" SelectionMode="Extended"
                             BorderBrush="{StaticResource Separator}" Background="{StaticResource InputBackground}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Width="90"/>
                                    <!-- Marks the ones just right-clicked, which is the
                                         only ranking signal there is. -->
                                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource TextDim}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{x:Static res:Strings.ActionOk}" IsDefault="True"
                    Width="94" Height="30" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="{x:Static res:Strings.ActionCancel}" IsCancel="True"
                    Width="94" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
