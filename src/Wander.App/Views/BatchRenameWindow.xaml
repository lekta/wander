<Window x:Class="Wander.App.Views.BatchRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Wander.App.Controls"
        xmlns:res="clr-namespace:Wander.App.Resources"
        Title="{Binding Title}"
        Width="920" Height="580"
        MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=TemplateBox}"
        Background="{StaticResource ChromeBackground}">

    <!--
        Rules on the left, what they do on the right, recomputed on every
        keystroke - nothing is renamed until OK. The rules and the table are
        BatchRenameViewModel's; what a rule means and which rows collide is
        RenamePlanner's.

        OK is deliberately not the default button: Enter in a field must not
        rename forty files. Escape cancels.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextCaption}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- The three counter fields: numbers that can be typed, scrolled or pulled. -->
        <Style x:Key="CounterBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Margin" Value="4,0,10,0"/>
            <Setter Property="controls:NumericField.Enabled" Value="True"/>
        </Style>

        <Style x:Key="CounterLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,8,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Margin="0,0,16,0"
                          VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.BatchRenameTemplate}" Style="{StaticResource FieldLabel}"/>
                    <!--
                        Editable, with the last templates applied in the
                        drop-down. Text search off: it would complete "[" into
                        whichever remembered template starts with it.
                    -->
                    <ComboBox x:Name="TemplateBox"
                              IsEditable="True" IsTextSearchEnabled="False"
                              ItemsSource="{Binding TemplateHistory}"
                              Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{x:Static res:Strings.BatchRenameTemplateHint}" Style="{StaticResource Caption}"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="{x:Static res:Strings.BatchRenameCounter}" Style="{StaticResource FieldLabel}"/>
                    <!--
                        Explicit, not PropertyChanged: NumericField drives the
                        update itself, so a half-typed number stays as typed.
                    -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static res:Strings.BatchRenameCounterStart}" Style="{StaticResource CounterLabel}"/>
                        <TextBox Style="{StaticResource CounterBox}"
                                 Text="{Binding CounterStart, UpdateSourceTrigger=Explicit}"/>
                        <TextBlock Text="{x:Static res:Strings.BatchRenameCounterStep}" Style="{StaticResource CounterLabel}"/>
                        <TextBox Style="{StaticResource CounterBox}"
                                 Text="{Binding CounterStep, UpdateSourceTrigger=Explicit}"/>
                        <TextBlock Text="{x:Static res:Strings.BatchRenameCounterWidth}" Style="{StaticResource CounterLabel}"/>
                        <TextBox Style="{StaticResource CounterBox}"
                                 Text="{Binding CounterWidth, UpdateSourceTrigger=Explicit}"/>
                    </StackPanel>

                    <!-- Find / replace is the rarer tool: behind a tick, under the template. -->
                    <CheckBox Content="{x:Static res:Strings.BatchRenameUseFind}"
                              IsChecked="{Binding UseFind}" Margin="0,16,0,0"/>
                    <StackPanel Margin="20,0,0,0"
                                Visibility="{Binding UseFind, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Static res:Strings.BatchRenameFind}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{x:Static res:Strings.BatchRenameReplace}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}"/>

                        <CheckBox Content="{x:Static res:Strings.BatchRenameIgnoreCase}"
                                  IsChecked="{Binding FindIgnoreCase}"/>
                        <CheckBox Content="{x:Static res:Strings.BatchRenameRegex}"
                                  ToolTip="{x:Static res:Strings.BatchRenameRegexHint}"
                                  IsChecked="{Binding FindIsRegex}"/>
                    </StackPanel>

                    <TextBlock Text="{x:Static res:Strings.BatchRenameNameCase}" Style="{StaticResource FieldLabel}"
                               Margin="0,16,0,3"/>
                    <ComboBox ItemsSource="{Binding CaseChoices}"
                              DisplayMemberPath="Title" SelectedValuePath="Value"
                              SelectedValue="{Binding NameCase}"/>

                    <TextBlock Text="{x:Static res:Strings.BatchRenameExtensionCase}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding CaseChoices}"
                              DisplayMemberPath="Title" SelectedValuePath="Value"
                              SelectedValue="{Binding ExtensionCase}"/>
                    <TextBlock Text="{x:Static res:Strings.BatchRenameExtensionHint}" Style="{StaticResource Caption}"
                               Margin="0,4,0,8"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserResizeRows="False" CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource GridLine}"
                          BorderBrush="{StaticResource Separator}"
                          Background="{StaticResource ContentBackground}"
                          RowBackground="{StaticResource ContentBackground}"
                          AlternatingRowBackground="{StaticResource TableRowAlternate}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:Strings.BatchRenameColumnOld}"
                                            Binding="{Binding OldName}" Width="*"/>
                        <DataGridTextColumn Header="{x:Static res:Strings.BatchRenameColumnNew}"
                                            Binding="{Binding NewName}" Width="*"/>
                        <DataGridTextColumn Header="{x:Static res:Strings.BatchRenameColumnStatus}"
                                            Binding="{Binding StatusText}" Width="160"/>
                    </DataGrid.Columns>
                    <!-- A conflict is red, a row the rules leave alone is grey. -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnchanged}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextError}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <DockPanel Grid.Row="1" Margin="0,6,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{x:Static res:Strings.BatchRenameOrderNote}"
                               Style="{StaticResource Caption}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{x:Static res:Strings.BatchRenameReadingShotDates}"
                               Style="{StaticResource Caption}"
                               Visibility="{Binding IsReadingShotDates, Converter={StaticResource BoolToVisibility}}"/>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- The strip that ends the window, set apart from everything above it. -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="16,12"
                Background="{StaticResource StripBackground}"
                BorderBrush="{StaticResource Separator}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding RuleError}" Foreground="{StaticResource TextError}"
                               TextWrapping="Wrap" Margin="0,0,0,2"
                               Visibility="{Binding HasRuleError, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding Summary}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{x:Static res:Strings.ActionOk}"
                            IsEnabled="{Binding CanApply}"
                            Width="110" Padding="6,4" Margin="0,0,8,0"
                            Click="OnOk"/>
                    <Button Content="{x:Static res:Strings.ActionCancel}"
                            Width="110" Padding="6,4"
                            IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
