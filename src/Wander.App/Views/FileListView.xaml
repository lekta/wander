<UserControl x:Class="Wander.App.Views.FileListView"
             x:Name="ListRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Wander.App.Converters"
             xmlns:controls="clr-namespace:Wander.App.Controls"
             xmlns:res="clr-namespace:Wander.App.Resources"
             Background="Transparent">
    <!--
        The file list, all display modes in one place.

        Everything that is "how a folder listing behaves" lives here:
        the three view containers, the gestures they share (selection,
        marquee, drag arming, inline rename, context-menu invocation) and
        the loading overlay. MainWindow keeps what surrounds it — the
        toolbar, the address bar, the trees, the drop pipeline — and talks
        to this control through a handful of methods and two events.

        Adding a fourth mode (gallery) means a container and a
        Visibility trigger here, not a change to the window.
    -->
    <UserControl.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
        <conv:TileSecondLineConverter x:Key="TileSecondLine"/>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>
        <conv:RankTextConverter x:Key="RankText"/>
        <conv:ColorLabelBrushConverter x:Key="ColorLabelBrush"/>
        <conv:RatingBadgeVisibilityConverter x:Key="RatingBadge"/>
        <conv:FilterStarConverter x:Key="FilterStarGlyph"/>
        <conv:CutRowConverter x:Key="IsCutRow"/>
        <conv:TimeStampConverter x:Key="TimeStamp"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!--
            One star of the filter bar. Same shape as the preview footer's
            rating widget and deliberately so: the row that says "this photo
            has three stars" and the row that says "show me three stars"
            read the same because they are the same alphabet.
        -->
        <Style x:Key="FilterStar" TargetType="Button">
            <Setter Property="Command" Value="{Binding SetFilterRankCommand}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource RatingStar}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="{x:Static res:Strings.FilterRatingHint}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The crossed-out star: photographs nobody has rated yet.

            It sits to the left of the five because that is where it belongs
            on the same scale — below one star — and it is struck through
            rather than merely empty because an empty star already means
            "this rank is not in the filter". Struck through says "no rank at
            all", which is a different statement and the one being made.

            A plain click picks it alone: "unrated and above" would be every
            photograph in the folder, which is not a filter. Ctrl adds it to
            whatever else is chosen, which is how "the good ones and the ones
            I have not looked at yet" gets said.
        -->
        <Style x:Key="FilterUnratedStar" TargetType="Button" BasedOn="{StaticResource FilterStar}">
            <Setter Property="ToolTip" Value="{x:Static res:Strings.FilterUnratedHint}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Glyph" Text="&#x2605;"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{StaticResource RatingStarEmpty}"
                                       TextDecorations="Strikethrough"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding FilterIncludesUnrated}" Value="True">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource RatingStar}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One colour swatch of the filter bar; the ring marks the chosen one. -->
        <Style x:Key="FilterSwatch" TargetType="Button">
            <Setter Property="Command" Value="{Binding DataContext.SetFilterColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="ToolTip" Value="{x:Static res:Strings.FilterColorHint}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="2">
                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource SwatchRing}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="{StaticResource ControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One of the three background buttons on the gallery's own strip. -->
        <Style x:Key="GalleryBackgroundButton" TargetType="RadioButton">
            <Setter Property="Command" Value="{Binding SetGalleryBackgroundCommand}"/>
            <Setter Property="GroupName" Value="GalleryBackgroundStrip"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- The swatch *is* the label: the button shows the
                             colour it sets. A checkmark would need room the
                             strip does not have, so the chosen one is the
                             one with the dark ring. -->
                        <Border x:Name="Ring" Width="18" Height="18" CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource OptionRing}" BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource OptionRingChecked}"/>
                                <Setter TargetName="Ring" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource OptionRingHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Inline rename (A3) has no element in the row templates any more:
            the editor is one TextBox for the whole control, laid over the
            name label of the row being renamed (RenameAdorner, see the
            rename section of the code-behind). The label it covers is the
            TextBlock named NameLabel in every template below - that name is
            the contract.
        -->

        <!--
            Hidden entries are faded to opacity 0.55 — Explorer parity, and
            the same trigger is on the TreeViewItem style in MainWindow so
            drives and bookmarks match the file list.

            The System attribute deliberately gets no treatment of its own.
            It used to slant the label, and that turned out to say the wrong
            thing far too often: Windows sets +S on any folder carrying a
            desktop.ini, so an ordinary folder with a custom icon came out
            italic while Explorer showed it as the plain folder it is.

            FocusVisualStyle is nulled on every row container: WPF's default
            dashed rectangle draws on top of the selection background and
            reads as "double selection". Focus is still tracked semantically,
            so keyboard navigation is unaffected.
        -->
        <Style TargetType="DataGridRow">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <!--
                    Cut, not yet pasted. Explorer fades these the moment
                    Ctrl+X is pressed, and the fade is the only thing that
                    says the next paste will move them rather than copy.
                -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IsCutRow}">
                            <Binding Path="FullPath"/>
                            <Binding Path="DataContext.CutPaths"
                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Opacity" Value="0.45"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <!--
            The tile container. The panel arranges it at the cell rectangle;
            its Margin is the cell's margin (from TileMetrics, delivered as a
            resource by ApplyTileMetrics in the code-behind), so the chrome
            Border inside is the tile itself - the cell minus its margin -
            and the highlight stops between neighbours the way Explorer's
            does. A default ListBoxItem would add 4 px of padding and a 1 px
            border the panel never budgeted for; this one has neither.

            The highlight is the container's own template, driven by
            property triggers on the container: no bindings, no extra
            element. It used to be a sibling Border with seven DataTriggers,
            each a RelativeSource binding up to the ListBoxItem, in every
            tile - the second most expensive thing in the template after
            the rename TextBox (PLAN R, 2026-09-02). Colours follow Explorer
            (#E5F3FB hover, #CCE8FF selected, #E8E8E8 for a selection in a
            pane that lost focus - the same three the tree uses); the gallery
            takes its own from GalleryPalette below.
        -->
        <Style x:Key="TileChrome" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <!--
                    Cut, not yet pasted. Explorer fades these the moment
                    Ctrl+X is pressed, and the fade is the only thing that
                    says the next paste will move them rather than copy.
                -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IsCutRow}">
                            <Binding Path="FullPath"/>
                            <Binding Path="DataContext.CutPaths"
                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Opacity" Value="0.45"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tiles and LargeIcons: Explorer's colours, static brushes. -->
        <Style x:Key="TileItem" TargetType="ListBoxItem" BasedOn="{StaticResource TileChrome}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHover}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource RowHoverBorder}"/>
                </Trigger>
                <!--
                    Selected, but the keyboard is somewhere else. Kept from
                    the default template we replaced above, and it doubles as
                    the answer to "which pane does the next Delete mean".
                -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelectedInactive}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource RowSelectedInactiveBorder}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="Selector.IsSelectionActive" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource RowSelected}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource RowSelectedBorder}"/>
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource RowSelectedHover}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource RowSelectedHoverBorder}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TilesItem" TargetType="ListBoxItem" BasedOn="{StaticResource TileItem}">
            <Setter Property="Margin" Value="{DynamicResource TilesCellMargin}"/>
            <!-- Mirrors TileMetrics.ForTiles' own padding; the two have to
                 stay equal, or the text loses a couple of units to clipping. -->
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style x:Key="IconsItem" TargetType="ListBoxItem" BasedOn="{StaticResource TileItem}">
            <Setter Property="Margin" Value="{DynamicResource IconsCellMargin}"/>
        </Style>

        <!--
            The gallery's rating badge, kept out of the cell template on
            purpose: a Border, a StackPanel, an Ellipse and a TextBlock with
            four bindings used to be built in every cell, and only rated
            photographs ever show them (PLAN R3). The cell holds an empty
            ContentControl instead, and a trigger hands it this template on
            the cells that have a rating.
        -->
        <DataTemplate x:Key="GalleryRatingBadge">
            <Border Background="{StaticResource BadgeBackground}" CornerRadius="2"
                    Padding="3,0" Margin="2">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,3,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding Rating, Converter={StaticResource RatingBadge}, ConverterParameter=Color}"
                             Fill="{Binding Rating, Converter={StaticResource ColorLabelBrush}}"/>
                    <TextBlock Text="{Binding Rating, Converter={StaticResource RankText}}"
                               FontSize="10" Foreground="{StaticResource BadgeRating}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
            Selection and hover for a gallery cell: the same shape and a
            different thing in colour. Explorer's pale blue over a dark
            surround is brighter than most of the photographs under it, and
            the eye goes to the frame instead of the picture. Every colour
            here comes out of GalleryPalette, which derives them from the
            chosen background - on a dark one the highlight is a lift of the
            surround rather than a colour laid over it. The bindings are in
            trigger setters, so they cost nothing until a cell is hovered or
            selected.
        -->
        <Style x:Key="GalleryItem" TargetType="ListBoxItem" BasedOn="{StaticResource TileChrome}">
            <Setter Property="Margin" Value="{DynamicResource GalleryCellMargin}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding DataContext.Settings.GalleryPalette.Hover, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Setter Property="BorderBrush" Value="{Binding DataContext.Settings.GalleryPalette.HoverBorder, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding DataContext.Settings.GalleryPalette.SelectedInactive, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Setter Property="BorderBrush" Value="{Binding DataContext.Settings.GalleryPalette.SelectedInactiveBorder, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="Selector.IsSelectionActive" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{Binding DataContext.Settings.GalleryPalette.Selected, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Setter Property="BorderBrush" Value="{Binding DataContext.Settings.GalleryPalette.SelectedBorder, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!--
            The gesture set every mode shares. Kept as one style so a new
            container cannot silently miss half of them.
        -->
        <Style x:Key="ListGestures" TargetType="Control">
            <!--
                Пунктирная рамка вокруг всей области — это фокус на самом
                списке, а не на строке. WPF ставит его туда, когда строку
                сфокусировать не удалось (пустая папка, снятое выделение,
                перестроенный листинг). Что зона активна, и так видно по
                рамке FileListZone, а системный пунктир вокруг половины окна
                читается как поломка. Стрелки в этом состоянии оживляет
                TryEnterList в code-behind.
            -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="Selector.SelectionChanged" Handler="List_SelectionChanged"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="List_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="List_PreviewMouseLeftButtonUp"/>
            <EventSetter Event="PreviewMouseMove" Handler="List_PreviewMouseMove"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="List_PreviewMouseRightButtonDown"/>
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="List_PreviewMouseRightButtonUp"/>
            <EventSetter Event="PreviewKeyDown" Handler="List_PreviewKeyDown"/>
            <EventSetter Event="PreviewKeyUp" Handler="List_PreviewKeyUp"/>
            <EventSetter Event="PreviewTextInput" Handler="List_PreviewTextInput"/>
            <EventSetter Event="MouseDoubleClick" Handler="List_MouseDoubleClick"/>
            <EventSetter Event="PreviewMouseWheel" Handler="List_PreviewMouseWheel"/>
            <!-- Только средняя кнопка: левая и правая разбираются выше
                 своими обработчиками, этот их не трогает. -->
            <EventSetter Event="PreviewMouseDown" Handler="List_PreviewMouseDown"/>
        </Style>

        <!--
            Tiles / LargeIcons share everything but their item template and
            their cell size.

            Scrolling is deliberately NOT set here. Each view owns its own
            scroller, because the policy differs per view and is part of what
            the view is: the tile views wrap, so horizontal scrolling is
            meaningless in them and is switched off; Details is a table and
            wants a horizontal bar the moment its columns outgrow the pane.
            One shared setter would make the next view inherit a policy
            nobody chose for it.
        -->
        <Style x:Key="TilePanel" TargetType="ListBox" BasedOn="{StaticResource ListGestures}">
            <Setter Property="ItemsSource" Value="{Binding Entries}"/>
            <Setter Property="SelectedItem" Value="{Binding SelectedEntry}"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <!--
                Containers are reused instead of rebuilt as cells scroll past
                — inflating the template was the single most expensive thing
                the UI thread did while scrolling.
            -->
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!--
            Rating filter (PLAN J3). A strip rather than a menu item, and
            visible only in folders where something is actually rated.

            Both halves of that are deliberate. A filter is state that
            removes rows, and state that removes rows has to be visible from
            the screen it is removing them from — a filter left on inside a
            menu is the "why is this folder empty" bug, and every photo
            browser that hides one eventually grows a warning strip to
            compensate. And a bar that appeared over every folder of source
            code would be a permanent row of stars nobody can use, so it
            follows MainViewModel.HasRatings, which the sidecar pass sets.

            It filters in every view, not only the gallery: "three stars and
            up" is as good a question in the table as it is in the grid.
        -->
        <Border x:Name="GalleryStrip"
                DockPanel.Dock="Top"
                Background="{StaticResource StripBackground}" BorderBrush="{StaticResource Separator}" BorderThickness="0,0,0,1"
                Padding="6,3">
            <!--
                The strip carries two independent things, each with its own
                reason to be here rather than in a menu, and each showing
                only when it applies:

                  * the rating filter, whenever the folder has ratings —
                    state that removes rows has to be visible from the list
                    it removes them from;
                  * the gallery's background, whenever the gallery is on —
                    it is the control you reach for while looking at the
                    photographs, and three clicks into a menu is three
                    clicks too many for a thing you flip to compare.

                Neither of them applying means no strip at all, so an
                ordinary folder in an ordinary view loses no height to it.
            -->
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRatings}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ViewMode}" Value="Gallery">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <!-- Background switcher, right-aligned: it belongs to the
                     view, not to the folder, so it stays out of the way of
                     the filter that does. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Gallery}">
                    <RadioButton Style="{StaticResource GalleryBackgroundButton}"
                                 CommandParameter="Light"
                                 Background="{Binding Settings.GalleryLightSwatch}"
                                 IsChecked="{Binding Settings.GalleryBackground, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Light}"
                                 ToolTip="{x:Static res:Strings.GalleryBackgroundLight}"/>
                    <RadioButton Style="{StaticResource GalleryBackgroundButton}"
                                 CommandParameter="Grey"
                                 Background="{Binding Settings.GalleryGreySwatch}"
                                 IsChecked="{Binding Settings.GalleryBackground, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Grey}"
                                 ToolTip="{x:Static res:Strings.GalleryBackgroundGrey}"/>
                    <RadioButton Style="{StaticResource GalleryBackgroundButton}"
                                 CommandParameter="Dark"
                                 Background="{Binding Settings.GalleryDarkSwatch}"
                                 IsChecked="{Binding Settings.GalleryBackground, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}"
                                 ToolTip="{x:Static res:Strings.GalleryBackgroundDark}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding HasRatings, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Static res:Strings.FilterRatingLabel}"
                           FontSize="11" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Style="{StaticResource FilterUnratedStar}" CommandParameter="0"/>
                <Button Style="{StaticResource FilterStar}" CommandParameter="1"
                            Content="{Binding RatingFilter, Converter={StaticResource FilterStarGlyph}, ConverterParameter=1}"/>
                <Button Style="{StaticResource FilterStar}" CommandParameter="2"
                            Content="{Binding RatingFilter, Converter={StaticResource FilterStarGlyph}, ConverterParameter=2}"/>
                <Button Style="{StaticResource FilterStar}" CommandParameter="3"
                            Content="{Binding RatingFilter, Converter={StaticResource FilterStarGlyph}, ConverterParameter=3}"/>
                <Button Style="{StaticResource FilterStar}" CommandParameter="4"
                            Content="{Binding RatingFilter, Converter={StaticResource FilterStarGlyph}, ConverterParameter=4}"/>
                <Button Style="{StaticResource FilterStar}" CommandParameter="5"
                            Content="{Binding RatingFilter, Converter={StaticResource FilterStarGlyph}, ConverterParameter=5}"/>

                <ItemsControl ItemsSource="{Binding FilterColorChoices}"
                              Margin="12,0,0,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource FilterSwatch}"
                                    CommandParameter="{Binding Index}"
                                    ToolTip="{Binding Name}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="{x:Static res:Strings.FilterClear}"
                        Command="{Binding ClearRatingFilterCommand}"
                        Visibility="{Binding HasRatingFilter, Converter={StaticResource BoolToVisibility}}"
                        Margin="12,0,0,0" Padding="6,0" FontSize="11"
                        Focusable="False"
                        VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
        <!-- Details -->
        <DataGrid x:Name="DetailsView"
                  Style="{StaticResource ListGestures}"
                  Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Details}"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  ClipboardCopyMode="None"
                  AllowDrop="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  GridLinesVisibility="None" AlternatingRowBackground="{StaticResource DetailsRowAlternate}"
                  HeadersVisibility="Column"
                  Sorting="Details_Sorting"
                  RowHeight="{Binding Settings.DetailsRowHeight}">
            <DataGrid.Columns>
                <!--
                    Row height and icon size are this view's own settings
                    (PLAN A1) — Ctrl + wheel writes the same two fields, so
                    the gesture and the dialog cannot disagree. The column's
                    width is derived from the icon rather than settable: a
                    column narrower than its icon would just clip it.

                    That width is set from code-behind, not bound: a
                    DataGridColumn is not part of the visual tree, has no
                    DataContext of its own, and a RelativeSource binding on it
                    silently resolves to nothing. The icon inside the cell
                    could be bound, and was — twice, through RelativeSource up
                    to this UserControl, in every realised row. Both numbers
                    now come from ApplyDetailsIconSize, the size as a
                    DynamicResource, for the reason the tile sizes do
                    (PLAN R3).
                -->
                <DataGridTemplateColumn x:Name="IconColumn" Header="" IsReadOnly="True" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:AsyncIcon IconPath="{Binding FullPath}" IconSize="Normal"
                                                Width="{DynamicResource DetailsIconSize}"
                                                Height="{DynamicResource DetailsIconSize}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--
                    Name + the "has companions" marker. A template
                    column rather than a text one only because of
                    that marker; SortMemberPath keeps the header
                    behaving exactly as before.
                -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnName}" Width="*" SortMemberPath="Name" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="NameLabel" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--
                    SortMemberPath carries the SortKey name rather than the
                    bound property: the grid never sorts anything itself
                    (Details_Sorting refuses), so this field is free to be
                    the identifier the view model understands.
                -->
                <!--
                    Where the file is, and what it matched on. Both are
                    meaningless in a folder listing — every row shares the
                    folder, and nothing matched anything — so both are
                    collapsed until the list is showing search results (see
                    ShowSearchColumns), for the same reason the rating column
                    is: an always-present column of nothing is a column
                    everyone learns to look past.

                    Neither is sortable. Sorting exists here for the columns
                    the view model knows a SortKey for; these two would need
                    keys of their own, and "sort my results by the line they
                    matched on" is not a thing anybody has asked for.
                -->
                <DataGridTextColumn x:Name="FolderColumn"
                                    Header="{x:Static res:Strings.ColumnFolder}"
                                    Binding="{Binding ParentFolder}"
                                    Width="220" CanUserSort="False"/>
                <DataGridTextColumn x:Name="MatchColumn"
                                    Header="{x:Static res:Strings.ColumnMatch}"
                                    Binding="{Binding MatchSnippet}"
                                    Width="*" CanUserSort="False"/>
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnType}" Binding="{Binding Kind}" Width="80" SortMemberPath="Type"/>
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnSize}" Binding="{Binding Size}" Width="100" SortMemberPath="Size"/>
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnModified}" Binding="{Binding ModifiedUtc, Converter={StaticResource TimeStamp}}" Width="140" SortMemberPath="ModifiedDate"/>
                <!--
                    Rating. Collapsed until the folder has one (see
                    ShowRatingColumn) - an always-present column of nothing
                    is a column everyone learns to look past, and this one
                    only means something next to photographs.

                    Sorting by it is the reason it is a column at all rather
                    than a badge: the header goes through Details_Sorting
                    like every other, which routes to SortKey.Rating. The
                    order it produces arrives a moment after the listing,
                    because the stars do.
                -->
                <DataGridTemplateColumn x:Name="RatingColumn"
                                        Header="{x:Static res:Strings.ColumnRating}"
                                        Width="90" SortMemberPath="Rating" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,5,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding Rating, Converter={StaticResource ColorLabelBrush}}"/>
                                <TextBlock Text="{Binding Rating, Converter={StaticResource RankText}}"
                                           Foreground="{StaticResource RatingStar}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Tiles -->
        <ListBox x:Name="TilesView"
                 Style="{StaticResource TilePanel}"
                 ItemContainerStyle="{StaticResource TilesItem}"
                 FontSize="{Binding Settings.TilesMetrics.LabelFontSize}"
                 Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Tiles}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True">
            <!--
                CanContentScroll hands scrolling to the panel (it is the
                IScrollInfo). The vertical bar is automatic — a folder that
                fits shows no bar. The panel takes the bar into account
                itself (see VirtualizingWrapPanel.ColumnWidth): a wrap layout
                can want the bar at the full width and not want it at the
                narrower one, and left to the ScrollViewer alone those two
                answers chase each other.
            -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:VirtualizingWrapPanel CellWidth="{Binding Settings.TilesMetrics.CellWidth}"
                                                    CellHeight="{Binding Settings.TilesMetrics.CellHeight}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <!--
                The row templates below are kept deliberately thin: this is
                what every visible tile pays on every folder, and a walk
                through folders of photographs is nothing but this cost
                (PLAN R). Sizes are not bound per element: the tile is the
                container (TilesItem above) stretched to the cell the panel
                gave it, the name's font size is inherited from the ListBox,
                and the few numbers a template still needs come in as
                resources that ApplyTileMetrics rewrites when the settings
                change. No rename editor, no style triggers, no RelativeSource
                bindings. What a template may not do is described in
                ARCHITECTURE.md ("Шаблон плитки").
            -->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--
                        Icon docked left, text in what is left: the name
                        then trims against the tile's real width, whatever
                        the user set it to.
                    -->
                    <DockPanel>
                        <!--
                            Medium, not Normal: a real thumbnail of the
                            picture / the folder's contents where the
                            shell has one, the plain extension icon where
                            it has not. Details stays on Normal — at 20 px
                            a photo is a smudge, and a folder of source
                            would pay a per-file shell call for nothing.

                            DownOnly for the same reason as the two grids
                            below: the size is a ceiling, not a target.
                        -->
                        <controls:AsyncIcon DockPanel.Dock="Left"
                                            IconPath="{Binding FullPath}" IconSize="Medium"
                                            Width="{DynamicResource TilesImageSize}"
                                            Height="{DynamicResource TilesImageSize}"
                                            StretchDirection="DownOnly"
                                            Margin="0,0,8,0" VerticalAlignment="Center"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            UseLayoutRounding="True"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="NameLabel" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <!--
                                The second line is the file's kind in a
                                folder and its folder in a result list -
                                TileSecondLineConverter, switched by the
                                code-behind when results come and go. The
                                tooltip is the matched text, which only a
                                result has.
                            -->
                            <TextBlock Text="{Binding Converter={StaticResource TileSecondLine}}"
                                       ToolTip="{Binding MatchSnippet}"
                                       Foreground="{StaticResource TextSubtle}" TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource TilesSecondaryFontSize}"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Large icons -->
        <ListBox x:Name="IconsView"
                 Style="{StaticResource TilePanel}"
                 ItemContainerStyle="{StaticResource IconsItem}"
                 FontSize="{Binding Settings.IconsMetrics.LabelFontSize}"
                 Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=LargeIcons}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True">
            <!-- Same scroller policy as Tiles, and for the same reason. -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:VirtualizingWrapPanel CellWidth="{Binding Settings.IconsMetrics.CellWidth}"
                                                    CellHeight="{Binding Settings.IconsMetrics.CellHeight}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--
                        Every size here comes from IconsMetrics, computed
                        from Settings.LargeIcon* — the same value the panel
                        above lays out on, so the tile and the cell it sits
                        in cannot disagree. The tile is the container
                        stretched to its cell; the image size and the label
                        box arrive as resources (ApplyTileMetrics), the font
                        size is inherited from the ListBox.

                        The image size is a ceiling, not a target
                        (StretchDirection=DownOnly): what is smaller keeps
                        its own size. See the gallery template below.
                    -->
                    <StackPanel>
                        <controls:AsyncIcon IconPath="{Binding FullPath}" IconSize="Large"
                                            Width="{DynamicResource IconsImageSize}"
                                            Height="{DynamicResource IconsImageSize}"
                                            StretchDirection="DownOnly"
                                            Margin="0,2,0,2"
                                            HorizontalAlignment="Center"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            UseLayoutRounding="True"/>
                        <TextBlock x:Name="NameLabel" Text="{Binding Name}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Height="{DynamicResource IconsLabelHeight}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--
            Gallery (PLAN J). Structurally the LargeIcons grid with bigger
            cells, its own background and a rating badge - deliberately so:
            the arithmetic, the virtualising panel and the whole gesture set
            are the ones that were already debugged, and a second
            implementation of a wrapping grid is a second set of the same
            bugs.

            What is actually different is the surround. The background is
            not decoration: a photograph looks darker against white and
            lighter against black, so judging one means choosing what sits
            around it. Everything that has to move with that choice - the
            caption, the hover, the selection - is computed from it by
            GalleryPalette, so a background can never end up with a
            highlight brighter than the photographs it frames or with text
            nobody can read.
        -->
        <ListBox x:Name="GalleryView"
                 Style="{StaticResource TilePanel}"
                 ItemContainerStyle="{StaticResource GalleryItem}"
                 FontSize="{Binding Settings.GalleryMetrics.LabelFontSize}"
                 Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Gallery}"
                 Background="{Binding Settings.GalleryPalette.Background}"
                 Foreground="{Binding Settings.GalleryPalette.Foreground}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True">
            <!--
                Foreground on the list, not on the caption: the caption's
                colour comes from the palette rather than from the theme, and
                it does not change when the cell is selected - the highlight
                is derived from the same background, so it can never be the
                light-on-light that a fixed Explorer blue behind light text
                would have been. Set here once, it is inherited by every
                caption; the badge overrides it with its own colour.
            -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:VirtualizingWrapPanel CellWidth="{Binding Settings.GalleryMetrics.CellWidth}"
                                                    CellHeight="{Binding Settings.GalleryMetrics.CellHeight}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel ToolTip="{Binding Name}">
                        <!--
                            Sized explicitly rather than left to the
                            picture: an Image left to measure itself reports
                            its source's natural size, and the cell size is
                            an input to layout here (see TileMetrics)
                            precisely so that nothing about a folder's
                            contents can move the grid. The Grid is for the
                            badge; the image sits centred in it.

                            DownOnly - the cell is a ceiling, not a target.
                            A picture (or an icon) smaller than the cell is
                            drawn at its own size; only a bigger one is
                            shrunk to fit. Blowing a 16-px file up to 200
                            is mush, and it makes a tiny icon shout as
                            loudly as a photograph.
                        -->
                        <Grid Width="{DynamicResource GalleryImageSize}"
                              Height="{DynamicResource GalleryImageSize}"
                              Margin="0,2,0,2">
                            <controls:AsyncIcon IconPath="{Binding FullPath}" IconSize="Large"
                                                StretchDirection="DownOnly"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                UseLayoutRounding="True"/>
                            <!--
                                Rating badge: stars and the colour label
                                over the corner of the picture. On the
                                picture rather than under it because the
                                caption line is already spoken for, and
                                a folder of photographs is exactly where
                                "which ones did I mark" has to be
                                answerable at a glance.

                                Empty until the trigger below gives it
                                content and a template. A ContentControl
                                with neither builds nothing and shows
                                nothing, so an unrated cell - which is most
                                of them, and all of them in a folder nobody
                                has been through yet - pays two visuals and
                                the trigger's one binding, instead of four
                                visuals and four bindings. Measured on a
                                real cell: 11 visuals before, 9 unrated and
                                13 rated after.
                            -->
                            <ContentControl x:Name="Badge"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        </Grid>
                        <TextBlock x:Name="NameLabel" Text="{Binding Name}"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Height="{DynamicResource GalleryLabelHeight}"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Rating, Converter={StaticResource RatingBadge}, ConverterParameter=Badge}"
                                     Value="Visible">
                            <Setter TargetName="Badge" Property="Content" Value="{Binding}"/>
                            <Setter TargetName="Badge" Property="ContentTemplate" Value="{StaticResource GalleryRatingBadge}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--
            Loading overlay for slow list enumerations (shell
            namespaces like Recycle Bin go through Shell.Application
            COM, which can take a noticeable fraction of a second).
            Z-ordered last so it sits on top of the three view
            containers; non-hit-testable so the user's clicks fall
            through to the empty list rather than the spinner.
        -->
        <Grid Visibility="{Binding IsListLoading, Converter={StaticResource BoolToVisibility}}"
              Background="{StaticResource LoadingVeil}"
              IsHitTestVisible="False">
            <Ellipse Width="32" Height="32" StrokeThickness="3"
                     Stroke="{StaticResource AccentStroke}" Fill="Transparent"
                     StrokeDashArray="3,2"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="ListSpinnerRotate" Angle="0"/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="ListSpinnerRotate"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </Grid>

        <!--
            A search in flight. Deliberately unlike the listing spinner
            above: no dimming veil and a muted colour, because results keep
            arriving underneath it and covering them would defeat the point
            of streaming them at all. It says "still going", nothing more —
            the counts are in the status bar and in the search window.
        -->
        <Grid Visibility="{Binding ContentSearch.IsRunning, Converter={StaticResource BoolToVisibility}}"
              Background="Transparent"
              IsHitTestVisible="False">
            <Ellipse Width="26" Height="26" StrokeThickness="2"
                     Stroke="{StaticResource SpinnerQuiet}" Fill="Transparent" Opacity="0.7"
                     StrokeDashArray="3,2"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="SearchSpinnerRotate" Angle="0"/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="SearchSpinnerRotate"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:1.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </Grid>

        <!--
            The folder is not there any more. Opaque rather than a veil:
            the rows underneath belong to a listing that failed, and
            leaving them half-visible invites a double-click on a file
            that is gone with the folder.

            The two buttons appear only when the path is one of the user's
            bookmarks — for any other vanished folder there is nothing to
            offer beyond saying so.
        -->
        <Grid Visibility="{Binding IsMissingFolder, Converter={StaticResource BoolToVisibility}}"
              Background="{StaticResource EmptyStateBackground}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <TextBlock Text="{x:Static res:Strings.MissingFolderTitle}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextHeading}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding MissingFolderPath}"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="{StaticResource TextDim}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsMissingBookmark, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="{x:Static res:Strings.BookmarksLocate}"
                            Command="{Binding RelocateMissingBookmarkCommand}"
                            Padding="10,4" Margin="0,0,8,0"/>
                    <Button Content="{x:Static res:Strings.BookmarksRemove}"
                            Command="{Binding RemoveMissingBookmarkCommand}"
                            Padding="10,4"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        </Grid>
    </DockPanel>
</UserControl>
