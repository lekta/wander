<UserControl x:Class="Wander.App.Views.FileListView"
             x:Name="ListRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Wander.App.Converters"
             xmlns:controls="clr-namespace:Wander.App.Controls"
             xmlns:res="clr-namespace:Wander.App.Resources"
             Background="Transparent">
    <!--
        The file list, all display modes in one place.

        Everything that is "how a folder listing behaves" lives here:
        the three view containers, the gestures they share (selection,
        marquee, drag arming, inline rename, context-menu invocation) and
        the loading overlay. MainWindow keeps what surrounds it — the
        toolbar, the address bar, the trees, the drop pipeline — and talks
        to this control through a handful of methods and two events.

        Adding a fourth mode (gallery) means a container and a
        Visibility trigger here, not a change to the window.
    -->
    <UserControl.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
        <conv:RenameEditorVisibilityConverter x:Key="RenameVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!--
            Inline rename editor (A3). Every row template carries one of
            these, collapsed; MainViewModel.RenamingPath makes exactly one
            visible. Focus, the initial text and the "select the name, not
            the extension" selection are done from code-behind when the
            edit starts - a collapsed TextBox cannot take focus, so it has
            to happen after the visibility flips.
        -->
        <Style x:Key="RenameEditor" TargetType="TextBox">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Visibility">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource RenameVisibility}">
                        <Binding Path="FullPath"/>
                        <Binding Path="DataContext.RenamingPath" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewKeyDown" Handler="RenameBox_PreviewKeyDown"/>
            <EventSetter Event="PreviewTextInput" Handler="RenameBox_PreviewTextInput"/>
            <EventSetter Event="LostKeyboardFocus" Handler="RenameBox_LostKeyboardFocus"/>
        </Style>

        <!--
            Hidden entries are faded to opacity 0.55 — Explorer parity, and
            the same trigger is on the TreeViewItem style in MainWindow so
            drives and bookmarks match the file list.

            The System attribute deliberately gets no treatment of its own.
            It used to slant the label, and that turned out to say the wrong
            thing far too often: Windows sets +S on any folder carrying a
            desktop.ini, so an ordinary folder with a custom icon came out
            italic while Explorer showed it as the plain folder it is.

            FocusVisualStyle is nulled on every row container: WPF's default
            dashed rectangle draws on top of the selection background and
            reads as "double selection". Focus is still tracked semantically,
            so keyboard navigation is unaffected.
        -->
        <Style TargetType="DataGridRow">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <!--
            The tile container is exactly one cell: the panel arranges it at
            the cell rectangle, and the template inside draws at the size the
            same TileMetrics gave the panel. So the item's own chrome has to
            be nothing — a default ListBoxItem adds 4 px of padding and a 1 px
            border on each side, which is ten units the panel never budgeted
            for. The gap between tiles comes from the template's margin, which
            is part of the cell.
        -->
        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <!--
                Bare presenter, no chrome. The default template paints the
                selection across the whole container — and the container is
                the whole cell, so a run of selected files came out as one
                unbroken blue slab and you could not see how many files were
                in it. The highlight moves inside, onto the tile itself
                (TileHighlight), which is the cell minus its margin and
                therefore stops between neighbours the way Explorer's does.
            -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Hover and selection for one tile, drawn behind its content as a
            sibling rather than around it: an outline that took part in
            layout would eat two units off a cell whose size TileMetrics has
            already budgeted down to the pixel.

            Colours follow Explorer (#E5F3FB hover, #CCE8FF selected, #E8E8E8
            for a selection in a pane that lost focus — the same three the
            tree uses), the outlines a shade lighter than its: at tile size
            there are a lot of them on screen at once.
        -->
        <Style x:Key="TileHighlight" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="#E5F3FB"/>
                    <Setter Property="BorderBrush" Value="#D2ECF8"/>
                </DataTrigger>
                <!--
                    Selected, but the keyboard is somewhere else. Kept from
                    the default template we replaced above, and it doubles as
                    the answer to "which pane does the next Delete mean".
                -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="#E8E8E8"/>
                    <Setter Property="BorderBrush" Value="#DCDCDC"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                        <Condition Binding="{Binding (Selector.IsSelectionActive), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#CCE8FF"/>
                    <Setter Property="BorderBrush" Value="#AFD9F2"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#BFE0FA"/>
                    <Setter Property="BorderBrush" Value="#A5D3EE"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            The gesture set every mode shares. Kept as one style so a new
            container cannot silently miss half of them.
        -->
        <Style x:Key="ListGestures" TargetType="Control">
            <!--
                Пунктирная рамка вокруг всей области — это фокус на самом
                списке, а не на строке. WPF ставит его туда, когда строку
                сфокусировать не удалось (пустая папка, снятое выделение,
                перестроенный листинг). Что зона активна, и так видно по
                рамке FileListZone, а системный пунктир вокруг половины окна
                читается как поломка. Стрелки в этом состоянии оживляет
                TryEnterList в code-behind.
            -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="Selector.SelectionChanged" Handler="List_SelectionChanged"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="List_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="List_PreviewMouseLeftButtonUp"/>
            <EventSetter Event="PreviewMouseMove" Handler="List_PreviewMouseMove"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="List_PreviewMouseRightButtonDown"/>
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="List_PreviewMouseRightButtonUp"/>
            <EventSetter Event="PreviewKeyDown" Handler="List_PreviewKeyDown"/>
            <EventSetter Event="PreviewTextInput" Handler="List_PreviewTextInput"/>
            <EventSetter Event="MouseDoubleClick" Handler="List_MouseDoubleClick"/>
            <EventSetter Event="PreviewMouseWheel" Handler="List_PreviewMouseWheel"/>
            <!-- Только средняя кнопка: левая и правая разбираются выше
                 своими обработчиками, этот их не трогает. -->
            <EventSetter Event="PreviewMouseDown" Handler="List_PreviewMouseDown"/>
        </Style>

        <!--
            Tiles / LargeIcons share everything but their item template and
            their cell size.

            Scrolling is deliberately NOT set here. Each view owns its own
            scroller, because the policy differs per view and is part of what
            the view is: the tile views wrap, so horizontal scrolling is
            meaningless in them and is switched off; Details is a table and
            wants a horizontal bar the moment its columns outgrow the pane.
            One shared setter would make the next view inherit a policy
            nobody chose for it.
        -->
        <Style x:Key="TilePanel" TargetType="ListBox" BasedOn="{StaticResource ListGestures}">
            <Setter Property="ItemsSource" Value="{Binding Entries}"/>
            <Setter Property="SelectedItem" Value="{Binding SelectedEntry}"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <!--
                Containers are reused instead of rebuilt as cells scroll past
                — inflating the template was the single most expensive thing
                the UI thread did while scrolling.
            -->
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Details -->
        <DataGrid x:Name="DetailsView"
                  Style="{StaticResource ListGestures}"
                  Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Details}"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  ClipboardCopyMode="None"
                  AllowDrop="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  GridLinesVisibility="None" AlternatingRowBackground="#F7F7F7"
                  HeadersVisibility="Column"
                  Sorting="Details_Sorting"
                  RowHeight="{Binding Settings.DetailsRowHeight}">
            <DataGrid.Columns>
                <!--
                    Row height and icon size are this view's own settings
                    (PLAN A1) — Ctrl + wheel writes the same two fields, so
                    the gesture and the dialog cannot disagree. The column's
                    width is derived from the icon rather than settable: a
                    column narrower than its icon would just clip it.

                    That width is set from code-behind, not bound: a
                    DataGridColumn is not part of the visual tree, has no
                    DataContext of its own, and a RelativeSource binding on it
                    silently resolves to nothing. The bindings *inside*
                    CellTemplate are fine — those live in a realised cell.
                -->
                <DataGridTemplateColumn x:Name="IconColumn" Header="" IsReadOnly="True" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:AsyncIcon IconPath="{Binding FullPath}" IconSize="Normal"
                                                Width="{Binding DataContext.Settings.DetailsIconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Height="{Binding DataContext.Settings.DetailsIconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--
                    Name + the "has companions" marker. A template
                    column rather than a text one only because of
                    that marker; SortMemberPath keeps the header
                    behaving exactly as before.
                -->
                <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnName}" Width="*" SortMemberPath="Name" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource RenameVisibility}" ConverterParameter="Inverse">
                                            <Binding Path="FullPath"/>
                                            <Binding Path="DataContext.RenamingPath" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <TextBox Style="{StaticResource RenameEditor}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--
                    SortMemberPath carries the SortKey name rather than the
                    bound property: the grid never sorts anything itself
                    (Details_Sorting refuses), so this field is free to be
                    the identifier the view model understands.
                -->
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnType}" Binding="{Binding Kind}" Width="80" SortMemberPath="Type"/>
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnSize}" Binding="{Binding Size}" Width="100" SortMemberPath="Size"/>
                <DataGridTextColumn Header="{x:Static res:Strings.ColumnModified}" Binding="{Binding ModifiedUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="140" SortMemberPath="ModifiedDate"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Tiles -->
        <ListBox x:Name="TilesView"
                 Style="{StaticResource TilePanel}"
                 Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Tiles}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True">
            <!--
                CanContentScroll hands scrolling to the panel (it is the
                IScrollInfo). The vertical bar is automatic — a folder that
                fits shows no bar. The panel takes the bar into account
                itself (see VirtualizingWrapPanel.ColumnWidth): a wrap layout
                can want the bar at the full width and not want it at the
                narrower one, and left to the ScrollViewer alone those two
                answers chase each other.
            -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:VirtualizingWrapPanel CellWidth="{Binding Settings.TilesMetrics.CellWidth}"
                                                    CellHeight="{Binding Settings.TilesMetrics.CellHeight}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--
                        Size comes from the same TileMetrics the panel lays
                        out on, never from the content: a tile is one cell
                        minus its margin, whatever is inside it. The Padding
                        below mirrors TileMetrics.ForTiles' own padding — the
                        two have to stay equal, or the text loses a couple of
                        units to clipping.
                    -->
                    <Grid Width="{Binding DataContext.Settings.TilesMetrics.ContentWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Height="{Binding DataContext.Settings.TilesMetrics.ContentHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Margin="{Binding DataContext.Settings.TilesMetrics.Margin, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border Style="{StaticResource TileHighlight}"/>
                        <Border Padding="6" Background="Transparent">
                            <!--
                                Icon in a fixed column, text in what is left:
                                the name then trims against the tile's real
                                width, whatever the user set it to, instead of
                                against a magic number that only matched the
                                default width.
                            -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!--
                                    Medium, not Normal: a real thumbnail of the
                                    picture / the folder's contents where the
                                    shell has one, the plain extension icon where
                                    it has not. Details stays on Normal — at 20 px
                                    a photo is a smudge, and a folder of source
                                    would pay a per-file shell call for nothing.
                                -->
                                <controls:AsyncIcon Grid.Column="0"
                                                    IconPath="{Binding FullPath}" IconSize="Medium"
                                                    Width="{Binding DataContext.Settings.TilesMetrics.ImageSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Height="{Binding DataContext.Settings.TilesMetrics.ImageSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Margin="0,0,8,0" VerticalAlignment="Center"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    UseLayoutRounding="True"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   FontSize="{Binding DataContext.Settings.TilesMetrics.LabelFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource RenameVisibility}" ConverterParameter="Inverse">
                                                    <Binding Path="FullPath"/>
                                                    <Binding Path="DataContext.RenamingPath" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                        <TextBox Style="{StaticResource RenameEditor}"
                                                 FontSize="{Binding DataContext.Settings.TilesMetrics.LabelFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Grid>
                                    <TextBlock Foreground="#777" TextTrimming="CharacterEllipsis"
                                               FontSize="{Binding DataContext.Settings.TilesMetrics.SecondaryFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Run Text="{Binding Kind, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Large icons -->
        <ListBox x:Name="IconsView"
                 Style="{StaticResource TilePanel}"
                 Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=LargeIcons}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True">
            <!-- Same scroller policy as Tiles, and for the same reason. -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:VirtualizingWrapPanel CellWidth="{Binding Settings.IconsMetrics.CellWidth}"
                                                    CellHeight="{Binding Settings.IconsMetrics.CellHeight}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--
                        Every size here comes from IconsMetrics, which is
                        computed from Settings.LargeIcon* — the same value the
                        panel above lays out on, so the tile and the cell it
                        sits in cannot disagree, and the Settings dialog still
                        resizes tiles on the fly. The ItemTemplate's own
                        DataContext is the FileSystemEntry, so each binding
                        hops back up to the control's DataContext
                        (MainViewModel) via RelativeSource.
                    -->
                    <Grid HorizontalAlignment="Center"
                          Width="{Binding DataContext.Settings.IconsMetrics.ContentWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Height="{Binding DataContext.Settings.IconsMetrics.ContentHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Margin="{Binding DataContext.Settings.IconsMetrics.Margin, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border Style="{StaticResource TileHighlight}"/>
                        <StackPanel>
                            <controls:AsyncIcon IconPath="{Binding FullPath}" IconSize="Large"
                                                Width="{Binding DataContext.Settings.IconsMetrics.ImageSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Height="{Binding DataContext.Settings.IconsMetrics.ImageSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Margin="0,2,0,2"
                                                HorizontalAlignment="Center"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                UseLayoutRounding="True"/>
                            <Grid>
                                <TextBlock Text="{Binding Name}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Height="{Binding DataContext.Settings.IconsMetrics.LabelHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontSize="{Binding DataContext.Settings.IconsMetrics.LabelFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource RenameVisibility}" ConverterParameter="Inverse">
                                            <Binding Path="FullPath"/>
                                            <Binding Path="DataContext.RenamingPath" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <TextBox Style="{StaticResource RenameEditor}"
                                         FontSize="{Binding DataContext.Settings.IconsMetrics.LabelFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--
            Loading overlay for slow list enumerations (shell
            namespaces like Recycle Bin go through Shell.Application
            COM, which can take a noticeable fraction of a second).
            Z-ordered last so it sits on top of the three view
            containers; non-hit-testable so the user's clicks fall
            through to the empty list rather than the spinner.
        -->
        <Grid Visibility="{Binding IsListLoading, Converter={StaticResource BoolToVisibility}}"
              Background="#80FAFAFA"
              IsHitTestVisible="False">
            <Ellipse Width="32" Height="32" StrokeThickness="3"
                     Stroke="#0078D7" Fill="Transparent"
                     StrokeDashArray="3,2"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="ListSpinnerRotate" Angle="0"/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="ListSpinnerRotate"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </Grid>
    </Grid>
</UserControl>
