<Window x:Class="Wander.App.Views.FullscreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Wander.App.Views"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <!--
        Pictures on their own over the whole screen (PLAN Q5): Enter or Space
        on pictures in the gallery. A pane is the preview pane, with its own
        controller and without its footer - the hold-to-zoom, the helpers
        and the decode ahead come with it, and the stars and switches ride
        on the picture's bar. One picture, walked with the arrows; or two
        side by side, the second pane made in code on the first split and
        kept in column 1 (FullscreenWindow.Place). The pictures meet the
        screen's edges, with none of the pane's margin (PictureMargin), and
        the picture's bar is away until called for (BarAtRest). Z pins the
        1:1 zoom (PreviewPane.ToggleZoom). Esc and Enter close.
    -->
    <Grid x:Name="Room">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="SecondColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <views:PreviewPane x:Name="PaneA" BorderThickness="0" PictureMargin="0" BarAtRest="0"/>

        <!--
            What the status bar would say, for a warning or an error: the
            window covers it. A rating that could not be written, an undo
            that failed. For a few seconds, over the middle of the bottom
            edge; a click goes through it to the picture.
        -->
        <Border x:Name="Notice" Grid.ColumnSpan="2" Panel.ZIndex="1" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,48"
                Background="{StaticResource FullscreenNoticePlate}" CornerRadius="3" Padding="12,6">
            <TextBlock x:Name="NoticeText" Foreground="{StaticResource FullscreenNoticeText}"
                       FontSize="13" TextWrapping="Wrap" MaxWidth="720"/>
        </Border>
    </Grid>
</Window>
