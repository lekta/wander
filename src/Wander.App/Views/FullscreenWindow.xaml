<Window x:Class="Wander.App.Views.FullscreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Wander.App.Views"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <!--
        One picture over the whole screen (PLAN Q5): Enter or Space on a
        picture in the gallery. The pane is the preview pane, with its own
        controller and without its footer - the hold-to-zoom, the helpers
        and the decode ahead come with it. The arrows walk the pictures of
        the list; Esc and Enter close, and the list is left on the last one.
    -->
    <views:PreviewPane x:Name="Pane" BorderThickness="0"/>
</Window>
