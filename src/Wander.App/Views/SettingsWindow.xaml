<Window x:Class="Wander.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Wander.App.ViewModels"
        Title="Настройки Wander"
        Width="640" Height="460"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <!--
        Architecture: this window is a thin view over SettingsViewModel.
        Each SettingsCategoryViewModel subclass gets its own DataTemplate
        below; the right pane's ContentControl picks the right template
        by the type of `SelectedCategory`. Adding a new category means
        adding a new VM + a new DataTemplate here — nothing else needs
        to change.
    -->
    <Window.Resources>

        <!-- Reusable spacing values so the four sections look uniform. -->
        <Thickness x:Key="Row">0,4,0,4</Thickness>
        <Thickness x:Key="GroupHeader">0,0,0,8</Thickness>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="{StaticResource Row}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>


        <!-- General -->
        <DataTemplate DataType="{x:Type vm:GeneralSettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="Восстанавливать последнюю папку при запуске"
                          IsChecked="{Binding Owner.RestoreLastFolder}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0">
                    Когда выключено, Wander открывает первый доступный диск
                    вместо папки, в которой пользователь был перед закрытием.
                </TextBlock>
            </StackPanel>
        </DataTemplate>


        <!-- Safety -->
        <DataTemplate DataType="{x:Type vm:SafetySettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="Показывать скрытые файлы и папки"
                          IsChecked="{Binding Owner.ShowHidden}"/>
                <CheckBox Content="Показывать системные файлы и папки"
                          IsChecked="{Binding Owner.ShowSystem}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0">
                    Изменения применяются мгновенно: список файлов в текущей
                    папке перестраивается с учётом новых фильтров.
                </TextBlock>
            </StackPanel>
        </DataTemplate>


        <!-- Layout -->
        <DataTemplate DataType="{x:Type vm:LayoutSettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="Режим «Крупные значки»" FontWeight="SemiBold" Margin="{StaticResource GroupHeader}"/>

                <Grid Margin="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ширина ячейки (px)" Style="{StaticResource FieldLabel}" Grid.Column="0"/>
                    <TextBox Text="{Binding Owner.LargeIconCellWidth, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Размер иконки (px)" Style="{StaticResource FieldLabel}" Grid.Column="0"/>
                    <TextBox Text="{Binding Owner.LargeIconImageSize, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Отступ между ячейками (px)" Style="{StaticResource FieldLabel}" Grid.Column="0"/>
                    <TextBox Text="{Binding Owner.LargeIconMargin, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Размер шрифта подписи" Style="{StaticResource FieldLabel}" Grid.Column="0"/>
                    <TextBox Text="{Binding Owner.LargeIconLabelFontSize, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" HorizontalAlignment="Left"/>
                </Grid>

                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,12,0,0">
                    Значения зажимаются в разумные пределы автоматически.
                    Стандартные: 100 / 72 / 2 / 12.
                </TextBlock>
            </StackPanel>
        </DataTemplate>


        <!-- Bookmarks -->
        <DataTemplate DataType="{x:Type vm:BookmarksSettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="Показывать «Загрузки»"
                          IsChecked="{Binding Owner.ShowBookmarkDownloads}"/>
                <CheckBox Content="Показывать «Документы»"
                          IsChecked="{Binding Owner.ShowBookmarkDocuments}"/>
                <CheckBox Content="Показывать «Изображения»"
                          IsChecked="{Binding Owner.ShowBookmarkPictures}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0">
                    Спец-папки появляются в верхней панели слева. Любую папку
                    можно добавить туда перетаскиванием. «Корзину» добавим
                    отдельным шагом, когда появится shell-namespace.
                </TextBlock>
            </StackPanel>
        </DataTemplate>


        <!-- Debug -->
        <DataTemplate DataType="{x:Type vm:DebugSettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="Показывать меню «Debug» в главном меню"
                          IsChecked="{Binding Owner.ShowDebugMenu}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0">
                    Когда выключено, в основном меню больше не появится пункт
                    «Debug» (включая «Logs»). Чтобы вернуть, открой этот
                    раздел настроек снова — он остаётся доступен независимо
                    от состояния флажка.
                </TextBlock>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>
        <!-- Bottom button row -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Закрыть" Padding="14,4" IsCancel="True" IsDefault="True" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: category list. ListBox today; will swap to TreeView
                 if/when a category gains nested subsections. -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}"
                     DisplayMemberPath="Title"
                     BorderThickness="0,0,1,0"
                     BorderBrush="#DDD"
                     Background="#FAFAFA"
                     Padding="0,8,0,0"/>

            <!-- Right: content area selected by SelectedCategory's type. -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <ContentControl Content="{Binding SelectedCategory}"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
