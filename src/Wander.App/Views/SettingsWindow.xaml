<Window x:Class="Wander.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Wander.App.ViewModels"
        xmlns:conv="clr-namespace:Wander.App.Converters"
        xmlns:res="clr-namespace:Wander.App.Resources"
        Title="{x:Static res:Strings.SettingsTitle}"
        Width="640" Height="460"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <!--
        Architecture: this window is a thin view over SettingsViewModel.
        Each SettingsCategoryViewModel subclass gets its own DataTemplate
        below; the right pane's ContentControl picks the right template
        by the type of `SelectedCategory`. Adding a new category means
        adding a new VM + a new DataTemplate here — nothing else needs
        to change.
    -->
    <Window.Resources>

        <conv:EnumRadioConverter x:Key="EnumRadio"/>

        <!-- Reusable spacing values so the four sections look uniform. -->
        <Thickness x:Key="Row">0,4,0,4</Thickness>
        <Thickness x:Key="GroupHeader">0,0,0,8</Thickness>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="{StaticResource Row}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>


        <!-- General -->
        <DataTemplate DataType="{x:Type vm:GeneralSettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="{x:Static res:Strings.SettingsRestoreLastFolder}"
                          IsChecked="{Binding Owner.RestoreLastFolder}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{x:Static res:Strings.SettingsRestoreLastFolderHint}"/>

                <CheckBox Content="{x:Static res:Strings.SettingsAutoRefresh}"
                          IsChecked="{Binding Owner.AutoRefresh}" Margin="0,18,0,4"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap"
                           Text="{x:Static res:Strings.SettingsAutoRefreshHint}"/>
            </StackPanel>
        </DataTemplate>


        <!-- Safety -->
        <DataTemplate DataType="{x:Type vm:SafetySettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="{x:Static res:Strings.SettingsShowHidden}"
                          IsChecked="{Binding Owner.ShowHidden}"/>
                <CheckBox Content="{x:Static res:Strings.SettingsShowSystem}"
                          IsChecked="{Binding Owner.ShowSystem}"/>
                <CheckBox Content="{x:Static res:Strings.SettingsHideSystemRootFolders}"
                          ToolTip="{x:Static res:Strings.SettingsHideSystemRootFoldersHint}"
                          IsChecked="{Binding Owner.HideSystemRootFolders}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{x:Static res:Strings.SettingsHiddenHint}"/>
            </StackPanel>
        </DataTemplate>


        <!-- File operations -->
        <DataTemplate DataType="{x:Type vm:FileOperationsSettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="{x:Static res:Strings.SettingsConfirmRecycle}"
                          IsChecked="{Binding Owner.ConfirmRecycle}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{x:Static res:Strings.SettingsConfirmRecycleHint}"/>
            </StackPanel>
        </DataTemplate>


        <!-- Companions ("integrated items") -->
        <DataTemplate DataType="{x:Type vm:CompanionsSettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="{x:Static res:Strings.SettingsIntegrateCompanions}"
                          IsChecked="{Binding Owner.IntegrateCompanions}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{x:Static res:Strings.SettingsCompanionsHint}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{x:Static res:Strings.SettingsCompanionsOffHint}"/>
            </StackPanel>
        </DataTemplate>


        <!-- Layout.
             One group per view: each one owns its own sizes, because what
             makes a comfortable table is not what makes a comfortable grid
             of photographs. Ctrl + wheel over the list writes these same
             fields, so the gesture and the dialog cannot drift apart. -->
        <DataTemplate DataType="{x:Type vm:LayoutSettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="{x:Static res:Strings.SettingsDetailsGroup}" FontWeight="SemiBold" Margin="{StaticResource GroupHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="{StaticResource Row}"
                               Text="{x:Static res:Strings.SettingsRowHeight}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="{StaticResource Row}" HorizontalAlignment="Left"
                             Text="{Binding Owner.DetailsRowHeight, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="{StaticResource Row}"
                               Text="{x:Static res:Strings.SettingsIconSize}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="{StaticResource Row}" HorizontalAlignment="Left"
                             Text="{Binding Owner.DetailsIconSize, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBlock Text="{x:Static res:Strings.SettingsTilesGroup}" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="{StaticResource Row}"
                               Text="{x:Static res:Strings.SettingsTileWidth}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="{StaticResource Row}" HorizontalAlignment="Left"
                             Text="{Binding Owner.TileCellWidth, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="{StaticResource Row}"
                               Text="{x:Static res:Strings.SettingsIconSize}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="{StaticResource Row}" HorizontalAlignment="Left"
                             Text="{Binding Owner.TileIconSize, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="{StaticResource Row}"
                               Text="{x:Static res:Strings.SettingsLabelFontSize}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="{StaticResource Row}" HorizontalAlignment="Left"
                             Text="{Binding Owner.TileLabelFontSize, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBlock Text="{x:Static res:Strings.SettingsLargeIconsGroup}" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="{StaticResource Row}"
                               Text="{x:Static res:Strings.SettingsCellWidth}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="{StaticResource Row}" HorizontalAlignment="Left"
                             Text="{Binding Owner.LargeIconCellWidth, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="{StaticResource Row}"
                               Text="{x:Static res:Strings.SettingsIconSize}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="{StaticResource Row}" HorizontalAlignment="Left"
                             Text="{Binding Owner.LargeIconImageSize, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="{StaticResource Row}"
                               Text="{x:Static res:Strings.SettingsCellMargin}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="{StaticResource Row}" HorizontalAlignment="Left"
                             Text="{Binding Owner.LargeIconMargin, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="{StaticResource Row}"
                               Text="{x:Static res:Strings.SettingsLabelFontSize}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="{StaticResource Row}" HorizontalAlignment="Left"
                             Text="{Binding Owner.LargeIconLabelFontSize, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,16,0,0"
                           Text="{x:Static res:Strings.SettingsZoomHint}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{x:Static res:Strings.SettingsLayoutHint}"/>
            </StackPanel>
        </DataTemplate>


        <!-- Gallery.
             Its own page rather than a fourth group under Layout: only half
             of what is here is a size. The background is a viewing decision
             and the sidecar format is a decision about other programs'
             files, and neither belongs under a heading that says "layout". -->
        <DataTemplate DataType="{x:Type vm:GallerySettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>

                <CheckBox Content="{x:Static res:Strings.SettingsAutoGallery}"
                          IsChecked="{Binding Owner.AutoGallery}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="{x:Static res:Strings.SettingsAutoGalleryHint}"/>

                <TextBlock Text="{x:Static res:Strings.SettingsGalleryBackground}" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="GalleryBackground" Margin="0,0,16,0"
                                 Content="{x:Static res:Strings.GalleryBackgroundLight}"
                                 IsChecked="{Binding Owner.GalleryBackground, Converter={StaticResource EnumRadio}, ConverterParameter=Light}"/>
                    <RadioButton GroupName="GalleryBackground" Margin="0,0,16,0"
                                 Content="{x:Static res:Strings.GalleryBackgroundGrey}"
                                 IsChecked="{Binding Owner.GalleryBackground, Converter={StaticResource EnumRadio}, ConverterParameter=Grey}"/>
                    <RadioButton GroupName="GalleryBackground"
                                 Content="{x:Static res:Strings.GalleryBackgroundDark}"
                                 IsChecked="{Binding Owner.GalleryBackground, Converter={StaticResource EnumRadio}, ConverterParameter=Dark}"/>
                </StackPanel>

                <TextBlock Text="{x:Static res:Strings.SettingsGalleryGroup}" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="{StaticResource Row}"
                               Text="{x:Static res:Strings.SettingsCellWidth}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="{StaticResource Row}" HorizontalAlignment="Left"
                             Text="{Binding Owner.GalleryCellWidth, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="{StaticResource Row}"
                               Text="{x:Static res:Strings.SettingsIconSize}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="{StaticResource Row}" HorizontalAlignment="Left"
                             Text="{Binding Owner.GalleryImageSize, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="{StaticResource Row}"
                               Text="{x:Static res:Strings.SettingsCellMargin}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="{StaticResource Row}" HorizontalAlignment="Left"
                             Text="{Binding Owner.GalleryMargin, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="{StaticResource Row}"
                               Text="{x:Static res:Strings.SettingsLabelFontSize}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="{StaticResource Row}" HorizontalAlignment="Left"
                             Text="{Binding Owner.GalleryLabelFontSize, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBlock Text="{x:Static res:Strings.SettingsRatingGroup}" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <TextBlock Text="{x:Static res:Strings.SettingsRawRatingFormat}" Margin="0,0,0,6"/>
                <RadioButton GroupName="RawRatingFormat" Margin="0,0,0,4"
                             Content="{x:Static res:Strings.SettingsRawRatingFormatXmp}"
                             IsChecked="{Binding Owner.RawRatingFormat, Converter={StaticResource EnumRadio}, ConverterParameter=Xmp}"/>
                <RadioButton GroupName="RawRatingFormat"
                             Content="{x:Static res:Strings.SettingsRawRatingFormatPp3}"
                             IsChecked="{Binding Owner.RawRatingFormat, Converter={StaticResource EnumRadio}, ConverterParameter=Pp3}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{x:Static res:Strings.SettingsRawRatingFormatHint}"/>
            </StackPanel>
        </DataTemplate>


        <!-- Thumbnails -->
        <DataTemplate DataType="{x:Type vm:ThumbnailsSettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>

                <CheckBox Content="{x:Static res:Strings.SettingsThumbnailDiskCache}"
                          IsChecked="{Binding Owner.ThumbnailDiskCacheEnabled}"/>

                <Grid Margin="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.SettingsThumbnailDiskMb}" Style="{StaticResource FieldLabel}" Grid.Column="0"/>
                    <TextBox Text="{Binding Owner.ThumbnailDiskCacheMb, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Column="1" HorizontalAlignment="Left"
                             IsEnabled="{Binding Owner.ThumbnailDiskCacheEnabled}"/>
                </Grid>

                <Grid Margin="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.SettingsThumbnailMemory}" Style="{StaticResource FieldLabel}" Grid.Column="0"/>
                    <TextBox Text="{Binding Owner.ThumbnailMemoryEntries, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Column="1" HorizontalAlignment="Left"/>
                </Grid>

                <TextBlock Text="{Binding Owner.ThumbnailCacheStatus}"
                           Foreground="#666" TextWrapping="Wrap" Margin="0,12,0,0"/>

                <Button Content="{x:Static res:Strings.SettingsClearCache}" Padding="14,4" Width="140"
                        HorizontalAlignment="Left" Margin="0,8,0,0"
                        Click="ClearThumbnails_Click"/>

                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="{x:Static res:Strings.SettingsThumbnailsHint}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{x:Static res:Strings.SettingsThumbnailsLimitsHint}"/>
            </StackPanel>
        </DataTemplate>


        <!-- Bookmarks -->
        <DataTemplate DataType="{x:Type vm:BookmarksSettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="{x:Static res:Strings.SettingsBookmarkDownloads}"
                          IsChecked="{Binding Owner.ShowBookmarkDownloads}"/>
                <CheckBox Content="{x:Static res:Strings.SettingsBookmarkDocuments}"
                          IsChecked="{Binding Owner.ShowBookmarkDocuments}"/>
                <CheckBox Content="{x:Static res:Strings.SettingsBookmarkPictures}"
                          IsChecked="{Binding Owner.ShowBookmarkPictures}"/>
                <CheckBox Content="{x:Static res:Strings.SettingsBookmarkRecycleBin}"
                          IsChecked="{Binding Owner.ShowBookmarkRecycleBin}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{x:Static res:Strings.SettingsBookmarksHint}"/>
            </StackPanel>
        </DataTemplate>


        <!-- Context menu.
             Two checkbox lists over the same MenuToggleViewModel: what the
             shell contributes, and what Wander contributes. The first is
             discovered (it fills in as menus are opened), the second is
             fixed and comes from ContextMenuCatalog. -->
        <DataTemplate x:Key="MenuToggleTemplate" DataType="{x:Type vm:MenuToggleViewModel}">
            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsEnabled}" Margin="0,2,0,2"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ContextMenuSettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>

                <CheckBox Content="{x:Static res:Strings.SettingsShellExtensions}"
                          IsChecked="{Binding Owner.ShellExtensionsEnabled}"/>
                <TextBlock Text="{x:Static res:Strings.SettingsShellExtensionsGroup}" FontWeight="SemiBold" Margin="0,14,0,4"/>
                <ItemsControl ItemsSource="{Binding Owner.ShellExtensionToggles}"
                              ItemTemplate="{StaticResource MenuToggleTemplate}"
                              IsEnabled="{Binding Owner.ShellExtensionsEnabled}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="{x:Static res:Strings.SettingsShellExtensionsHint}"/>

                <TextBlock Text="{x:Static res:Strings.SettingsOwnItemsGroup}" FontWeight="SemiBold" Margin="0,18,0,4"/>
                <ItemsControl ItemsSource="{Binding Owner.MenuItemToggles}"
                              ItemTemplate="{StaticResource MenuToggleTemplate}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="{x:Static res:Strings.SettingsOwnItemsHint}"/>
            </StackPanel>
        </DataTemplate>


        <!-- Debug -->
        <DataTemplate DataType="{x:Type vm:DebugSettingsCategory}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                <CheckBox Content="{x:Static res:Strings.SettingsShowDebugMenu}"
                          IsChecked="{Binding Owner.ShowDebugMenu}"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{x:Static res:Strings.SettingsDebugHint}"/>

                <!-- Сброс живёт здесь, а не в строке кнопок диалога: он нужен
                     раз в год, а места рядом с ОК / Применить / Отмена
                     занимал столько же, сколько они. -->
                <TextBlock Text="{x:Static res:Strings.SettingsResetGroup}" FontWeight="SemiBold" Margin="0,24,0,4"/>
                <Button Content="{x:Static res:Strings.SettingsResetAll}" Padding="14,4" Width="140"
                        HorizontalAlignment="Left" Click="Reset_Click"/>
                <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="{x:Static res:Strings.SettingsResetHint}"/>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>
        <!-- Bottom button row.
             Order: OK · Применить · Отмена — OK закоммитит и закроет, Применить
             закоммитит без закрытия, Отмена откатит изменения и закроет.
             Baseline для отката снимается в Loaded в code-behind. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.ActionOk}" Padding="14,4" Width="92" Margin="0,0,8,0"
                        IsDefault="True" Click="Ok_Click"/>
                <Button Content="{x:Static res:Strings.ActionApply}" Padding="14,4" Width="92" Margin="0,0,8,0"
                        Click="Apply_Click"/>
                <Button Content="{x:Static res:Strings.ActionCancel}" Padding="14,4" Width="92"
                        IsCancel="True" Click="Cancel_Click"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: category list. ListBox today; will swap to TreeView
                 if/when a category gains nested subsections. -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}"
                     DisplayMemberPath="Title"
                     BorderThickness="0,0,1,0"
                     BorderBrush="#DDD"
                     Background="#FAFAFA"
                     Padding="0,8,0,0"/>

            <!-- Right: content area selected by SelectedCategory's type. -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <ContentControl Content="{Binding SelectedCategory}"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
