<UserControl x:Class="Wander.App.Controls.FilterBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Wander.App.Controls"
             xmlns:res="clr-namespace:Wander.App.Resources">
    <!--
        The box and two things laid over it: the prompt while it is empty,
        the cross while it is not. Over the box rather than beside it, the
        way the main window's search box does it, so the field still looks
        like one control; the right padding keeps the caret out from under
        the cross. The text is text: the settings pages' number-field
        behaviour is switched off, or a wheel over the page would pull it.
    -->
    <UserControl.Resources>
        <!-- The glyph button of Controls.xaml, with the arrow cursor over the box's I-beam. -->
        <Style x:Key="ClearGlyph" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
            <Setter Property="Cursor" Value="Arrow"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:FilterBox}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <TextBox x:Name="Box"
                 Text="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:FilterBox}, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{Binding Prompt, RelativeSource={RelativeSource AncestorType=controls:FilterBox}}"
                 controls:NumericField.Enabled="False"
                 Padding="6,4,26,4"
                 PreviewKeyDown="Box_PreviewKeyDown"/>
        <TextBlock Text="{Binding Prompt, RelativeSource={RelativeSource AncestorType=controls:FilterBox}}"
                   Foreground="{DynamicResource TextPlaceholder}"
                   Margin="8,0,26,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:FilterBox}}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Button Content="&#x2715;" Style="{StaticResource ClearGlyph}"
                HorizontalAlignment="Right" Margin="0,3,3,3"
                ToolTip="{x:Static res:Strings.FieldClear}"
                Click="Clear_Click"/>
    </Grid>
</UserControl>
