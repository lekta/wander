<Window x:Class="Wander.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Wander.App.ViewModels"
        xmlns:conv="clr-namespace:Wander.App.Converters"
        Title="Wander" Height="700" Width="1100">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <conv:IconConverter x:Key="IconConverter"/>
        <conv:ViewModeToVisibilityConverter x:Key="ViewModeToVisibility"/>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding BackCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Right" Command="{Binding ForwardCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Up" Command="{Binding UpCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopyCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="X" Command="{Binding CutCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="V" Command="{Binding PasteCommand}"/>
    </Window.InputBindings>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Command="{Binding BackCommand}" ToolTip="Back (Alt+Left)">&#x2190;</Button>
                <Button Command="{Binding ForwardCommand}" ToolTip="Forward (Alt+Right)">&#x2192;</Button>
                <Button Command="{Binding UpCommand}" ToolTip="Up (Alt+Up)">&#x2191;</Button>
                <Separator/>
                <Button Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)">&#x21BB;</Button>
                <Separator/>
                <Button Command="{Binding NewFolderCommand}">New folder</Button>
                <Separator/>
                <Button Command="{Binding ToggleViewModeCommand}"
                        Content="{Binding ViewMode, StringFormat='View: {0}'}"
                        ToolTip="Toggle Details / Large icons"/>
            </ToolBar>
            <ToolBar>
                <TextBox Width="600" VerticalAlignment="Center"
                         Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding NavigateCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Command="{Binding NavigateCommand}">Go</Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock Text="{Binding Status}"/></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="Tree" Grid.Column="0"
                      ItemsSource="{Binding Roots}"
                      SelectedItemChanged="Tree_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding FullPath, Converter={StaticResource IconConverter}, ConverterParameter=Small}"
                                   Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDD"/>

            <!-- Right pane: details vs. large icons. -->
            <Grid Grid.Column="2">
                <!-- Details (DataGrid) -->
                <DataGrid x:Name="Grid"
                          Visibility="{Binding ViewMode, Converter={StaticResource ViewModeToVisibility}, ConverterParameter=Details}"
                          ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          MouseDoubleClick="Grid_MouseDoubleClick"
                          GridLinesVisibility="None" AlternatingRowBackground="#F7F7F7"
                          HeadersVisibility="Column" RowHeight="24">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="28" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding FullPath, Converter={StaticResource IconConverter}, ConverterParameter=Normal}"
                                           Width="20" Height="20"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100"/>
                        <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Command="{Binding OpenCommand}"/>
                            <Separator/>
                            <MenuItem Header="Cut" Command="{Binding CutCommand}" InputGestureText="Ctrl+X"/>
                            <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C"/>
                            <MenuItem Header="Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V"/>
                            <Separator/>
                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGestureText="Del"/>
                            <MenuItem Header="Rename" Click="Rename_Click"/>
                            <Separator/>
                            <MenuItem Header="New folder" Command="{Binding NewFolderCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- Large icons (ListBox with WrapPanel) -->
                <ListBox x:Name="Tiles"
                         Visibility="{Binding ViewMode, Converter={StaticResource ViewModeToVisibility}, ConverterParameter=LargeIcons}"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="Tiles_MouseDoubleClick"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="120" Margin="8" HorizontalAlignment="Center">
                                <Image Source="{Binding FullPath, Converter={StaticResource IconConverter}, ConverterParameter=Large}"
                                       Width="96" Height="96" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Name}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxHeight="36"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Command="{Binding OpenCommand}"/>
                            <Separator/>
                            <MenuItem Header="Cut" Command="{Binding CutCommand}" InputGestureText="Ctrl+X"/>
                            <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C"/>
                            <MenuItem Header="Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V"/>
                            <Separator/>
                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGestureText="Del"/>
                            <MenuItem Header="Rename" Click="Rename_Click"/>
                            <Separator/>
                            <MenuItem Header="New folder" Command="{Binding NewFolderCommand}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
