<Window x:Class="Wander.App.MainWindow"
        x:Name="WanderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Wander.App.ViewModels"
        xmlns:conv="clr-namespace:Wander.App.Converters"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:views="clr-namespace:Wander.App.Views"
        xmlns:res="clr-namespace:Wander.App.Resources"
        Title="{Binding WindowTitle}"
        Icon="Assets\app.ico"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>
        <conv:BitmapPixelSizeConverter x:Key="BitmapPixelSize"/>
        <conv:RankStarConverter x:Key="RankStar"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!--
            One star of the .pp3 rating widget. Five copies of this in the
            preview footer, each with its own CommandParameter; clicking the
            star that already marks the rating clears it.
        -->
        <Style x:Key="RatingStar" TargetType="Button">
            <Setter Property="Command" Value="{Binding Preview.SetRankCommand}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource RatingStar}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Preview.RatingSource, StringFormat='Rating, written to {0}'}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            One colour-label swatch. The chosen one gets a ring rather than a
            different fill — the fill *is* the information, so it must not
            change to indicate selection.
        -->
        <Style x:Key="ColorLabelSwatch" TargetType="Button">
            <Setter Property="Command" Value="{Binding DataContext.Preview.SetColorLabelCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="2">
                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource SwatchRing}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="{StaticResource ControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Breadcrumb segment: the ToolbarButton look (flat, highlight on
            hover) at text size, so the path reads as plain text until the
            mouse says otherwise.
        -->
        <Style x:Key="CrumbButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>

        <!--
            The glyphs that sit inside the search box. Templated flat rather
            than merely restyled: an ordinary WPF button dropped into a text
            field reads as a second control with its own border, and the box
            has to look like one field with affordances in it.
        -->
        <Style x:Key="BoxGlyphButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
        <KeyBinding Modifiers="Shift" Key="Delete" Command="{Binding PermanentDeleteCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="Back" Command="{Binding UpCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopyCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="X" Command="{Binding CutCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="V" Command="{Binding PasteCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="C" Command="{Binding CopyPathCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="N" Command="{Binding NewFolderCommand}"/>
        <!--
            The Alt chords (Alt+←/→/↑, Alt+Enter, Alt+D) are not here: the
            Menu in the toolbar swallows them before command routing, so
            they live in MainWindow.OnPreviewKeyDown instead.
        -->
        <KeyBinding Modifiers="Ctrl" Key="Q" Command="{Binding TogglePreviewCommand}"/>
        <!--
            View modes on the digits Explorer uses for them: its list runs
            from extra-large icons (1) to Content (8), and our three views
            sit at the positions of the ones they match. Binding the spare
            digits as well would promise icon sizes we do not have.
        -->
        <KeyBinding Modifiers="Ctrl+Shift" Key="D1" Command="{Binding SetViewModeCommand}" CommandParameter="Gallery"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="D2" Command="{Binding SetViewModeCommand}" CommandParameter="LargeIcons"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="D6" Command="{Binding SetViewModeCommand}" CommandParameter="Details"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="D7" Command="{Binding SetViewModeCommand}" CommandParameter="Tiles"/>
    </Window.InputBindings>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="{StaticResource ChromeBackground}">
            <StackPanel x:Name="NavToolbar" Orientation="Horizontal" DockPanel.Dock="Left" Margin="4,4,8,4">
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding BackCommand}" ToolTip="{x:Static res:Strings.NavBack}"
                        Width="28" Height="28" Margin="2,0" Content="&#x2190;"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ForwardCommand}" ToolTip="{x:Static res:Strings.NavForward}"
                        Width="28" Height="28" Margin="2,0" Content="&#x2192;"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding UpCommand}" ToolTip="{x:Static res:Strings.NavUp}"
                        Width="28" Height="28" Margin="2,0" Content="&#x2191;"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,4,4,4">
                <Menu VerticalAlignment="Center">
                    <MenuItem Padding="10,4">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static res:Strings.MenuView}"/>
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Margin="6,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Header="{x:Static res:Strings.MenuViewDetails}"
                                  InputGestureText="Ctrl+Shift+6"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Details}"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="Details"/>
                        <MenuItem Header="{x:Static res:Strings.MenuViewTiles}"
                                  InputGestureText="Ctrl+Shift+7"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Tiles}"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="Tiles"/>
                        <MenuItem Header="{x:Static res:Strings.MenuViewLargeIcons}"
                                  InputGestureText="Ctrl+Shift+2"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=LargeIcons}"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="LargeIcons"/>
                        <!--
                            Gallery takes Ctrl+Shift+1, the slot Explorer
                            gives its extra-large icons: it is the same end
                            of the same scale, and the digits stay a scale
                            rather than an arbitrary list.
                        -->
                        <MenuItem Header="{x:Static res:Strings.MenuViewGallery}"
                                  InputGestureText="Ctrl+Shift+1"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Gallery}"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="Gallery"/>
                        <!--
                            The gallery background is not here on purpose. It
                            is the control you reach for while looking at the
                            photographs — to see the same frame on grey and
                            then on black — and three clicks into a menu for
                            something you flip back and forth is three clicks
                            too many. It lives on the strip above the list,
                            next to the filter, where both are one click from
                            the pictures they are about.
                        -->
                        <Separator/>
                        <!--
                            Sort by submenu. The four columns mirror the Details
                            view. Clicking the active column toggles direction
                            (Explorer parity, handled in MainViewModel.SetSortKey).
                            Ascending/GroupFoldersFirst sit below as separate
                            toggles so the user can flip them without changing
                            the column.
                        -->
                        <MenuItem Header="{x:Static res:Strings.MenuSortBy}">
                            <MenuItem Header="{x:Static res:Strings.MenuSortName}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Name}"
                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Name"/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortDate}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=ModifiedDate}"
                                      Command="{Binding SetSortKeyCommand}" CommandParameter="ModifiedDate"/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortSize}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Size}"
                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Size"/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortType}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Type}"
                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Type"/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortRating}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Rating}"
                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Rating"/>
                            <Separator/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortAscending}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortAscending, Mode=OneWay}"
                                      Command="{Binding ToggleSortAscendingCommand}"/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortFoldersFirst}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.GroupFoldersFirst, Mode=OneWay}"
                                      Command="{Binding ToggleGroupFoldersFirstCommand}"/>
                        </MenuItem>
                        <Separator/>
                        <!--
                            Preview pane and Refresh live here rather than in
                            the "..." menu: both are about what the file list
                            is showing right now, which is what this menu is.
                        -->
                        <MenuItem Header="{x:Static res:Strings.MenuQuickPreview}"
                                  InputGestureText="Ctrl+Q"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsPreviewVisible, Mode=TwoWay}"/>
                        <MenuItem Header="{x:Static res:Strings.MenuRefresh}"
                                  InputGestureText="F5"
                                  Command="{Binding RefreshCommand}"/>
                    </MenuItem>
                </Menu>

                <Border Width="12"/>

                <!--
                    The application menu. Four rows and one divider: the two
                    things that are about the app rather than about the files
                    (settings, the project itself), the debug drawer, and the
                    way out. Everything that acts on what is on screen lives
                    in "Вид" or in the context menu, next to what it acts on.
                -->
                <Menu VerticalAlignment="Center">
                    <MenuItem Padding="10,4">
                        <MenuItem.Header>
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </MenuItem.Header>
                        <MenuItem Header="{x:Static res:Strings.MenuOptions}" Command="{Binding OptionsCommand}"/>
                        <MenuItem Header="{x:Static res:Strings.MenuAbout}">
                            <MenuItem Header="{x:Static res:Strings.MenuReportIssue}"
                                      Command="{Binding ReportIssueCommand}"
                                      ToolTip="{x:Static res:Strings.MenuReportIssueHint}"/>
                            <MenuItem Header="{x:Static res:Strings.MenuHelp}"
                                      Command="{Binding HelpCommand}"
                                      ToolTip="{x:Static res:Strings.MenuHelpHint}"/>
                            <Separator/>
                            <!--
                                A caption, not a command: greying it out would
                                read as "broken", so it keeps the label colour
                                of a gesture hint and simply takes no input.
                            -->
                            <MenuItem Header="{Binding VersionLabel}"
                                      Foreground="{StaticResource MenuForegroundGesture}"
                                      Focusable="False" IsHitTestVisible="False"/>
                        </MenuItem>
                        <MenuItem Header="{x:Static res:Strings.MenuDebug}"
                                  Visibility="{Binding Settings.ShowDebugMenu, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem Header="{x:Static res:Strings.MenuLogs}"
                                      Command="{Binding OpenLogFileCommand}"
                                      ToolTip="{x:Static res:Strings.MenuLogsHint}"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{x:Static res:Strings.MenuExit}" Command="{Binding ExitCommand}"/>
                    </MenuItem>
                </Menu>
            </StackPanel>

            <!--
                Search box. DockPanel.Dock="Right" placed AFTER the right-side
                menus = sits to their LEFT, i.e. immediately to the right of the
                address bar. Grid hosts a placeholder TextBlock overlaid on the
                TextBox; the placeholder's visibility flips on HasSearchQuery.
            -->
            <!--
                Hidden while the search window is open: the same criteria in
                two places is how one of them ends up stale, and the window
                is the one that can show all of them.
            -->
            <Grid DockPanel.Dock="Right"
                  Width="250" VerticalAlignment="Center"
                  Margin="0,4,4,4"
                  Visibility="{Binding IsSearchWindowOpen, Converter={StaticResource InverseBoolToVisibility}}">
                <!--
                    The two glyphs overlay the box rather than sitting in
                    columns beside it: the field has to keep the whole width
                    so it still looks like one control, and the TextBox's
                    right padding is what keeps the caret out from under
                    them.
                -->
                <TextBox x:Name="SearchBox"
                         Padding="6,4,48,4"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static res:Strings.SearchHint}"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                <TextBlock Text="{x:Static res:Strings.SearchPlaceholder}"
                           Foreground="{StaticResource TextPlaceholder}"
                           Margin="8,0,50,0"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSearchQuery}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,3,0">
                    <!--
                        Stop replaces Clear while a pass is walking the disk:
                        the same spot, because they answer the same impulse —
                        "that is not what I meant, undo it".
                    -->
                    <Button Content="&#x25A0;" Style="{StaticResource BoxGlyphButton}"
                            Command="{Binding StopSearchCommand}"
                            ToolTip="{x:Static res:Strings.SearchStop}"
                            Visibility="{Binding ContentSearch.IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="&#x2715;"
                            Command="{Binding ClearSearchCommand}"
                            ToolTip="{x:Static res:Strings.SearchClear}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BoxGlyphButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSearchQuery}" Value="True"/>
                                            <Condition Binding="{Binding ContentSearch.IsRunning}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!--
                        Marked when the search window holds something other
                        than the two text criteria — subfolders, the whole
                        machine, binaries. Those do not fit in the box's own
                        text, and a list narrowed by a switch set in a window
                        that is now closed has to say so somewhere.
                    -->
                    <Button Content="&#x22EE;"
                            FontSize="13"
                            Click="SearchOptions_Click"
                            ToolTip="{x:Static res:Strings.SearchOptions}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BoxGlyphButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ContentSearch.HasNonDefaultOptions}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

            </Grid>

            <!--
                Address bar — one strip with two faces:
                  * breadcrumbs (default): every folder of the current path is
                    a flat button that lights up on hover, click = go there;
                  * text box (edit mode): the raw path, for typing or pasting.
                Entered by Ctrl+L or a click on the empty space of the strip,
                left by Esc / focus loss / a successful navigation.
                The chevron on the right drops down the recently visited
                folders (F4 toggles it — Explorer parity).
            -->
            <!--
                The whole strip switches to the editable path on a click
                that misses a crumb — handled here, on the outer border, in
                the tunnelling phase. It used to hang off the inner border
                behind the breadcrumbs, which left the strip's own padding
                and the gap under the crumb row dead to the click.
            -->
            <Border x:Name="AddressBar"
                    VerticalAlignment="Center" Margin="0,4,4,4" MinHeight="26"
                    Background="{StaticResource InputBackground}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1"
                    PreviewMouseLeftButtonDown="AddressBar_PreviewMouseLeftButtonDown">
                <DockPanel>
                    <ToggleButton x:Name="RecentToggle" DockPanel.Dock="Right"
                                  Width="22" Focusable="False"
                                  ToolTip="{x:Static res:Strings.RecentFoldersHint}"
                                  Background="Transparent">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <TextBlock Text="&#x25BE;" FontSize="10" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlChecked}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Grid>
                        <!--
                            Breadcrumb face. The Border under the ScrollViewer
                            catches clicks that miss a crumb button (buttons
                            swallow their own) and switches to edit mode.
                            ScrollViewer keeps deep paths from pushing the
                            current folder out of sight — the view scrolls to
                            the tail on every navigation (see code-behind).
                        -->
                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Nav.IsEditingAddress}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ScrollViewer x:Name="CrumbScroll"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Nav.Breadcrumbs}" Margin="3,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource CrumbButton}"
                                                        Content="{Binding Label}"
                                                        ToolTip="{Binding Path}"
                                                        Command="{Binding DataContext.Nav.NavigateToCrumbCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Path}"/>
                                                <TextBlock Text="&#x203A;" Foreground="{StaticResource TextDim}" FontSize="13"
                                                           Margin="1,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Edit face. Borderless: the outer Border draws the frame. -->
                        <TextBox x:Name="AddressBox"
                                 BorderThickness="0" Padding="5,3"
                                 VerticalContentAlignment="Center"
                                 Visibility="{Binding Nav.IsEditingAddress, Converter={StaticResource BoolToVisibility}}"
                                 Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="AddressBox_PreviewKeyDown"
                                 LostKeyboardFocus="AddressBox_LostKeyboardFocus"/>

                        <Popup PlacementTarget="{Binding ElementName=AddressBar}" Placement="Bottom"
                               Width="{Binding ActualWidth, ElementName=AddressBar}"
                               IsOpen="{Binding IsChecked, ElementName=RecentToggle, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource InputBackground}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1">
                                <ListBox x:Name="RecentList" MaxHeight="320" BorderThickness="0"
                                         ItemsSource="{Binding Nav.RecentPaths}"
                                         SelectionChanged="RecentList_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Padding="2,1"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <!--
                Selection summary sits on the right, in its own field: the
                left one carries transient messages ("скопировано…", errors),
                and the two would otherwise overwrite each other on every
                click.
            -->
            <StatusBarItem DockPanel.Dock="Right" Margin="12,0,0,0">
                <TextBlock Text="{Binding SelectionSummary}" Foreground="{StaticResource TextMuted}"
                           TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right"
                           Visibility="{Binding HasActiveOperations, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Width="140" Height="14"
                             Minimum="0" Maximum="100"
                             Value="{Binding AggregateProgress, Mode=OneWay}">
                    <ProgressBar.ToolTip>
                        <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <ItemsControl ItemsSource="{Binding Operations}" MinWidth="260">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                            <ProgressBar Width="240" Height="6"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding Percent, Mode=OneWay}"
                                                         Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ToolTip>
                    </ProgressBar.ToolTip>
                </ProgressBar>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!--
                Left pane: bookmarks above, drives tree below, a draggable
                divider between them. All of it — the markup, the row
                template both trees share and every gesture on a row — lives
                in Views/FolderTreesView; the window keeps only the three
                answers the panels cannot give themselves.
            -->
            <views:FolderTreesView x:Name="FolderTrees"
                                   Grid.Column="0"
                                   ContextMenuRequested="FolderTrees_ContextMenuRequested"
                                   FolderTargeted="FolderTrees_FolderTargeted"
                                   FocusListRequested="FolderTrees_FocusListRequested"/>

            <!--
                Focusable="False" on all three splitters: WPF makes a
                GridSplitter focusable so it can be resized with the arrow
                keys, which put a grip nobody was looking for in the middle
                of the Tab cycle. Resizing them is a mouse gesture here.
            -->
            <GridSplitter Grid.Column="1" Focusable="False" HorizontalAlignment="Stretch" Background="{StaticResource Separator}"/>

            <!--
                The border is the "this is where the keyboard is" outline —
                see OnZoneFocusChanged. It is always one pixel thick and only
                changes colour, so switching zones never moves the list.
                The trees carry the same outline on their own BorderBrush;
                the list needs a wrapper because a UserControl has no border
                of its own.
            -->
            <Border x:Name="FileListZone"
                    Grid.Column="2"
                    BorderThickness="1"
                    BorderBrush="Transparent">
                <views:FileListView x:Name="FileList"
                                    AllowDrop="True"
                                    DragOver="OnDragOver"
                                    Drop="OnDrop"
                                    DragStartRequested="FileList_DragStartRequested"
                                    ContextMenuRequested="FileList_ContextMenuRequested"/>
            </Border>

            <!-- Splitter between right pane and preview -->
            <GridSplitter x:Name="PreviewSplitter"
                          Grid.Column="3"
                          Focusable="False"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource Separator}"
                          DragCompleted="PreviewSplitter_DragCompleted"/>

            <!--
                Preview pane. TabNavigation="None" because the keyboard has
                no business in here yet — zoom, the video transport and the
                document scroll are mouse-only. Without it the pane is full
                of focusable controls, and whatever WPF focuses first when a
                modal dialog hands the window back lands inside it: a caret
                blinking in a document nobody asked to edit.
            -->
            <views:PreviewPane x:Name="Preview"
                               Grid.Column="4"
                               KeyboardNavigation.TabNavigation="None"
                               Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </DockPanel>
</Window>
