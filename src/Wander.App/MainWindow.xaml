<Window x:Class="Wander.App.MainWindow"
        x:Name="WanderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Wander.App.ViewModels"
        xmlns:conv="clr-namespace:Wander.App.Converters"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:controls="clr-namespace:Wander.App.Controls"
        xmlns:views="clr-namespace:Wander.App.Views"
        xmlns:res="clr-namespace:Wander.App.Resources"
        Title="{Binding WindowTitle}"
        Icon="Assets\app.ico"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>
        <conv:BitmapPixelSizeConverter x:Key="BitmapPixelSize"/>
        <conv:RankStarConverter x:Key="RankStar"/>
        <conv:TreeIndentConverter x:Key="TreeIndent"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!--
            One star of the .pp3 rating widget. Five copies of this in the
            preview footer, each with its own CommandParameter; clicking the
            star that already marks the rating clears it.
        -->
        <Style x:Key="RatingStar" TargetType="Button">
            <Setter Property="Command" Value="{Binding Preview.SetRankCommand}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#D08A00"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Preview.RatingSource, StringFormat='Rating, written to {0}'}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            One colour-label swatch. The chosen one gets a ring rather than a
            different fill — the fill *is* the information, so it must not
            change to indicate selection.
        -->
        <Style x:Key="ColorLabelSwatch" TargetType="Button">
            <Setter Property="Command" Value="{Binding DataContext.Preview.SetColorLabelCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="2">
                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#666"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The file list's own row styles moved with it into
            Views/FileListView.xaml. What stays here is the tree's, because
            the drives and bookmarks panels must match it: Hidden rows fade
            to 0.55 opacity (Explorer parity), System rows go italic, and a
            row that is both gets both.
        -->
        <!--
            The expander chevron. Its own style so the row template can put
            it in a fixed-width column and the hit test in code-behind can
            keep recognising it by type (ToggleButton).
        -->
        <Style x:Key="TreeExpander" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="Arrow"
                                  Data="M 0,0 L 5,4.5 L 0,9 Z"
                                  Fill="#606060"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 9,0 L 4.5,5 Z"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="#1B1B1B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="#0078D7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Shared TreeViewItem style for the bookmarks and drives panels.

            Retemplated rather than restyled, because the stock template
            cannot do the one thing that matters here: highlight and accept
            clicks across the *whole row*, the way Explorer does. Nesting is
            what indents the stock template, so its highlight starts at the
            label; here the row border spans the full width and only its
            content is indented (TreeIndentConverter).

            Colours are Explorer's: #E5F3FB on hover, #CCE8FF selected,
            #E8E8E8 for a selection in a panel that lost focus.

            The Hidden/System cues match the file list — Hidden fades to
            0.55 opacity, System goes italic, both stack.
        -->
        <Style x:Key="WanderTreeViewItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <!--
                                The thin rule between the special folders
                                and the user's own bookmarks. It lives in
                                the row template, above the row, so it
                                spans the panel's full width — a border on
                                the row content would start after the
                                chevron column and read as an indented
                                underline. Inert in the drives tree: no
                                node there sets the flag.
                            -->
                            <Border x:Name="SectionRule"
                                    Height="1"
                                    Margin="4,2,4,2"
                                    Background="#D6D6D6"
                                    Visibility="Collapsed"/>
                            <Border x:Name="Row"
                                    Background="Transparent"
                                    MinHeight="22"
                                    SnapsToDevicePixels="True">
                                <Grid Margin="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource TreeIndent}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Style="{StaticResource TreeExpander}"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                    <!--
                                        Alignment comes from the item style,
                                        not baked in: the drives tree keeps
                                        its rows only as wide as their names
                                        (so long paths scroll sideways),
                                        while the bookmarks tree stretches
                                        them so the "…" menu can sit at the
                                        right edge.
                                    -->
                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" SourceName="Row" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#E5F3FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#CCE8FF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsSelectionActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background" Value="#E8E8E8"/>
                            </MultiTrigger>
                            <DataTrigger Binding="{Binding StartsUserSection}" Value="True">
                                <Setter TargetName="SectionRule" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C8C8C8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Breadcrumb segment: the ToolbarButton look (flat, highlight on
            hover) at text size, so the path reads as plain text until the
            mouse says otherwise.
        -->
        <Style x:Key="CrumbButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>

        <!--
            The glyphs that sit inside the search box. Templated flat rather
            than merely restyled: an ordinary WPF button dropped into a text
            field reads as a second control with its own border, and the box
            has to look like one field with affordances in it.
        -->
        <Style x:Key="BoxGlyphButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Right-click on the empty part of a navigation panel. Not the file
            menu — nothing was clicked — but the handful of settings that get
            flipped often enough that walking to Параметры for them is the
            annoying part: what the listing shows, whether the arrow keys
            open folders, whether deleting asks first.

            One instance shared by both trees. A ContextMenu is not in the
            visual tree, so its DataContext does not inherit; PlacementTarget
            is how it reaches the window's own.
        -->
        <ContextMenu x:Key="PanelSettingsMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{x:Static res:Strings.PanelShowHidden}"
                      IsCheckable="True"
                      IsChecked="{Binding Settings.ShowHidden}"/>
            <MenuItem Header="{x:Static res:Strings.PanelShowSystem}"
                      IsCheckable="True"
                      IsChecked="{Binding Settings.ShowSystem}"/>
            <Separator/>
            <MenuItem Header="{x:Static res:Strings.PanelTreeKeyboardNavigates}"
                      IsCheckable="True"
                      IsChecked="{Binding Settings.TreeKeyboardNavigates}"
                      ToolTip="{x:Static res:Strings.PanelTreeKeyboardNavigatesHint}"/>
            <MenuItem Header="{x:Static res:Strings.PanelConfirmRecycle}"
                      IsCheckable="True"
                      IsChecked="{Binding Settings.ConfirmRecycle}"
                      ToolTip="{x:Static res:Strings.PanelConfirmRecycleHint}"/>
            <MenuItem Header="{x:Static res:Strings.PanelAutoRefresh}"
                      IsCheckable="True"
                      IsChecked="{Binding Settings.AutoRefresh}"/>
            <Separator/>
            <MenuItem Header="{x:Static res:Strings.MenuOptions}" Command="{Binding OptionsCommand}"/>
        </ContextMenu>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
        <KeyBinding Modifiers="Shift" Key="Delete" Command="{Binding PermanentDeleteCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="Back" Command="{Binding UpCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopyCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="X" Command="{Binding CutCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="V" Command="{Binding PasteCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="C" Command="{Binding CopyPathCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="N" Command="{Binding NewFolderCommand}"/>
        <!--
            The Alt chords (Alt+←/→/↑, Alt+Enter, Alt+D) are not here: the
            Menu in the toolbar swallows them before command routing, so
            they live in MainWindow.OnPreviewKeyDown instead.
        -->
        <KeyBinding Modifiers="Ctrl" Key="Q" Command="{Binding TogglePreviewCommand}"/>
        <!--
            View modes on the digits Explorer uses for them: its list runs
            from extra-large icons (1) to Content (8), and our three views
            sit at the positions of the ones they match. Binding the spare
            digits as well would promise icon sizes we do not have.
        -->
        <KeyBinding Modifiers="Ctrl+Shift" Key="D1" Command="{Binding SetViewModeCommand}" CommandParameter="Gallery"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="D2" Command="{Binding SetViewModeCommand}" CommandParameter="LargeIcons"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="D6" Command="{Binding SetViewModeCommand}" CommandParameter="Details"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="D7" Command="{Binding SetViewModeCommand}" CommandParameter="Tiles"/>
    </Window.InputBindings>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="#F3F3F3">
            <StackPanel x:Name="NavToolbar" Orientation="Horizontal" DockPanel.Dock="Left" Margin="4,4,8,4">
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding BackCommand}" ToolTip="{x:Static res:Strings.NavBack}"
                        Width="28" Height="28" Margin="2,0" Content="&#x2190;"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ForwardCommand}" ToolTip="{x:Static res:Strings.NavForward}"
                        Width="28" Height="28" Margin="2,0" Content="&#x2192;"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding UpCommand}" ToolTip="{x:Static res:Strings.NavUp}"
                        Width="28" Height="28" Margin="2,0" Content="&#x2191;"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,4,4,4">
                <Menu VerticalAlignment="Center">
                    <MenuItem Padding="10,4">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static res:Strings.MenuView}"/>
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Margin="6,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Header="{x:Static res:Strings.MenuViewDetails}"
                                  InputGestureText="Ctrl+Shift+6"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Details}"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="Details"/>
                        <MenuItem Header="{x:Static res:Strings.MenuViewTiles}"
                                  InputGestureText="Ctrl+Shift+7"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Tiles}"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="Tiles"/>
                        <MenuItem Header="{x:Static res:Strings.MenuViewLargeIcons}"
                                  InputGestureText="Ctrl+Shift+2"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=LargeIcons}"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="LargeIcons"/>
                        <!--
                            Gallery takes Ctrl+Shift+1, the slot Explorer
                            gives its extra-large icons: it is the same end
                            of the same scale, and the digits stay a scale
                            rather than an arbitrary list.
                        -->
                        <MenuItem Header="{x:Static res:Strings.MenuViewGallery}"
                                  InputGestureText="Ctrl+Shift+1"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Gallery}"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="Gallery"/>
                        <!--
                            The gallery background is not here on purpose. It
                            is the control you reach for while looking at the
                            photographs — to see the same frame on grey and
                            then on black — and three clicks into a menu for
                            something you flip back and forth is three clicks
                            too many. It lives on the strip above the list,
                            next to the filter, where both are one click from
                            the pictures they are about.
                        -->
                        <Separator/>
                        <!--
                            Sort by submenu. The four columns mirror the Details
                            view. Clicking the active column toggles direction
                            (Explorer parity, handled in MainViewModel.SetSortKey).
                            Ascending/GroupFoldersFirst sit below as separate
                            toggles so the user can flip them without changing
                            the column.
                        -->
                        <MenuItem Header="{x:Static res:Strings.MenuSortBy}">
                            <MenuItem Header="{x:Static res:Strings.MenuSortName}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Name}"
                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Name"/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortDate}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=ModifiedDate}"
                                      Command="{Binding SetSortKeyCommand}" CommandParameter="ModifiedDate"/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortSize}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Size}"
                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Size"/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortType}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Type}"
                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Type"/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortRating}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Rating}"
                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Rating"/>
                            <Separator/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortAscending}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortAscending, Mode=OneWay}"
                                      Command="{Binding ToggleSortAscendingCommand}"/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortFoldersFirst}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.GroupFoldersFirst, Mode=OneWay}"
                                      Command="{Binding ToggleGroupFoldersFirstCommand}"/>
                        </MenuItem>
                        <Separator/>
                        <!--
                            Preview pane and Refresh live here rather than in
                            the "..." menu: both are about what the file list
                            is showing right now, which is what this menu is.
                        -->
                        <MenuItem Header="{x:Static res:Strings.MenuQuickPreview}"
                                  InputGestureText="Ctrl+Q"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsPreviewVisible, Mode=TwoWay}"/>
                        <MenuItem Header="{x:Static res:Strings.MenuRefresh}"
                                  InputGestureText="F5"
                                  Command="{Binding RefreshCommand}"/>
                    </MenuItem>
                </Menu>

                <Border Width="12"/>

                <!--
                    The application menu. Four rows and one divider: the two
                    things that are about the app rather than about the files
                    (settings, the project itself), the debug drawer, and the
                    way out. Everything that acts on what is on screen lives
                    in "Вид" or in the context menu, next to what it acts on.
                -->
                <Menu VerticalAlignment="Center">
                    <MenuItem Padding="10,4">
                        <MenuItem.Header>
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </MenuItem.Header>
                        <MenuItem Header="{x:Static res:Strings.MenuOptions}" Command="{Binding OptionsCommand}"/>
                        <MenuItem Header="{x:Static res:Strings.MenuAbout}">
                            <MenuItem Header="{x:Static res:Strings.MenuReportIssue}"
                                      Command="{Binding ReportIssueCommand}"
                                      ToolTip="{x:Static res:Strings.MenuReportIssueHint}"/>
                            <MenuItem Header="{x:Static res:Strings.MenuHelp}"
                                      Command="{Binding HelpCommand}"
                                      ToolTip="{x:Static res:Strings.MenuHelpHint}"/>
                            <Separator/>
                            <!--
                                A caption, not a command: greying it out would
                                read as "broken", so it keeps the label colour
                                of a gesture hint and simply takes no input.
                            -->
                            <MenuItem Header="{Binding VersionLabel}"
                                      Foreground="{StaticResource MenuForegroundGesture}"
                                      Focusable="False" IsHitTestVisible="False"/>
                        </MenuItem>
                        <MenuItem Header="{x:Static res:Strings.MenuDebug}"
                                  Visibility="{Binding Settings.ShowDebugMenu, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem Header="{x:Static res:Strings.MenuLogs}"
                                      Command="{Binding OpenLogFileCommand}"
                                      ToolTip="{x:Static res:Strings.MenuLogsHint}"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{x:Static res:Strings.MenuExit}" Command="{Binding ExitCommand}"/>
                    </MenuItem>
                </Menu>
            </StackPanel>

            <!--
                Search box. DockPanel.Dock="Right" placed AFTER the right-side
                menus = sits to their LEFT, i.e. immediately to the right of the
                address bar. Grid hosts a placeholder TextBlock overlaid on the
                TextBox; the placeholder's visibility flips on HasSearchQuery.
            -->
            <!--
                Hidden while the search window is open: the same criteria in
                two places is how one of them ends up stale, and the window
                is the one that can show all of them.
            -->
            <Grid DockPanel.Dock="Right"
                  Width="250" VerticalAlignment="Center"
                  Margin="0,4,4,4"
                  Visibility="{Binding IsSearchWindowOpen, Converter={StaticResource InverseBoolToVisibility}}">
                <!--
                    The two glyphs overlay the box rather than sitting in
                    columns beside it: the field has to keep the whole width
                    so it still looks like one control, and the TextBox's
                    right padding is what keeps the caret out from under
                    them.
                -->
                <TextBox x:Name="SearchBox"
                         Padding="6,4,48,4"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static res:Strings.SearchHint}"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                <TextBlock Text="{x:Static res:Strings.SearchPlaceholder}"
                           Foreground="#999"
                           Margin="8,0,50,0"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSearchQuery}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,3,0">
                    <!--
                        Stop replaces Clear while a pass is walking the disk:
                        the same spot, because they answer the same impulse —
                        "that is not what I meant, undo it".
                    -->
                    <Button Content="&#x25A0;" Style="{StaticResource BoxGlyphButton}"
                            Command="{Binding StopSearchCommand}"
                            ToolTip="{x:Static res:Strings.SearchStop}"
                            Visibility="{Binding ContentSearch.IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="&#x2715;"
                            Command="{Binding ClearSearchCommand}"
                            ToolTip="{x:Static res:Strings.SearchClear}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BoxGlyphButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSearchQuery}" Value="True"/>
                                            <Condition Binding="{Binding ContentSearch.IsRunning}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!--
                        Marked when the search window holds something other
                        than the two text criteria — subfolders, the whole
                        machine, binaries. Those do not fit in the box's own
                        text, and a list narrowed by a switch set in a window
                        that is now closed has to say so somewhere.
                    -->
                    <Button Content="&#x22EE;"
                            FontSize="13"
                            Click="SearchOptions_Click"
                            ToolTip="{x:Static res:Strings.SearchOptions}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BoxGlyphButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ContentSearch.HasNonDefaultOptions}" Value="True">
                                        <Setter Property="Foreground" Value="#0078D7"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

            </Grid>

            <!--
                Address bar — one strip with two faces:
                  * breadcrumbs (default): every folder of the current path is
                    a flat button that lights up on hover, click = go there;
                  * text box (edit mode): the raw path, for typing or pasting.
                Entered by Ctrl+L or a click on the empty space of the strip,
                left by Esc / focus loss / a successful navigation.
                The chevron on the right drops down the recently visited
                folders (F4 toggles it — Explorer parity).
            -->
            <!--
                The whole strip switches to the editable path on a click
                that misses a crumb — handled here, on the outer border, in
                the tunnelling phase. It used to hang off the inner border
                behind the breadcrumbs, which left the strip's own padding
                and the gap under the crumb row dead to the click.
            -->
            <Border x:Name="AddressBar"
                    VerticalAlignment="Center" Margin="0,4,4,4" MinHeight="26"
                    Background="White" BorderBrush="#ABADB3" BorderThickness="1"
                    PreviewMouseLeftButtonDown="AddressBar_PreviewMouseLeftButtonDown">
                <DockPanel>
                    <ToggleButton x:Name="RecentToggle" DockPanel.Dock="Right"
                                  Width="22" Focusable="False"
                                  ToolTip="{x:Static res:Strings.RecentFoldersHint}"
                                  Background="Transparent">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <TextBlock Text="&#x25BE;" FontSize="10" Foreground="#444"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Grid>
                        <!--
                            Breadcrumb face. The Border under the ScrollViewer
                            catches clicks that miss a crumb button (buttons
                            swallow their own) and switches to edit mode.
                            ScrollViewer keeps deep paths from pushing the
                            current folder out of sight — the view scrolls to
                            the tail on every navigation (see code-behind).
                        -->
                        <Border Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Nav.IsEditingAddress}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ScrollViewer x:Name="CrumbScroll"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Nav.Breadcrumbs}" Margin="3,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource CrumbButton}"
                                                        Content="{Binding Label}"
                                                        ToolTip="{Binding Path}"
                                                        Command="{Binding DataContext.Nav.NavigateToCrumbCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Path}"/>
                                                <TextBlock Text="&#x203A;" Foreground="#888" FontSize="13"
                                                           Margin="1,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Edit face. Borderless: the outer Border draws the frame. -->
                        <TextBox x:Name="AddressBox"
                                 BorderThickness="0" Padding="5,3"
                                 VerticalContentAlignment="Center"
                                 Visibility="{Binding Nav.IsEditingAddress, Converter={StaticResource BoolToVisibility}}"
                                 Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="AddressBox_PreviewKeyDown"
                                 LostKeyboardFocus="AddressBox_LostKeyboardFocus"/>

                        <Popup PlacementTarget="{Binding ElementName=AddressBar}" Placement="Bottom"
                               Width="{Binding ActualWidth, ElementName=AddressBar}"
                               IsOpen="{Binding IsChecked, ElementName=RecentToggle, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="White" BorderBrush="#ABADB3" BorderThickness="1">
                                <ListBox x:Name="RecentList" MaxHeight="320" BorderThickness="0"
                                         ItemsSource="{Binding Nav.RecentPaths}"
                                         SelectionChanged="RecentList_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Padding="2,1"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <!--
                Selection summary sits on the right, in its own field: the
                left one carries transient messages ("скопировано…", errors),
                and the two would otherwise overwrite each other on every
                click.
            -->
            <StatusBarItem DockPanel.Dock="Right" Margin="12,0,0,0">
                <TextBlock Text="{Binding SelectionSummary}" Foreground="#555"
                           TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right"
                           Visibility="{Binding HasActiveOperations, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Width="140" Height="14"
                             Minimum="0" Maximum="100"
                             Value="{Binding AggregateProgress, Mode=OneWay}">
                    <ProgressBar.ToolTip>
                        <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <ItemsControl ItemsSource="{Binding Operations}" MinWidth="260">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                            <ProgressBar Width="240" Height="6"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding Percent, Mode=OneWay}"
                                                         Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ToolTip>
                    </ProgressBar.ToolTip>
                </ProgressBar>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!--
                Left pane = vertical stack:
                  • bookmarks (collapsible header, tree of favourites, "+" strip)
                  • a draggable divider
                  • drives tree
                The divider is a real GridSplitter: how much room bookmarks
                deserve depends on how many the user keeps, and a fixed cap
                was always wrong for somebody. Its position is remembered in
                AppState the same way the preview pane's width is.

                Drops onto an empty area of the bookmarks region add the
                dragged folder(s) as bookmarks; drops onto a specific
                bookmark folder inside the tree go through the normal
                OnDragOver/OnDrop pipeline (copy/move into that folder).
            -->
            <Grid Grid.Column="0" Background="#F8F8F8">
                <Grid.RowDefinitions>
                    <!--
                        Header, tree and the "+" strip share one row, so the
                        divider has a single height to move. Splitting them
                        across rows is what made dragging the divider grow the
                        "+" strip instead of the bookmarks: a splitter with
                        PreviousAndNext resizes the rows it sits between, and
                        the row above it was the strip's, not the tree's.
                    -->
                    <RowDefinition x:Name="BookmarksRow" Height="200" MinHeight="56"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="80"/>
                </Grid.RowDefinitions>

                <!--
                    The "keyboard is here" outline belongs to the whole
                    bookmarks region, not to the tree inside it: the header
                    and the "+" strip are part of the same panel, and a
                    frame that starts below the header and stops above the
                    strip reads as a box around nothing in particular. The
                    thickness is always 1 and only the brush changes
                    (OnZoneFocusChanged), so nothing shifts when it lights
                    up.
                -->
                <Border Grid.Row="0"
                        x:Name="BookmarksFrame"
                        BorderThickness="1"
                        BorderBrush="Transparent">
                <DockPanel x:Name="BookmarksPanel"
                           AllowDrop="True"
                           DragOver="BookmarksPanel_DragOver"
                           Drop="BookmarksPanel_Drop">
                    <!-- Collapsible header: whole row is clickable to toggle. -->
                    <Button DockPanel.Dock="Top"
                            Command="{Binding ToggleBookmarksCommand}"
                            HorizontalContentAlignment="Stretch"
                            Padding="6,4"
                            Background="#EEE"
                            BorderBrush="#DDD"
                            BorderThickness="0,0,0,1"
                            Cursor="Hand"
                            ToolTip="{x:Static res:Strings.BookmarksToggleHint}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Margin="0,0,6,0"
                                       FontSize="10"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25BC;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBookmarksExpanded}" Value="False">
                                                <Setter Property="Text" Value="&#x25B6;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{x:Static res:Strings.BookmarksHeader}" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Button>

                    <!--
                        Drop zone for new bookmarks. Sits at the bottom of
                        the bookmarks region, right above the divider, and is
                        deliberately narrower than the panel so it reads as a
                        target rather than as another row of the tree.

                        Not a button: nothing happens on a click, so it must
                        not offer a hand cursor or light up under an idle
                        mouse. It answers only to a drag carrying a folder
                        that is not bookmarked yet — see
                        SetBookmarkDropZoneActive.
                    -->
                    <Border x:Name="BookmarkDropZone"
                            DockPanel.Dock="Bottom"
                            Height="20"
                            Margin="12,2,12,2"
                            Background="#ECECEC"
                            CornerRadius="2"
                            ToolTip="{x:Static res:Strings.BookmarksAddHint}"
                            AllowDrop="True"
                            DragEnter="BookmarkDropZone_DragEnter"
                            DragOver="BookmarkDropZone_DragOver"
                            DragLeave="BookmarkDropZone_DragLeave"
                            Drop="BookmarkDropZone_Drop"
                            Visibility="{Binding IsBookmarksExpanded, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Name="BookmarkDropZoneGlyph"
                                   Text="+"
                                   FontSize="13"
                                   Foreground="#888"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!--
                        AllowDrop=True so cursor feedback shows correctly,
                        but DragOver/Drop are intentionally NOT attached here:
                        the parent BookmarksPanel handles all drop events so
                        that drops anywhere in this region (header, empty
                        area, between items) add the dragged folder(s) as
                        bookmarks rather than copying into the current folder.
                    -->
                    <TreeView x:Name="BookmarksTree"
                              ContextMenu="{StaticResource PanelSettingsMenu}"
                              ItemsSource="{Binding Bookmarks.Items}"
                              SelectedItemChanged="Bookmarks_SelectedItemChanged"
                              PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp"
                              PreviewMouseMove="Tree_PreviewMouseMove"
                              PreviewMouseWheel="Tree_PreviewMouseWheel"
                              PreviewMouseRightButtonUp="BookmarksTree_PreviewMouseRightButtonUp"
                              PreviewKeyDown="Tree_PreviewKeyDown"
                              TreeViewItem.Expanded="TreeViewItem_Expanded"
                              TreeViewItem.Collapsed="TreeViewItem_Collapsed"
                              AllowDrop="True"
                              Visibility="{Binding IsBookmarksExpanded, Converter={StaticResource BoolToVisibility}}"
                              BorderThickness="0"
                              Background="Transparent">
                        <TreeView.ItemContainerStyle>
                            <!--
                                Stretched rows, unlike the drives tree: the
                                "…" menu button lives at the right edge, so
                                the row has to reach it. Bookmark names are
                                short, so nothing is lost by giving up the
                                horizontal scroll here.
                            -->
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource WanderTreeViewItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <!--
                                    The row's menu is built in code-behind
                                    (BookmarkRowMenu_Click), not declared
                                    here. A ContextMenu declared inside a
                                    DataTemplate lives in its own name scope
                                    and its own visual tree, so the
                                    ElementName binding that used to reach
                                    the window for the command never
                                    resolved — the menu opened and the item
                                    did nothing.
                                -->
                                <DockPanel Background="Transparent">
                                    <!--
                                        The row's own menu, reachable without
                                        the right mouse button. Only the
                                        user's own bookmarks get it — the
                                        special folders are toggled in
                                        settings and have nothing to remove.
                                        It opens the same menu the right
                                        click does.

                                        Always visible rather than on hover:
                                        a TreeViewItem's IsMouseOver covers
                                        its whole subtree, so hovering a child
                                        would light the parent's button too,
                                        and there is no way to reach the row
                                        border's own hover state from inside
                                        the item template. A muted glyph on
                                        the handful of rows that have one is
                                        the cheaper trade.
                                    -->
                                    <Button DockPanel.Dock="Right"
                                            Width="18" Height="18"
                                            Margin="4,0,2,0"
                                            Padding="0"
                                            Content="&#x22EF;"
                                            FontSize="13"
                                            Foreground="#555"
                                            Focusable="False"
                                            Cursor="Hand"
                                            ToolTip="{x:Static res:Strings.BookmarksRowMenuHint}"
                                            Click="BookmarkRowMenu_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="2">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#C4E0F4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRemovableBookmark}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!--
                                        AsyncIcon, not a converter on the
                                        binding: the converter asks the shell
                                        on the spot, and a branch of forty
                                        folders is forty synchronous shell
                                        calls on the dispatcher, taken while
                                        the tree is trying to draw.
                                    -->
                                    <controls:AsyncIcon DockPanel.Dock="Left"
                                                        IconPath="{Binding FullPath}" IconSize="Small"
                                                        Width="16" Height="16" Margin="0,0,4,0"/>
                                    <!--
                                        A bookmark whose folder is gone
                                        stays in the list, greyed and
                                        italic. Removing the row would look
                                        like Wander lost the bookmark; the
                                        user is the one who decides whether
                                        it goes.
                                    -->
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FullPath}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Foreground" Value="#9A9A9A"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
                </Border>

                <!--
                    "Add bookmark" strip. It sits at the bottom of the
                    bookmarks region, right above the divider, and is
                    deliberately narrower than the panel so it reads as a
                    control rather than as another row of the tree. No
                    caption — a "+" and a tooltip; the text that used to be
                    here was a permanent instruction for something the user
                    learns once. Flat fill, no border, no gradient.

                    Two ways in: click adds the folder that is currently
                    open, drag-and-drop adds whatever is dropped on it.
                -->


                <GridSplitter x:Name="BookmarksSplitter"
                              Grid.Row="1"
                              Focusable="False"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Background="#DDD"
                              Visibility="{Binding IsBookmarksExpanded, Converter={StaticResource BoolToVisibility}}"
                              DragCompleted="BookmarksSplitter_DragCompleted"/>

                <!--
                    No top margin: the outline is this panel's own edge, and
                    a four-pixel gap under the splitter put it where the eye
                    does not look for it. The rows keep their air from the
                    row template's MinHeight.
                -->
                <TreeView x:Name="Tree" Grid.Row="2"
                          ContextMenu="{StaticResource PanelSettingsMenu}"
                          ItemsSource="{Binding Trees.Roots}"
                          SelectedItemChanged="Tree_SelectedItemChanged"
                          PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp"
                          PreviewMouseMove="Tree_PreviewMouseMove"
                          PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                          PreviewMouseRightButtonUp="Tree_PreviewMouseRightButtonUp"
                          PreviewMouseWheel="Tree_PreviewMouseWheel"
                          PreviewKeyDown="Tree_PreviewKeyDown"
                          TreeViewItem.Expanded="TreeViewItem_Expanded"
                          TreeViewItem.Collapsed="TreeViewItem_Collapsed"
                          AllowDrop="True"
                          Background="Transparent"
                          BorderThickness="1"
                          BorderBrush="Transparent"
                          DragOver="OnDragOver"
                          Drop="OnDrop">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource WanderTreeViewItem}"/>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <controls:AsyncIcon IconPath="{Binding FullPath}" IconSize="Small"
                                                    Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <!--
                Focusable="False" on all three splitters: WPF makes a
                GridSplitter focusable so it can be resized with the arrow
                keys, which put a grip nobody was looking for in the middle
                of the Tab cycle. Resizing them is a mouse gesture here.
            -->
            <GridSplitter Grid.Column="1" Focusable="False" HorizontalAlignment="Stretch" Background="#DDD"/>

            <!--
                The border is the "this is where the keyboard is" outline —
                see OnZoneFocusChanged. It is always one pixel thick and only
                changes colour, so switching zones never moves the list.
                The trees carry the same outline on their own BorderBrush;
                the list needs a wrapper because a UserControl has no border
                of its own.
            -->
            <Border x:Name="FileListZone"
                    Grid.Column="2"
                    BorderThickness="1"
                    BorderBrush="Transparent">
                <views:FileListView x:Name="FileList"
                                    AllowDrop="True"
                                    DragOver="OnDragOver"
                                    Drop="OnDrop"
                                    DragStartRequested="FileList_DragStartRequested"
                                    ContextMenuRequested="FileList_ContextMenuRequested"/>
            </Border>

            <!-- Splitter between right pane and preview -->
            <GridSplitter x:Name="PreviewSplitter"
                          Grid.Column="3"
                          Focusable="False"
                          HorizontalAlignment="Stretch"
                          Background="#DDD"
                          DragCompleted="PreviewSplitter_DragCompleted"/>

            <!--
                Preview pane. TabNavigation="None" because the keyboard has
                no business in here yet — zoom, the video transport and the
                document scroll are mouse-only. Without it the pane is full
                of focusable controls, and whatever WPF focuses first when a
                modal dialog hands the window back lands inside it: a caret
                blinking in a document nobody asked to edit.
            -->
            <views:PreviewPane x:Name="Preview"
                               Grid.Column="4"
                               KeyboardNavigation.TabNavigation="None"
                               Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </DockPanel>
</Window>
