<Window x:Class="Wander.App.MainWindow"
        x:Name="WanderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Wander.App.ViewModels"
        xmlns:conv="clr-namespace:Wander.App.Converters"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:controls="clr-namespace:Wander.App.Controls"
        xmlns:res="clr-namespace:Wander.App.Resources"
        Title="{Binding WindowTitle}"
        Icon="Assets\app.ico"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <conv:IconConverter x:Key="IconConverter"/>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>
        <conv:BitmapPixelSizeConverter x:Key="BitmapPixelSize"/>
        <conv:RankStarConverter x:Key="RankStar"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:RenameEditorVisibilityConverter x:Key="RenameVisibility"/>

        <!--
            Inline rename editor (A3). Every row template carries one of
            these, collapsed; MainViewModel.RenamingPath makes exactly one
            visible. Focus, the initial text and the "select the name, not
            the extension" selection are done from code-behind when the
            edit starts - a collapsed TextBox cannot take focus, so it has
            to happen after the visibility flips.
        -->
        <Style x:Key="RenameEditor" TargetType="TextBox">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Visibility">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource RenameVisibility}">
                        <Binding Path="FullPath"/>
                        <Binding Path="DataContext.RenamingPath" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewKeyDown" Handler="RenameBox_PreviewKeyDown"/>
            <EventSetter Event="PreviewTextInput" Handler="RenameBox_PreviewTextInput"/>
            <EventSetter Event="LostKeyboardFocus" Handler="RenameBox_LostKeyboardFocus"/>
        </Style>

        <!--
            One star of the .pp3 rating widget. Five copies of this in the
            preview footer, each with its own CommandParameter; clicking the
            star that already marks the rating clears it.
        -->
        <Style x:Key="RatingStar" TargetType="Button">
            <Setter Property="Command" Value="{Binding Preview.SetRankCommand}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#D08A00"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Preview.RatingSource, StringFormat='Rating, written to {0}'}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            One colour-label swatch. The chosen one gets a ring rather than a
            different fill — the fill *is* the information, so it must not
            change to indicate selection.
        -->
        <Style x:Key="ColorLabelSwatch" TargetType="Button">
            <Setter Property="Command" Value="{Binding DataContext.Preview.SetColorLabelCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="2">
                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#666"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Suppress the dashed focus rectangle on selectable row containers.
            Default WPF draws it on top of the selection background, producing
            "double selection" visuals. Selection state remains driven by the
            normal background brushes; focus is still tracked semantically
            (keyboard navigation works).
        -->
        <!--
            Implicit row styles: kill the focus rectangle (see comment above),
            and fade rows whose underlying entry has the Hidden / System
            attribute. Fading only kicks in when the corresponding toggle is
            on (otherwise the row isn't rendered at all), so the dimmed look
            is the visual cue that "this is technically hidden by Windows".
        -->
        <!--
            Hidden vs System visual cue convention:
              - Hidden:           opacity 0.55 (faded, Explorer parity).
              - System:           italic       (slants the label; a strong but
                                                still readable signal that this
                                                is OS infrastructure).
              - Hidden + System:  both         (typical "protected OS" file —
                                                stands out as «не трогать»).
            Triggers stack additively, so the combined case automatically gets
            both treatments. Same triggers are applied to the TreeViewItem
            style so drives/bookmarks panel matches the file list.
        -->
        <Style TargetType="DataGridRow">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shared TreeViewItem style: same Hidden/System visual rules as the
             file list, plus the two-way bindings for expand/select state.
             Used by both the bookmarks tree and the drives tree. -->
        <Style x:Key="WanderTreeViewItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C8C8C8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Breadcrumb segment: the ToolbarButton look (flat, highlight on
            hover) at text size, so the path reads as plain text until the
            mouse says otherwise.
        -->
        <Style x:Key="CrumbButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
        <KeyBinding Modifiers="Shift" Key="Delete" Command="{Binding PermanentDeleteCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="Back" Command="{Binding UpCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding BackCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Right" Command="{Binding ForwardCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Up" Command="{Binding UpCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopyCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="X" Command="{Binding CutCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="V" Command="{Binding PasteCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="C" Command="{Binding CopyPathCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="N" Command="{Binding NewFolderCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Enter" Command="{Binding PropertiesCommand}"/>
    </Window.InputBindings>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="#F3F3F3">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="4,4,8,4">
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding BackCommand}" ToolTip="{x:Static res:Strings.NavBack}"
                        Width="28" Height="28" Margin="2,0" Content="&#x2190;"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ForwardCommand}" ToolTip="{x:Static res:Strings.NavForward}"
                        Width="28" Height="28" Margin="2,0" Content="&#x2192;"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding UpCommand}" ToolTip="{x:Static res:Strings.NavUp}"
                        Width="28" Height="28" Margin="2,0" Content="&#x2191;"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,4,4,4">
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Padding="8,4">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static res:Strings.MenuView}"/>
                                <TextBlock Text="&#x25BE;" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Header="{x:Static res:Strings.MenuViewDetails}"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Details}"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="Details"/>
                        <MenuItem Header="{x:Static res:Strings.MenuViewTiles}"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Tiles}"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="Tiles"/>
                        <MenuItem Header="{x:Static res:Strings.MenuViewLargeIcons}"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=LargeIcons}"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="LargeIcons"/>
                        <Separator/>
                        <!--
                            Sort by submenu. The four columns mirror the Details
                            view. Clicking the active column toggles direction
                            (Explorer parity, handled in MainViewModel.SetSortKey).
                            Ascending/GroupFoldersFirst sit below as separate
                            toggles so the user can flip them without changing
                            the column.
                        -->
                        <MenuItem Header="{x:Static res:Strings.MenuSortBy}">
                            <MenuItem Header="{x:Static res:Strings.MenuSortName}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Name}"
                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Name"/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortDate}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=ModifiedDate}"
                                      Command="{Binding SetSortKeyCommand}" CommandParameter="ModifiedDate"/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortSize}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Size}"
                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Size"/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortType}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortKey, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Type}"
                                      Command="{Binding SetSortKeyCommand}" CommandParameter="Type"/>
                            <Separator/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortAscending}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.SortAscending, Mode=OneWay}"
                                      Command="{Binding ToggleSortAscendingCommand}"/>
                            <MenuItem Header="{x:Static res:Strings.MenuSortFoldersFirst}"
                                      IsCheckable="True"
                                      IsChecked="{Binding Settings.GroupFoldersFirst, Mode=OneWay}"
                                      Command="{Binding ToggleGroupFoldersFirstCommand}"/>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <Border Width="12"/>

                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Padding="8,4" FontSize="16">
                        <MenuItem.Header>
                            <TextBlock Text="&#x22EF;" FontSize="16" Margin="0,-4,0,0"/>
                        </MenuItem.Header>
                        <MenuItem Header="{x:Static res:Strings.MenuRefresh}" Command="{Binding RefreshCommand}" InputGestureText="F5"/>
                        <MenuItem Header="{x:Static res:Strings.MenuNewFolder}" Command="{Binding NewFolderCommand}" InputGestureText="Ctrl+Shift+N"/>
                        <Separator/>
                        <MenuItem Header="{x:Static res:Strings.MenuQuickPreview}"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsPreviewVisible, Mode=TwoWay}"/>
                        <Separator/>
                        <MenuItem Header="{x:Static res:Strings.MenuOptions}" Command="{Binding OptionsCommand}"/>
                        <MenuItem Header="{x:Static res:Strings.MenuReportIssue}"
                                  Command="{Binding ReportIssueCommand}"
                                  ToolTip="{x:Static res:Strings.MenuReportIssueHint}"/>
                        <Separator/>
                        <MenuItem Header="{x:Static res:Strings.MenuDebug}"
                                  Visibility="{Binding Settings.ShowDebugMenu, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem Header="{x:Static res:Strings.MenuLogs}"
                                      Command="{Binding OpenLogFileCommand}"
                                      ToolTip="{x:Static res:Strings.MenuLogsHint}"/>
                        </MenuItem>
                        <Separator Visibility="{Binding Settings.ShowDebugMenu, Converter={StaticResource BoolToVisibility}}"/>
                        <MenuItem Header="{x:Static res:Strings.MenuExit}" Command="{Binding ExitCommand}"/>
                    </MenuItem>
                </Menu>
            </StackPanel>

            <!--
                Search box. DockPanel.Dock="Right" placed AFTER the right-side
                menus = sits to their LEFT, i.e. immediately to the right of the
                address bar. Grid hosts a placeholder TextBlock overlaid on the
                TextBox; the placeholder's visibility flips on HasSearchQuery.
            -->
            <Grid DockPanel.Dock="Right"
                  Width="200" VerticalAlignment="Center"
                  Margin="0,4,4,4">
                <TextBox x:Name="SearchBox"
                         Padding="6,4"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static res:Strings.SearchHint}"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                <TextBlock Text="{x:Static res:Strings.SearchPlaceholder}"
                           Foreground="#999"
                           Margin="8,0,8,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSearchQuery}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!--
                Address bar — one strip with two faces:
                  * breadcrumbs (default): every folder of the current path is
                    a flat button that lights up on hover, click = go there;
                  * text box (edit mode): the raw path, for typing or pasting.
                Entered by Ctrl+L or a click on the empty space of the strip,
                left by Esc / focus loss / a successful navigation.
                The chevron on the right drops down the recently visited
                folders (F4 toggles it — Explorer parity).
            -->
            <Border x:Name="AddressBar"
                    VerticalAlignment="Center" Margin="0,4,4,4" MinHeight="26"
                    Background="White" BorderBrush="#ABADB3" BorderThickness="1">
                <DockPanel>
                    <ToggleButton x:Name="RecentToggle" DockPanel.Dock="Right"
                                  Width="22" Focusable="False"
                                  ToolTip="{x:Static res:Strings.RecentFoldersHint}"
                                  Background="Transparent">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <TextBlock Text="&#x25BE;" FontSize="10" Foreground="#444"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Grid>
                        <!--
                            Breadcrumb face. The Border under the ScrollViewer
                            catches clicks that miss a crumb button (buttons
                            swallow their own) and switches to edit mode.
                            ScrollViewer keeps deep paths from pushing the
                            current folder out of sight — the view scrolls to
                            the tail on every navigation (see code-behind).
                        -->
                        <Border Background="Transparent" MouseLeftButtonDown="CrumbHost_MouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Nav.IsEditingAddress}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ScrollViewer x:Name="CrumbScroll"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Nav.Breadcrumbs}" Margin="3,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource CrumbButton}"
                                                        Content="{Binding Label}"
                                                        ToolTip="{Binding Path}"
                                                        Command="{Binding DataContext.Nav.NavigateToCrumbCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Path}"/>
                                                <TextBlock Text="&#x203A;" Foreground="#888" FontSize="13"
                                                           Margin="1,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Edit face. Borderless: the outer Border draws the frame. -->
                        <TextBox x:Name="AddressBox"
                                 BorderThickness="0" Padding="5,3"
                                 VerticalContentAlignment="Center"
                                 Visibility="{Binding Nav.IsEditingAddress, Converter={StaticResource BoolToVisibility}}"
                                 Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="AddressBox_PreviewKeyDown"
                                 LostKeyboardFocus="AddressBox_LostKeyboardFocus"/>

                        <Popup PlacementTarget="{Binding ElementName=AddressBar}" Placement="Bottom"
                               Width="{Binding ActualWidth, ElementName=AddressBar}"
                               IsOpen="{Binding IsChecked, ElementName=RecentToggle, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="White" BorderBrush="#ABADB3" BorderThickness="1">
                                <ListBox x:Name="RecentList" MaxHeight="320" BorderThickness="0"
                                         ItemsSource="{Binding Nav.RecentPaths}"
                                         SelectionChanged="RecentList_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Padding="2,1"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right"
                           Visibility="{Binding HasActiveOperations, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Width="140" Height="14"
                             Minimum="0" Maximum="100"
                             Value="{Binding AggregateProgress, Mode=OneWay}">
                    <ProgressBar.ToolTip>
                        <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <ItemsControl ItemsSource="{Binding Operations}" MinWidth="260">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                            <ProgressBar Width="240" Height="6"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding Percent, Mode=OneWay}"
                                                         Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ToolTip>
                    </ProgressBar.ToolTip>
                </ProgressBar>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!--
                Left pane = vertical stack:
                  • bookmarks panel (collapsible header + tree of favourites + special folders)
                  • drives tree (the original, unchanged behaviour)
                Drops onto an empty area of the bookmarks panel add the dragged
                folder(s) as bookmarks; drops onto a specific bookmark folder
                inside the bookmarks tree go through the normal OnDragOver/OnDrop
                pipeline (copy/move into that folder).
            -->
            <Grid Grid.Column="0" Background="#F8F8F8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           x:Name="BookmarksPanel"
                           AllowDrop="True"
                           DragOver="BookmarksPanel_DragOver"
                           Drop="BookmarksPanel_Drop">
                    <!-- Collapsible header: whole row is clickable to toggle. -->
                    <Button DockPanel.Dock="Top"
                            Command="{Binding ToggleBookmarksCommand}"
                            HorizontalContentAlignment="Stretch"
                            Padding="6,4"
                            Background="#EEE"
                            BorderBrush="#DDD"
                            BorderThickness="0,0,0,1"
                            Cursor="Hand"
                            ToolTip="{x:Static res:Strings.BookmarksToggleHint}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Margin="0,0,6,0"
                                       FontSize="10"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25BC;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBookmarksExpanded}" Value="False">
                                                <Setter Property="Text" Value="&#x25B6;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{x:Static res:Strings.BookmarksHeader}" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Button>

                    <!--
                        Explicit drop zone — discoverable affordance for
                        adding folders to bookmarks by drag&drop. Idle: thin
                        bottom border + muted hint. Drag-over: filled with
                        blue tint and bold "+ Add to bookmarks" prompt
                        (toggled via SetBookmarkDropZoneActive in code-behind).
                        Dropping anywhere else in the panel still adds a
                        bookmark too — this zone is the visible cue, not the
                        only acceptor.
                    -->
                    <Border x:Name="BookmarkDropZone"
                            DockPanel.Dock="Top"
                            Height="26"
                            Background="Transparent"
                            BorderBrush="#DDD"
                            BorderThickness="0,0,0,1"
                            AllowDrop="True"
                            DragEnter="BookmarkDropZone_DragEnter"
                            DragOver="BookmarkDropZone_DragOver"
                            DragLeave="BookmarkDropZone_DragLeave"
                            Drop="BookmarkDropZone_Drop"
                            Visibility="{Binding IsBookmarksExpanded, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Name="BookmarkDropZoneText"
                                   Text="+  Перетащите папку сюда"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#888"/>
                    </Border>

                    <!--
                        AllowDrop=True so cursor feedback shows correctly,
                        but DragOver/Drop are intentionally NOT attached here:
                        the parent BookmarksPanel handles all drop events so
                        that drops anywhere in this region (header, empty
                        area, between items) add the dragged folder(s) as
                        bookmarks rather than copying into the current folder.
                    -->
                    <TreeView x:Name="BookmarksTree"
                              DockPanel.Dock="Top"
                              ItemsSource="{Binding Bookmarks}"
                              SelectedItemChanged="Bookmarks_SelectedItemChanged"
                              PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                              TreeViewItem.Expanded="TreeViewItem_Expanded"
                              TreeViewItem.Collapsed="TreeViewItem_Collapsed"
                              AllowDrop="True"
                              Visibility="{Binding IsBookmarksExpanded, Converter={StaticResource BoolToVisibility}}"
                              MaxHeight="280"
                              BorderThickness="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource WanderTreeViewItem}"/>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{x:Static res:Strings.BookmarksRemove}"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.IsRemovableBookmark, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Command="{Binding DataContext.RemoveBookmarkCommand, ElementName=WanderWindow}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <Image Source="{Binding FullPath, Converter={StaticResource IconConverter}, ConverterParameter=Small}"
                                           Width="16" Height="16" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>

                <TreeView x:Name="Tree" Grid.Row="1"
                          Margin="0,12,0,0"
                          ItemsSource="{Binding Roots}"
                          SelectedItemChanged="Tree_SelectedItemChanged"
                          PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                          TreeViewItem.Expanded="TreeViewItem_Expanded"
                          TreeViewItem.Collapsed="TreeViewItem_Collapsed"
                          AllowDrop="True"
                          DragOver="OnDragOver"
                          Drop="OnDrop">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource WanderTreeViewItem}"/>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding FullPath, Converter={StaticResource IconConverter}, ConverterParameter=Small}"
                                       Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDD"/>

            <Grid Grid.Column="2"
                  AllowDrop="True"
                  DragOver="OnDragOver"
                  Drop="OnDrop"
                  Background="Transparent">
                <!-- Details -->
                <DataGrid x:Name="Grid"
                          Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Details}"
                          ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          ClipboardCopyMode="None"
                          MouseDoubleClick="Grid_MouseDoubleClick"
                          SelectionChanged="List_SelectionChanged"
                          PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                          PreviewMouseMove="List_PreviewMouseMove"
                          PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                          PreviewMouseRightButtonUp="List_PreviewMouseRightButtonUp"
                          PreviewKeyDown="List_PreviewKeyDown"
                          AllowDrop="True"
                          DragOver="OnDragOver"
                          Drop="OnDrop"
                          GridLinesVisibility="None" AlternatingRowBackground="#F7F7F7"
                          HeadersVisibility="Column" RowHeight="24">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="28" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:AsyncIcon IconPath="{Binding FullPath}" IconSize="Normal"
                                                        Width="20" Height="20"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--
                            Name + the "has companions" marker. A template
                            column rather than a text one only because of
                            that marker; SortMemberPath keeps the header
                            behaving exactly as before.
                        -->
                        <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnName}" Width="*" SortMemberPath="Name" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource RenameVisibility}" ConverterParameter="Inverse">
                                                    <Binding Path="FullPath"/>
                                                    <Binding Path="DataContext.RenamingPath" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                        <TextBox Style="{StaticResource RenameEditor}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnType}" Binding="{Binding Kind}" Width="80"/>
                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnSize}" Binding="{Binding Size}" Width="100"/>
                        <DataGridTextColumn Header="{x:Static res:Strings.ColumnModified}" Binding="{Binding ModifiedUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Tiles -->
                <ListBox x:Name="TilesView"
                         Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Tiles}"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="Tiles_MouseDoubleClick"
                         SelectionChanged="List_SelectionChanged"
                         PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                         PreviewMouseMove="List_PreviewMouseMove"
                         PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                         PreviewMouseRightButtonUp="List_PreviewMouseRightButtonUp"
                         PreviewKeyDown="List_PreviewKeyDown"
                         AllowDrop="True"
                         DragOver="OnDragOver"
                         Drop="OnDrop"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="220" Margin="4" Padding="6" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <controls:AsyncIcon IconPath="{Binding FullPath}" IconSize="Normal"
                                                        Width="32" Height="32" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="160">
                                                <TextBlock.Visibility>
                                                    <MultiBinding Converter="{StaticResource RenameVisibility}" ConverterParameter="Inverse">
                                                        <Binding Path="FullPath"/>
                                                        <Binding Path="DataContext.RenamingPath" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                            <TextBox Style="{StaticResource RenameEditor}" MaxWidth="180"/>
                                        </Grid>
                                        <TextBlock FontSize="11" Foreground="#777">
                                            <Run Text="{Binding Kind, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Large icons -->
                <ListBox x:Name="IconsView"
                         Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=LargeIcons}"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="Tiles_MouseDoubleClick"
                         SelectionChanged="List_SelectionChanged"
                         PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                         PreviewMouseMove="List_PreviewMouseMove"
                         PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                         PreviewMouseRightButtonUp="List_PreviewMouseRightButtonUp"
                         PreviewKeyDown="List_PreviewKeyDown"
                         AllowDrop="True"
                         DragOver="OnDragOver"
                         Drop="OnDrop"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!--
                                Live-bound to Settings.LargeIcon* so the Settings dialog
                                can resize tiles on the fly. The ItemTemplate's own
                                DataContext is the FileSystemEntry, so each binding
                                hops back up to the Window's DataContext (MainViewModel)
                                via RelativeSource.
                            -->
                            <StackPanel HorizontalAlignment="Center"
                                        Width="{Binding DataContext.Settings.LargeIconCellWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="{Binding DataContext.Settings.LargeIconMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                                <controls:AsyncIcon IconPath="{Binding FullPath}" IconSize="Large"
                                                    Width="{Binding DataContext.Settings.LargeIconImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Height="{Binding DataContext.Settings.LargeIconImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Margin="0,2,0,2"
                                                    HorizontalAlignment="Center"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    UseLayoutRounding="True"/>
                                <Grid>
                                    <TextBlock Text="{Binding Name}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxHeight="32"
                                               FontSize="{Binding DataContext.Settings.LargeIconLabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource RenameVisibility}" ConverterParameter="Inverse">
                                                <Binding Path="FullPath"/>
                                                <Binding Path="DataContext.RenamingPath" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                    <TextBox Style="{StaticResource RenameEditor}"
                                             FontSize="{Binding DataContext.Settings.LargeIconLabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--
                    Loading overlay for slow list enumerations (shell
                    namespaces like Recycle Bin go through Shell.Application
                    COM, which can take a noticeable fraction of a second).
                    Z-ordered last so it sits on top of the three view
                    containers; non-hit-testable so the user's clicks fall
                    through to the empty list rather than the spinner.
                -->
                <Grid Visibility="{Binding IsListLoading, Converter={StaticResource BoolToVisibility}}"
                      Background="#80FAFAFA"
                      IsHitTestVisible="False">
                    <Ellipse Width="32" Height="32" StrokeThickness="3"
                             Stroke="#0078D7" Fill="Transparent"
                             StrokeDashArray="3,2"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="ListSpinnerRotate" Angle="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="ListSpinnerRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
            </Grid>

            <!-- Splitter between right pane and preview -->
            <GridSplitter x:Name="PreviewSplitter"
                          Grid.Column="3"
                          HorizontalAlignment="Stretch"
                          Background="#DDD"
                          DragCompleted="PreviewSplitter_DragCompleted"/>

            <!-- Preview pane -->
            <Border Grid.Column="4"
                    BorderBrush="#DDD" BorderThickness="1,0,0,0"
                    Background="#FAFAFA"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Content area -->
                    <Grid Grid.Row="0">
                        <!--
                            Image preview. The fitted image stays in ImgFit; a
                            transparent canvas overlays it for the FastStone-style
                            "hold RMB to zoom 1:1" interaction. Everything is wired
                            in code-behind (ImageZoom_* handlers).
                        -->
                        <Grid x:Name="ImagePreviewHost"
                              Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Image}"
                              ClipToBounds="True"
                              Background="Transparent"
                              MouseEnter="ImageZoom_MouseEnter"
                              MouseLeave="ImageZoom_MouseLeave"
                              MouseMove="ImageZoom_MouseMove"
                              MouseLeftButtonDown="ImageZoom_LmbDown"
                              MouseLeftButtonUp="ImageZoom_LmbUp"
                              LostMouseCapture="ImageZoom_LostCapture">
                            <Image x:Name="ImgFit"
                                   Source="{Binding Preview.Image}"
                                   Stretch="Uniform" StretchDirection="DownOnly"
                                   MaxWidth="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource BitmapPixelSize}, ConverterParameter=W}"
                                   MaxHeight="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource BitmapPixelSize}, ConverterParameter=H}"
                                   Margin="8,12,8,8"
                                   VerticalAlignment="Top" HorizontalAlignment="Center"
                                   SizeChanged="ImgFit_SizeChanged"/>
                            <!-- Zoom view: visible only while the user holds RMB. -->
                            <Canvas x:Name="ImgZoomCanvas"
                                    Background="White"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Image x:Name="ImgZoom"
                                       Source="{Binding Source, ElementName=ImgFit}"/>
                            </Canvas>
                        </Grid>

                        <!-- Animated GIF (also anchored middle-top with same margin). -->
                        <controls:GifImage x:Name="GifPreview"
                                           GifUri="{Binding Preview.GifUri}"
                                           Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Gif}"
                                           Stretch="Uniform" StretchDirection="DownOnly"
                                           MaxWidth="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource BitmapPixelSize}, ConverterParameter=W}"
                                           MaxHeight="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource BitmapPixelSize}, ConverterParameter=H}"
                                           Margin="8,12,8,8"
                                           VerticalAlignment="Top" HorizontalAlignment="Center"/>

                        <!-- Video: MediaElement + simple transport (Play/Pause + seek slider). -->
                        <Grid Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Video}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <MediaElement x:Name="VideoPreview"
                                          Grid.Row="0"
                                          Source="{Binding Preview.VideoUri}"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          ScrubbingEnabled="True"
                                          Stretch="Uniform" StretchDirection="DownOnly"
                                          Margin="8,12,8,4"
                                          VerticalAlignment="Top" HorizontalAlignment="Center"
                                          MediaOpened="VideoPreview_MediaOpened"
                                          MediaEnded="VideoPreview_MediaEnded"
                                          MediaFailed="VideoPreview_MediaFailed"/>
                            <Grid Grid.Row="1" Margin="8,4,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="VideoPlayPauseButton"
                                        Content="▶" Width="32" Padding="0,2"
                                        Grid.Column="0"
                                        Click="VideoPlayPause_Click"
                                        ToolTip="{x:Static res:Strings.PreviewPlayPause}"/>
                                <TextBlock x:Name="VideoTimeText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Margin="8,0"
                                           FontFamily="Consolas" FontSize="11"
                                           Text="0:00 / 0:00"/>
                                <Slider x:Name="VideoSlider"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Minimum="0" Maximum="1"
                                        SmallChange="0.5" LargeChange="5"
                                        IsMoveToPointEnabled="True"
                                        PreviewMouseLeftButtonDown="VideoSlider_PreviewMouseDown"
                                        PreviewMouseLeftButtonUp="VideoSlider_PreviewMouseUp"
                                        ValueChanged="VideoSlider_ValueChanged"/>
                            </Grid>
                        </Grid>

                        <!-- Plain text -->
                        <TextBox Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Text}"
                                 Text="{Binding Preview.Text, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11"
                                 Background="Transparent" BorderThickness="0"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Padding="6"/>

                        <!-- Code with syntax highlighting -->
                        <ae:TextEditor x:Name="CodeEditor"
                                       Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Code}"
                                       IsReadOnly="True"
                                       ShowLineNumbers="True"
                                       FontFamily="Consolas" FontSize="11"
                                       Background="Transparent"
                                       Padding="4"/>

                        <!-- PDF / HTML / Markdown via WebView2 -->
                        <wv2:WebView2 x:Name="WebPreview"
                                      Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Web}"
                                      DefaultBackgroundColor="White"/>

                        <!--
                            Folder census (B2). Shown when the selection is a
                            folder, or when nothing is selected: "what is in
                            here and what is eating the space" is the question
                            a folder raises, and a wall of thumbnails does not
                            answer it.
                        -->
                        <ScrollViewer Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Folder}"
                                      VerticalScrollBarVisibility="Auto" Padding="12,10,12,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Preview.FolderTitle}"
                                           FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Preview.FolderHeadline}"
                                           Foreground="#666" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Preview.FolderNote}"
                                           Foreground="#A05000" FontSize="11"
                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding Preview.HasFolderNote, Converter={StaticResource BoolToVisibility}}"/>

                                <TextBlock Text="{x:Static res:Strings.PreviewFolderTypes}"
                                           FontWeight="SemiBold" Margin="0,16,0,6"/>

                                <!-- Empty folder: say so instead of leaving a blank panel. -->
                                <TextBlock Text="{x:Static res:Strings.PreviewFolderEmpty}" Foreground="#888">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Preview.FolderTypes.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding Preview.FolderTypes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Bars are scaled against the biggest bucket,
                                                 not the total: with a long tail every bar
                                                 would otherwise be a hairline. -->
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Extension}"
                                                           FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Height="10" CornerRadius="2"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Width="{Binding BarWidth}"
                                                        Background="#0078D7" Opacity="0.5"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SizeText}" Foreground="#444"/>
                                                    <TextBlock Text="{Binding CountText}" Foreground="#999" Margin="10,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Placeholder (None / Unsupported) -->
                        <TextBlock Text="{Binding Preview.PlaceholderText}"
                                   Foreground="#888"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Preview.IsPlaceholderVisible, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Loading spinner — overlays content while content loads -->
                        <Grid Visibility="{Binding Preview.IsLoading, Converter={StaticResource BoolToVisibility}}"
                              Background="#80FAFAFA"
                              IsHitTestVisible="False">
                            <Ellipse Width="32" Height="32" StrokeThickness="3"
                                     Stroke="#0078D7" Fill="Transparent"
                                     StrokeDashArray="3,2"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>
                    </Grid>

                    <!-- Summary footer -->
                    <Border Grid.Row="1"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0"
                            Padding="8,6" Background="#F3F3F3">
                        <StackPanel>
                            <TextBlock Text="{Binding Preview.Summary}"
                                       FontSize="11" Foreground="#444"
                                       TextWrapping="Wrap"/>

                            <!--
                                Companion block: what the sidecars next to
                                this file have to say. Only the two formats
                                Wander understands so far get a rendering of
                                their own; the file list above them is shown
                                for any companion at all.
                            -->
                            <StackPanel Margin="0,6,0,0"
                                        Visibility="{Binding Preview.HasCompanions, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap">
                                    <Run Text="{x:Static res:Strings.PreviewIntegrated}"/><Run Text=" "/><Run Text="{Binding Preview.CompanionFiles, Mode=OneWay}"/>
                                </TextBlock>

                                <!-- Unity .meta — the GUID, and a button to take it away -->
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                            Visibility="{Binding Preview.HasUnityGuid, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="GUID" FontSize="11" Foreground="#444" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Preview.UnityGuid, Mode=OneWay}"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                             FontFamily="Consolas" FontSize="11"
                                             BorderThickness="0" Background="Transparent"
                                             Margin="6,0,0,0" MinWidth="0" Padding="0"
                                             VerticalAlignment="Center"/>
                                    <Button Content="{x:Static res:Strings.ActionCopy}" Command="{Binding Preview.CopyGuidCommand}"
                                            ToolTip="{x:Static res:Strings.PreviewCopyGuid}"
                                            Margin="4,0,0,0" Padding="4,0" FontSize="11"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Preview.UnityDetail}"
                                           FontSize="11" Foreground="#888" TextWrapping="Wrap"/>

                                <!-- .pp3 / .xmp — rating and colour label, editable in place -->
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                            Visibility="{Binding Preview.HasRating, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{x:Static res:Strings.PreviewRating}" FontSize="11" Foreground="#444"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource RatingStar}" CommandParameter="1"
                                            Content="{Binding Preview.Rank, Converter={StaticResource RankStar}, ConverterParameter=1}"/>
                                    <Button Style="{StaticResource RatingStar}" CommandParameter="2"
                                            Content="{Binding Preview.Rank, Converter={StaticResource RankStar}, ConverterParameter=2}"/>
                                    <Button Style="{StaticResource RatingStar}" CommandParameter="3"
                                            Content="{Binding Preview.Rank, Converter={StaticResource RankStar}, ConverterParameter=3}"/>
                                    <Button Style="{StaticResource RatingStar}" CommandParameter="4"
                                            Content="{Binding Preview.Rank, Converter={StaticResource RankStar}, ConverterParameter=4}"/>
                                    <Button Style="{StaticResource RatingStar}" CommandParameter="5"
                                            Content="{Binding Preview.Rank, Converter={StaticResource RankStar}, ConverterParameter=5}"/>

                                    <ItemsControl ItemsSource="{Binding Preview.ColorLabelChoices}"
                                                  Margin="10,0,0,0" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ColorLabelSwatch}"
                                                        CommandParameter="{Binding Index}"
                                                        ToolTip="{Binding Name}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding Preview.CustomColorLabel}"
                                               FontSize="11" Foreground="#888"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Preview.CompanionStatus}"
                                           FontSize="11" Foreground="#888" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
