<Window x:Class="Wander.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Wander.App.ViewModels"
        xmlns:conv="clr-namespace:Wander.App.Converters"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:controls="clr-namespace:Wander.App.Controls"
        Title="{Binding WindowTitle}"
        Icon="Assets\app.ico"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <conv:IconConverter x:Key="IconConverter"/>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!--
            Suppress the dashed focus rectangle on selectable row containers.
            Default WPF draws it on top of the selection background, producing
            "double selection" visuals. Selection state remains driven by the
            normal background brushes; focus is still tracked semantically
            (keyboard navigation works).
        -->
        <Style TargetType="DataGridRow">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C8C8C8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
        <KeyBinding Modifiers="Shift" Key="Delete" Command="{Binding PermanentDeleteCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="Back" Command="{Binding UpCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding BackCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Right" Command="{Binding ForwardCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Up" Command="{Binding UpCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopyCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="X" Command="{Binding CutCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="V" Command="{Binding PasteCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="N" Command="{Binding NewFolderCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Enter" Command="{Binding PropertiesCommand}"/>
    </Window.InputBindings>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="#F3F3F3">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="4,4,8,4">
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding BackCommand}" ToolTip="Back (Alt+Left)"
                        Width="28" Height="28" Margin="2,0" Content="&#x2190;"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ForwardCommand}" ToolTip="Forward (Alt+Right)"
                        Width="28" Height="28" Margin="2,0" Content="&#x2192;"/>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding UpCommand}" ToolTip="Up (Alt+Up / Backspace)"
                        Width="28" Height="28" Margin="2,0" Content="&#x2191;"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,4,4,4">
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Padding="8,4">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="View"/>
                                <TextBlock Text="&#x25BE;" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Header="Details"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Details}"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="Details"/>
                        <MenuItem Header="Tiles"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Tiles}"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="Tiles"/>
                        <MenuItem Header="Large icons"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=LargeIcons}"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="LargeIcons"/>
                    </MenuItem>
                </Menu>

                <Border Width="12"/>

                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Padding="8,4" FontSize="16">
                        <MenuItem.Header>
                            <TextBlock Text="&#x22EF;" FontSize="16" Margin="0,-4,0,0"/>
                        </MenuItem.Header>
                        <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" InputGestureText="F5"/>
                        <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" InputGestureText="Ctrl+Shift+N"/>
                        <Separator/>
                        <MenuItem Header="Quick preview"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsPreviewVisible, Mode=TwoWay}"/>
                        <Separator/>
                        <MenuItem Header="Options..." Command="{Binding OptionsCommand}"/>
                        <Separator/>
                        <MenuItem Header="Debug"
                                  Visibility="{Binding Settings.ShowDebugMenu, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem Header="Logs"
                                      Command="{Binding OpenLogFileCommand}"
                                      ToolTip="Open the current session log file"/>
                        </MenuItem>
                        <Separator Visibility="{Binding Settings.ShowDebugMenu, Converter={StaticResource BoolToVisibility}}"/>
                        <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
                    </MenuItem>
                </Menu>
            </StackPanel>

            <TextBox x:Name="AddressBox"
                     VerticalAlignment="Center" Margin="0,4,4,4" Padding="6,4"
                     Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding NavigateCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right"
                           Visibility="{Binding HasActiveOperations, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Width="140" Height="14"
                             Minimum="0" Maximum="100"
                             Value="{Binding AggregateProgress, Mode=OneWay}">
                    <ProgressBar.ToolTip>
                        <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <ItemsControl ItemsSource="{Binding Operations}" MinWidth="260">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                            <ProgressBar Width="240" Height="6"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding Percent, Mode=OneWay}"
                                                         Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ToolTip>
                    </ProgressBar.ToolTip>
                </ProgressBar>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="Tree" Grid.Column="0"
                      ItemsSource="{Binding Roots}"
                      SelectedItemChanged="Tree_SelectedItemChanged"
                      PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                      TreeViewItem.Expanded="TreeViewItem_Expanded"
                      TreeViewItem.Collapsed="TreeViewItem_Collapsed"
                      AllowDrop="True"
                      DragOver="OnDragOver"
                      Drop="OnDrop">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding FullPath, Converter={StaticResource IconConverter}, ConverterParameter=Small}"
                                   Width="16" Height="16" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDD"/>

            <Grid Grid.Column="2"
                  AllowDrop="True"
                  DragOver="OnDragOver"
                  Drop="OnDrop"
                  Background="Transparent">
                <!-- Details -->
                <DataGrid x:Name="Grid"
                          Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Details}"
                          ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          ClipboardCopyMode="None"
                          MouseDoubleClick="Grid_MouseDoubleClick"
                          SelectionChanged="List_SelectionChanged"
                          PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                          PreviewMouseMove="List_PreviewMouseMove"
                          AllowDrop="True"
                          DragOver="OnDragOver"
                          Drop="OnDrop"
                          GridLinesVisibility="None" AlternatingRowBackground="#F7F7F7"
                          HeadersVisibility="Column" RowHeight="24">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="28" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding FullPath, Converter={StaticResource IconConverter}, ConverterParameter=Normal}"
                                           Width="20" Height="20"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100"/>
                        <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Command="{Binding OpenCommand}"/>
                            <Separator/>
                            <MenuItem Header="Cut" Command="{Binding CutCommand}" InputGestureText="Ctrl+X"/>
                            <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C"/>
                            <MenuItem Header="Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V"/>
                            <Separator/>
                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGestureText="Del"/>
                            <MenuItem Header="Rename" Click="Rename_Click" InputGestureText="F2"/>
                            <Separator/>
                            <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" InputGestureText="Ctrl+Shift+N"/>
                            <Separator/>
                            <MenuItem Header="Properties" Command="{Binding PropertiesCommand}" InputGestureText="Alt+Enter"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- Tiles -->
                <ListBox x:Name="TilesView"
                         Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Tiles}"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="Tiles_MouseDoubleClick"
                         SelectionChanged="List_SelectionChanged"
                         PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                         PreviewMouseMove="List_PreviewMouseMove"
                         AllowDrop="True"
                         DragOver="OnDragOver"
                         Drop="OnDrop"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="220" Margin="4" Padding="6" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding FullPath, Converter={StaticResource IconConverter}, ConverterParameter=Normal}"
                                           Width="32" Height="32" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                        <TextBlock FontSize="11" Foreground="#777">
                                            <Run Text="{Binding Kind, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Command="{Binding OpenCommand}"/>
                            <Separator/>
                            <MenuItem Header="Cut" Command="{Binding CutCommand}" InputGestureText="Ctrl+X"/>
                            <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C"/>
                            <MenuItem Header="Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V"/>
                            <Separator/>
                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGestureText="Del"/>
                            <MenuItem Header="Rename" Click="Rename_Click" InputGestureText="F2"/>
                            <Separator/>
                            <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" InputGestureText="Ctrl+Shift+N"/>
                            <Separator/>
                            <MenuItem Header="Properties" Command="{Binding PropertiesCommand}" InputGestureText="Alt+Enter"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <!-- Large icons -->
                <ListBox x:Name="IconsView"
                         Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=LargeIcons}"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="Tiles_MouseDoubleClick"
                         SelectionChanged="List_SelectionChanged"
                         PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                         PreviewMouseMove="List_PreviewMouseMove"
                         AllowDrop="True"
                         DragOver="OnDragOver"
                         Drop="OnDrop"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!--
                                Live-bound to Settings.LargeIcon* so the Settings dialog
                                can resize tiles on the fly. The ItemTemplate's own
                                DataContext is the FileSystemEntry, so each binding
                                hops back up to the Window's DataContext (MainViewModel)
                                via RelativeSource.
                            -->
                            <StackPanel HorizontalAlignment="Center"
                                        Width="{Binding DataContext.Settings.LargeIconCellWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="{Binding DataContext.Settings.LargeIconMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Image Source="{Binding FullPath, Converter={StaticResource IconConverter}, ConverterParameter=Large}"
                                       Width="{Binding DataContext.Settings.LargeIconImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Height="{Binding DataContext.Settings.LargeIconImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Margin="0,2,0,2"
                                       HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       UseLayoutRounding="True"/>
                                <TextBlock Text="{Binding Name}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxHeight="32"
                                           FontSize="{Binding DataContext.Settings.LargeIconLabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Command="{Binding OpenCommand}"/>
                            <Separator/>
                            <MenuItem Header="Cut" Command="{Binding CutCommand}" InputGestureText="Ctrl+X"/>
                            <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C"/>
                            <MenuItem Header="Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V"/>
                            <Separator/>
                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGestureText="Del"/>
                            <MenuItem Header="Rename" Click="Rename_Click" InputGestureText="F2"/>
                            <Separator/>
                            <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" InputGestureText="Ctrl+Shift+N"/>
                            <Separator/>
                            <MenuItem Header="Properties" Command="{Binding PropertiesCommand}" InputGestureText="Alt+Enter"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>

            <!-- Splitter between right pane and preview -->
            <GridSplitter x:Name="PreviewSplitter"
                          Grid.Column="3"
                          HorizontalAlignment="Stretch"
                          Background="#DDD"
                          DragCompleted="PreviewSplitter_DragCompleted"/>

            <!-- Preview pane -->
            <Border Grid.Column="4"
                    BorderBrush="#DDD" BorderThickness="1,0,0,0"
                    Background="#FAFAFA"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Content area -->
                    <Grid Grid.Row="0">
                        <!--
                            Image preview. The fitted image stays in ImgFit; a
                            transparent canvas overlays it for the FastStone-style
                            "hold RMB to zoom 1:1" interaction. Everything is wired
                            in code-behind (ImageZoom_* handlers).
                        -->
                        <Grid x:Name="ImagePreviewHost"
                              Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Image}"
                              ClipToBounds="True"
                              Background="Transparent"
                              MouseEnter="ImageZoom_MouseEnter"
                              MouseLeave="ImageZoom_MouseLeave"
                              MouseMove="ImageZoom_MouseMove"
                              MouseRightButtonDown="ImageZoom_RmbDown"
                              MouseRightButtonUp="ImageZoom_RmbUp"
                              LostMouseCapture="ImageZoom_LostCapture">
                            <Image x:Name="ImgFit"
                                   Source="{Binding Preview.Image}"
                                   Stretch="Uniform" StretchDirection="DownOnly"
                                   Margin="8,12,8,8"
                                   VerticalAlignment="Top" HorizontalAlignment="Center"
                                   SizeChanged="ImgFit_SizeChanged"/>
                            <!-- Zoom view: visible only while the user holds RMB. -->
                            <Canvas x:Name="ImgZoomCanvas"
                                    Background="White"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <Image x:Name="ImgZoom"
                                       Source="{Binding Source, ElementName=ImgFit}"/>
                            </Canvas>
                        </Grid>

                        <!-- Animated GIF (also anchored middle-top with same margin). -->
                        <controls:GifImage GifUri="{Binding Preview.GifUri}"
                                           Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Gif}"
                                           Stretch="Uniform" StretchDirection="DownOnly"
                                           Margin="8,12,8,8"
                                           VerticalAlignment="Top" HorizontalAlignment="Center"/>

                        <!-- Video: MediaElement + simple transport (Play/Pause + seek slider). -->
                        <Grid Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Video}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <MediaElement x:Name="VideoPreview"
                                          Grid.Row="0"
                                          Source="{Binding Preview.VideoUri}"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          ScrubbingEnabled="True"
                                          Stretch="Uniform" StretchDirection="DownOnly"
                                          Margin="8,12,8,4"
                                          VerticalAlignment="Top" HorizontalAlignment="Center"
                                          MediaOpened="VideoPreview_MediaOpened"
                                          MediaEnded="VideoPreview_MediaEnded"
                                          MediaFailed="VideoPreview_MediaFailed"/>
                            <Grid Grid.Row="1" Margin="8,4,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="VideoPlayPauseButton"
                                        Content="▶" Width="32" Padding="0,2"
                                        Grid.Column="0"
                                        Click="VideoPlayPause_Click"
                                        ToolTip="Space"/>
                                <TextBlock x:Name="VideoTimeText"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Margin="8,0"
                                           FontFamily="Consolas" FontSize="11"
                                           Text="0:00 / 0:00"/>
                                <Slider x:Name="VideoSlider"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Minimum="0" Maximum="1"
                                        SmallChange="0.5" LargeChange="5"
                                        IsMoveToPointEnabled="True"
                                        PreviewMouseLeftButtonDown="VideoSlider_PreviewMouseDown"
                                        PreviewMouseLeftButtonUp="VideoSlider_PreviewMouseUp"
                                        ValueChanged="VideoSlider_ValueChanged"/>
                            </Grid>
                        </Grid>

                        <!-- Plain text -->
                        <TextBox Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Text}"
                                 Text="{Binding Preview.Text, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11"
                                 Background="Transparent" BorderThickness="0"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Padding="6"/>

                        <!-- Code with syntax highlighting -->
                        <ae:TextEditor x:Name="CodeEditor"
                                       Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Code}"
                                       IsReadOnly="True"
                                       ShowLineNumbers="True"
                                       FontFamily="Consolas" FontSize="11"
                                       Background="Transparent"
                                       Padding="4"/>

                        <!-- PDF / HTML / Markdown via WebView2 -->
                        <wv2:WebView2 x:Name="WebPreview"
                                      Visibility="{Binding Preview.Kind, Converter={StaticResource EnumToVisibility}, ConverterParameter=Web}"
                                      DefaultBackgroundColor="White"/>

                        <!-- Placeholder (None / Unsupported) -->
                        <TextBlock Text="{Binding Preview.PlaceholderText}"
                                   Foreground="#888"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Preview.IsPlaceholderVisible, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Loading spinner — overlays content while content loads -->
                        <Grid Visibility="{Binding Preview.IsLoading, Converter={StaticResource BoolToVisibility}}"
                              Background="#80FAFAFA"
                              IsHitTestVisible="False">
                            <Ellipse Width="32" Height="32" StrokeThickness="3"
                                     Stroke="#0078D7" Fill="Transparent"
                                     StrokeDashArray="3,2"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>
                    </Grid>

                    <!-- Summary footer -->
                    <Border Grid.Row="1"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0"
                            Padding="8,6" Background="#F3F3F3">
                        <TextBlock Text="{Binding Preview.Summary}"
                                   FontSize="11" Foreground="#444"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
