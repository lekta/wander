<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Wander.Core\Wander.Core.csproj" />
    <ProjectReference Include="..\Wander.Platform.Windows\Wander.Platform.Windows.csproj" />
  </ItemGroup>

  <!-- The headless harness drives the real window in-process and needs the
       same internals the window has (App.Headless, view internals). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Wander.Harness" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Wander</AssemblyName>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Windows 11 alternative file manager</Description>
    <!--
        XML-документация из пакетов не нужна ни в рантайме, ни в бандле:
        Microsoft.Web.WebView2.*.xml — 766 КБ, которые иначе едут внутрь
        одного портативного exe.
    -->
    <CopyDocumentationFilesFromPackages>false</CopyDocumentationFilesFromPackages>
    <!--
        Локализации рантайма: только русская. Тексты исключений .NET доходят
        до пользователя (статусная строка, диалоги ошибок, CrashReporter),
        поэтому ru остаётся; остальные 12 языков — 5.3 МБ в сжатом exe,
        которые никто в этой сборке не увидит.
    -->
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!--
    Дата сборки — для строки версии в меню и для отчётов об ошибках.
    Стоит здесь, а не в Directory.Build.props: читает её только приложение,
    а свойство меняется раз в сутки и заставляло бы пересобираться и Core,
    и тесты. Гранулярность — день, поэтому инкрементальная сборка страдает
    ровно один раз за день.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Номер сборки — четвёртое число FileVersion (PLAN AH). Счётчик лежит в
    build-number.txt рядом с проектом и в гит не попадает: номер свой на
    каждой машине, а у релиза и у CI его нет вовсе — там четвёртое число 0.
    Крутится на любой обычной сборке (Debug из Rider, check.bat,
    publish.ps1 -Install) и сбрасывается только version.ps1, то есть сменой
    версии. Не крутится на релизной сборке (WanderRelease), на дизайн-
    сборках IDE, которые идут по нескольку раз в минуту, и во временном
    проекте компиляции XAML (_TargetAssemblyProjectName) — он лежит в этой
    же папке и без исключения давал бы +2 за сборку.

    Цена: атрибуты сборки меняются каждый раз, поэтому Wander.App
    перекомпилируется всегда, даже когда в коде не менялось ничего. Это
    секунды, и монотонность номера важнее.
  -->
  <Target Name="StampBuildNumber" BeforeTargets="GetAssemblyAttributes"
          Condition="'$(WanderRelease)' != 'true' and '$(DesignTimeBuild)' != 'true'
                     and '$(_TargetAssemblyProjectName)' == ''">
    <PropertyGroup>
      <BuildNumberFile>$(MSBuildProjectDirectory)\build-number.txt</BuildNumberFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(BuildNumberFile)" Condition="Exists('$(BuildNumberFile)')">
      <Output TaskParameter="Lines" ItemName="_PreviousBuildNumberLine"/>
    </ReadLinesFromFile>
    <PropertyGroup>
      <_PreviousBuildNumber>@(_PreviousBuildNumberLine)</_PreviousBuildNumber>
      <!-- Нет файла, пустой, испорченный руками — всё это ноль, а не падение сборки. -->
      <_PreviousBuildNumber
          Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_PreviousBuildNumber)', '^\d+$'))">0</_PreviousBuildNumber>
      <BuildNumber>$([MSBuild]::Add($(_PreviousBuildNumber), 1))</BuildNumber>
      <FileVersion>$(Version).$(BuildNumber)</FileVersion>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildNumberFile)" Lines="$(BuildNumber)" Overwrite="true" Encoding="ascii"/>
  </Target>

  <!--
    Определения подсветки для форматов, которых нет в поставке AvalonEdit
    (bat/cmd, Unity-шейдеры, YAML и сериализованные ассеты Unity).
    Читаются из сборки в Highlighting/HighlightingCatalog.cs.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Highlighting\*.xshd" />
  </ItemGroup>

  <!--
    Пользовательские строки живут в Resources/Strings.resx и попадают в
    сборку как встроенный ресурс; типизированный доступ к ним —
    Resources/Strings.cs. Второй язык — это Strings.<culture>.resx рядом,
    без единой правки в коде.
  -->

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

</Project>
