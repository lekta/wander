<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Wander.Core\Wander.Core.csproj" />
    <ProjectReference Include="..\Wander.Platform.Windows\Wander.Platform.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Wander</AssemblyName>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Windows 11 alternative file manager</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!--
    Определения подсветки для форматов, которых нет в поставке AvalonEdit
    (bat/cmd, Unity-шейдеры, YAML и сериализованные ассеты Unity).
    Читаются из сборки в Highlighting/HighlightingCatalog.cs.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Highlighting\*.xshd" />
  </ItemGroup>

  <!--
    Пользовательские строки живут в Resources/Strings.resx и попадают в
    сборку как встроенный ресурс; типизированный доступ к ним —
    Resources/Strings.cs. Второй язык — это Strings.<culture>.resx рядом,
    без единой правки в коде.
  -->

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

</Project>
