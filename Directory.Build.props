<Project>

  <PropertyGroup>
    <Authors>Lekta</Authors>
    <Company>Lekta</Company>
    <Product>Wander</Product>
    <Copyright>© Lekta 2026</Copyright>
    <!-- The language of the neutral resources (Strings.resx is Russian). Said
         wrong, the resource manager answers that culture from them and never
         opens its satellite: "en" here hid Strings.en.resx. -->
    <NeutralLanguage>ru</NeutralLanguage>
    <Version>0.5.1</Version>
    <InformationalVersion>0.5.1-beta</InformationalVersion>
    <FileVersion>0.5.1.0</FileVersion>
    <!-- AssemblyVersion намеренно зафиксирован: это binding-идентичность сборки,
         по релизам двигаем Version / FileVersion / InformationalVersion. -->
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
  </PropertyGroup>

</Project>
